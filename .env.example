# ============================================================
# ForHumo.uz — muhit o'zgaruvchilari namunasi
# `.env.local` fayliga ko'chir va o'z qiymatlaring bilan to'ldir.
# Yulduzchali (*) bo'lganlar MAJBURIY, boshqalari ixtiyoriy.
# ============================================================

# ─── App URL ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"          # * Vercel'da: https://forhumo.uz

# ─── Database (Neon / Postgres) ──────────────────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"   # *

# ─── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET=""                                    # * `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"                  # * prod'da NEXT_PUBLIC_APP_URL bilan bir xil

# ─── Google OAuth (yagona kirish provideri) ──────────────────
GOOGLE_CLIENT_ID=""                                   # *
GOOGLE_CLIENT_SECRET=""                               # *

# ─── Vercel Blob (avatar/cover/media upload) ─────────────────
BLOB_READ_WRITE_TOKEN=""                              # *

# ─── AI (Gemini) — mahsulot AI, moderatsiya, embedding ───────
GEMINI_API_KEY=""                                     # bo'lmasa AI 503 qaytaradi
GEMINI_MODEL="gemini-2.5-flash-lite"                  # ixtiyoriy — default shu
GEMINI_EMBED_MODEL="gemini-embedding-001"             # ixtiyoriy — pgvector 768d

# ─── Cloudflare Stream (eSport jonli efir) ───────────────────
CLOUDFLARE_ACCOUNT_ID=""                              # bo'lmasa efir "stub" (test) rejimda
CLOUDFLARE_STREAM_TOKEN=""                            # Stream:Edit ruxsatli API token
CLOUDFLARE_STREAM_CODE=""                             # customer-{CODE}.cloudflarestream.com

# ─── Steam identity link (eSport — CS2 uchun) ────────────────
STEAM_API_KEY=""                                      # ixtiyoriy — bo'lmasa persona/avatar null, link ishlaydi

# ─── Pusher (Nexus chaqiruv real-time signaling — 3s→500ms ulanish) ─
# https://dashboard.pusher.com — bepul: 200k msg/kun, 100 concurrent
PUSHER_APP_ID=""                                      # server
NEXT_PUBLIC_PUSHER_KEY=""                             # client + server (public)
PUSHER_SECRET=""                                      # server
NEXT_PUBLIC_PUSHER_CLUSTER=""                         # client + server (masalan: "eu", "ap3")

# ─── TURN server (Nexus qo'ng'iroq — qattiq NAT ortidagi ~15% foydalanuvchi uchun) ─
# Metered.ca bepul: 500MB/oy. https://www.metered.ca/tools/openrelay
# Yoki coturn self-host. Bir nechta URL vergul bilan.
TURN_URL=""                                           # masalan: "turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443"
TURN_USER=""
TURN_PASS=""

# ─── Manzil shifrlash (AES-256-GCM) ──────────────────────────
LOCATION_ENCRYPTION_KEY=""                            # ixtiyoriy — bo'lmasa NEXTAUTH_SECRET'dan derive

# ─── Valyuta kursi ───────────────────────────────────────────
USD_UZS_RATE="12900"                                  # ixtiyoriy — default 12900

# ─── To'lov shlyuzlari (hozircha test rejim) ─────────────────
CLICK_MERCHANT_ID=""                                  # UZS deposit — Click
PAYME_MERCHANT_ID=""                                  # UZS deposit — Payme
STRIPE_SECRET_KEY=""                                  # USD deposit/payout — Stripe

# ─── Web Push (bildirishnoma) ────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""                       # `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""                                   # yuqoridagi bilan bir xil
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@forhumo.uz"

# ─── Cron himoyasi ───────────────────────────────────────────
CRON_SECRET=""                                        # ixtiyoriy — /api/cron/* uchun Bearer

# ─── Partner SSO (Sevinch Sweets kabi IT-hamkorlar) ──────────
SEVINCH_PARTNER_KEY=""                                # HMAC — partner API imzosi
SEVINCH_PARTNER_KEY_OLD=""                            # ixtiyoriy — kalit aylantirish davrida
SSO_CLIENTS=""                                        # ixtiyoriy — JSON: [{"clientId","secret","redirectUri"}]
