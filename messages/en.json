    "FAQ": {
        "title": "Frequently Asked Questions",
        "subtitle": "The most common questions about For Humo",
        "q1": "How do I change my username?",
        "a1": "Go to Humo ID → Edit Profile. Change the username field and click Save. Note: username can only be changed once every 14 days.",
        "q2": "How does the level system work?",
        "a2": "Level 0 (Basic) — assigned automatically when signing up via Google. Level 1 (Verified) — assigned when email is confirmed. Google sign-in auto-verifies your email. Level 2 (KYC) — biometric verification, coming in the future.",
        "q3": "What is the Humo ID number?",
        "a3": "Humo ID is your unique identifier in the For Humo ecosystem. It is created once and never changes. All services use this number to identify you.",
        "q4": "What size should the cover photo be?",
        "a4": "Recommended size: 1500×500 pixels. Maximum file size: 8 MB. Supported formats: JPG, PNG, WebP, GIF.",
        "q5": "Is my data safe?",
        "a5": "Yes. Location data is encrypted with AES-256-GCM. No passwords are used — only Google OAuth. All connections are over HTTPS.",
        "q6": "How do I delete my account?",
        "a6": "Humo ID → Security section → Delete account. Enter your email to confirm. This action cannot be undone.",
        "q7": "How can I contact For Humo?",
        "a7": "Telegram: @ForHumo. You can also report an issue through our Support page.",
        "q8": "Why is there a 14-day restriction?",
        "a8": "Changing your username and core data is restricted to once every 14 days to maintain stable identification and prevent spam. Photos, cover image, and country are not restricted.",
        "back": "Back",
        "no_answer": "Didn't find an answer?",
        "support_hint": "Write to us — we'll help.",
        "support_btn": "Contact us"
    },
