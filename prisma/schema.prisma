  kind      String                                     // "offer" | "answer" | "ice"
  payload   String    @db.Text                         // JSON: SDP yoki ICE candidate
  createdAt DateTime  @default(now())
  @@index([callId, createdAt])
}

enum NexusCallKind {
  AUDIO
  VIDEO
}

enum NexusCallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

// ── Nexus Video — to'liq video (LONG) va Shorts (SHORT) ──────────────────────
model NexusVideo {
  id          String         @id @default(cuid())
  profileId   String                                // kanal / yuklovchi
  title       String
  description String?                               // cheksiz uzunlik
  videoUrl    String                                // Vercel Blob MP4 URL
  thumbUrl    String?                               // muqova (custom yoki client thumbnail)
  durationSec Int            @default(0)
  kind        NexusVideoKind @default(LONG)
  orientation NexusVideoOrientation @default(HORIZONTAL)  // G.Video (gorizontal) / V.Video (vertikal)
  width       Int?                                  // video o'lchami — orientation aniqlash
  height      Int?
  category    String?                               // kino / musiqa / gaming ...
  tags        String[]                              // foydalanuvchi #teglari (cheksiz)
  descImages  String[]                              // tavsifdagi dalil rasmlari
  isMature    Boolean        @default(false)        // 18+ — voyaga yetmaganlardan yashiriladi
  price       Int            @default(0) @map("priceZij")  // 0 = bepul, >0 = pullik (priceCurrency valyutasida)
  priceCurrency Currency     @default(UZS)
  prevVideoId String?                               // series — avvalgi qism (joylangan bo'lishi shart)
  prevVideo   NexusVideo?    @relation("VideoSeries", fields: [prevVideoId], references: [id], onDelete: SetNull)
  nextParts   NexusVideo[]   @relation("VideoSeries")
