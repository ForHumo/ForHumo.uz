generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Humo ID — unified identity across all For Humo services ──────────────────

enum AccountType {
  GOOGLE   // To'liq Humo ID — Google bilan (For Humo loyihalari)
  SWEET    // Sweet ID — hamkor (Sevinch Sweets), Telegram bilan; ma'lumotni Humo ID saqlaydi
}

enum AuthProvider {
  GOOGLE
  TELEGRAM
}

// Bitta Humo ID profili ↔ login usuli(lar)i. SWEET profil uchun bu TELEGRAM
// identity bo'ladi; bu Sevinch Sweets ↔ Humo ID "ko'prigi" (Sweet ID).
model Identity {
  id         String       @id @default(cuid())
  profileId  String
  profile    UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  providerId String        // Google "sub" yoki Telegram user id (string)
  username   String?
  photoUrl   String?
  createdAt  DateTime     @default(now())

  @@unique([provider, providerId])
  @@index([profileId])
}

model UserProfile {
  id            String      @id @default(cuid())
  email         String?     @unique   // SWEET (Telegram) profillarda bo'lmaydi
  googleId      String?     @unique
  accountType   AccountType @default(GOOGLE)
  origin        String?                 // SWEET uchun qaysi hamkor yaratgan (masalan "sevinch")

  // Name fields
  name          String?            // display name (editable)
  firstName     String?
  lastName      String?
  fatherName    String?            // Otasining ismi

  // Identity
  username      String?  @unique   // @handle — e.g. "forhumo_ali"
  humoId        String?  @unique   // e.g. "UZ4829341"
  country       String?  @default("UZ")  // ISO alpha-2

  // Profile
  image         String?            // custom avatar URL (null = use Google photo)
  coverImage    String?            // background/banner image URL
  bio           String?            // max 160 chars
  birthday      DateTime?
  city          String?            // legacy short city name
  location      String?            // AES-256-GCM encrypted full address
  locationIv    String?            // base64 IV for location decryption

  // Contact
  phone         String?

  // Verification level:  0 = basic (Google only)
  //                      1 = email confirmed
  //                      2 = KYC (biometric, future)
  level         Int      @default(0)
  emailVerified Boolean  @default(false)

  // Ijodkor pullik obunasi — 0 = o'chiq, >0 = oylik narx (Ƶ)
  subPriceZij   Int      @default(0)

  // Tasdiqlangan (ko'k belgi) — founderlardan tashqari, ariza orqali
  verified      Boolean  @default(false)
  verifiedAt    DateTime?

  // Onboarding
  onboardingDone Boolean @default(false)

  // Akkaunt o'chirildi (tombstone) — hamyon/ledger saqlanadi, PII tozalanadi, kontent o'chadi
  deletedAt     DateTime?

  // Rate-limit: user-initiated profile edits allowed once per 14 days
  profileEditedAt DateTime?

  lastLoginAt   DateTime?
  loginEvents   LoginEvent[]
  supportTickets SupportTicket[]
  emailCodes    EmailVerificationCode[]
  identities    Identity[]
  zijWallet     ZijWallet?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LoginEvent {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime    @default(now())
}

model SupportTicket {
  id          String       @id @default(cuid())
  profileId   String?
  profile     UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  email       String
  subject     String
  message     String
  status      String       @default("open")
  createdAt   DateTime     @default(now())
}

model EmailVerificationCode {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  correct     Int         // e.g. 74  — the right answer
  options     Int[]       // e.g. [23, 74, 51, 38] shown on screen

  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

// Humo eSport (0dan, Humo ID ustida) -- docs/humo-esport-design.md

model EsGame {            // disiplina (JADVAL — yangi o'yin koddа o'zgarishsiz qo'shiladi)
  id          String   @id @default(cuid())
  slug        String   @unique          // "mlbb", "pubgm"
  name        String                    // "Mobile Legends: Bang Bang"
  teamSize    Int                       // MLBB=5, PUBGM=4
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  rosters     EsRoster[]
  athletes    EsAthlete[]
  divisions   EsDivision[]
  tournaments EsTournament[]
}

model EsTeam {            // tashkilot — o'yinга bog'liq EMAS
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   @unique            // qisqa teg (masalan "RMC")
  logo      String?
  ownerId   String                      // UserProfile.id (Humo ID egasi)
  bio       String?
  createdAt DateTime @default(now())
  rosters   EsRoster[]
  @@index([ownerId])
}

model EsRoster {          // har (jamoa × o'yin) bitta tarkib
  id      String @id @default(cuid())
  teamId  String
  gameId  String
  team    EsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  game    EsGame @relation(fields: [gameId], references: [id])
  members EsRosterMember[]
  @@unique([teamId, gameId])
  @@index([gameId])
}

model EsAthlete {         // Humo ID + bitta o'yin (qattiq qulf)
  id            String  @id @default(cuid())
  humoProfileId String  @unique         // bir Humo ID = bitta athlete
  gameId        String                  // IMMUTABLE — hech qachon o'zgarmaydi
  ign           String                  // in-game nom
  gameUserId    String                  // in-game ID (MLBB raqami)
  gameServer    String?                 // server/zona
  role          String?                 // pozitsiya
  createdAt     DateTime @default(now())
  game          EsGame  @relation(fields: [gameId], references: [id])
  memberships   EsRosterMember[]
  transfers     EsTransfer[]
  @@index([gameId])
}

model EsRosterMember {    // sportchini tarkibга bog'laydi (transfer shu yerda)
  id        String   @id @default(cuid())
  rosterId  String
  athleteId String
  role      String   @default("STARTER")  // CAPTAIN/STARTER/SUB
  joinedAt  DateTime @default(now())
  roster    EsRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  athlete   EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([athleteId])                  // sportchi bir vaqtда bitta tarkibда (o'z o'yinида)
  @@index([rosterId])
}

model EsDivision {        // futboldek tier (1/2/3)
  id     String @id @default(cuid())
  gameId String
  name   String                          // "Pro Division"
  tier   Int                             // 1 = eng yuqori
  game   EsGame @relation(fields: [gameId], references: [id])
  @@unique([gameId, tier])
}

model EsSeason {          // mavsum
  id       String   @id @default(cuid())
  gameId   String
  name     String                        // "2026 Season 1"
  startsAt DateTime @default(now())
  endsAt   DateTime?
  active   Boolean  @default(true)
}

model EsTournament {      // turnir
  id           String   @id @default(cuid())
  gameId       String
  divisionId   String?
  seasonId     String?
  name         String
  format       String   @default("SINGLE_ELIM")  // SINGLE_ELIM/DOUBLE_ELIM/GROUPS
  prizePool    Decimal? @db.Decimal(18, 2)
  currency     String   @default("UZS")
  status       String   @default("UPCOMING")      // UPCOMING/REGISTRATION/LIVE/ENDED
  maxTeams     Int      @default(16)
  startsAt     DateTime?
  createdAt    DateTime @default(now())
  game         EsGame   @relation(fields: [gameId], references: [id])
  participants EsTournamentTeam[]
  matches      EsMatch[]
  @@index([gameId, status])
}

model EsTournamentTeam {  // ro'yxatdan o'tgan jamoa (o'z o'yin-tarkibi bilan)
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  rosterId     String                    // qaysi tarkib bilan kirgan
  seed         Int?
  registeredAt DateTime @default(now())
  tournament   EsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, teamId])
  @@index([tournamentId])
}

model EsMatch {           // bracket o'yini
  id           String    @id @default(cuid())
  tournamentId String
  round        Int
  slot         Int                        // round ichидаги o'rin (bracket pozitsiya)
  teamAId      String?
  teamBId      String?
  scoreA       Int?
  scoreB       Int?
  winnerId     String?
  status       String    @default("PENDING")  // PENDING/LIVE/DONE
  streamUrl    String?                         // Nexus/Twitch havola
  scheduledAt  DateTime?
  tournament   EsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId, round])
}

model EsStanding {        // divizion/mavsum jadvali
  id         String @id @default(cuid())
  seasonId   String
  divisionId String
  teamId     String
  points     Int    @default(0)
  wins       Int    @default(0)
  losses     Int    @default(0)
  @@unique([seasonId, divisionId, teamId])
  @@index([seasonId, divisionId])
}

model EsTransfer {        // sportchi jamoadan jamoага (ALKH Pay haq)
  id         String   @id @default(cuid())
  athleteId  String
  fromTeamId String?
  toTeamId   String
  fee        Decimal? @db.Decimal(18, 2)      // 0/null = bepul
  currency   String   @default("UZS")
  status     String   @default("PENDING")     // PENDING/DONE/CANCELLED
  createdAt  DateTime @default(now())
  athlete    EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, createdAt])
  @@index([toTeamId])
}

// ── Humo Market ──────────────────────────────────────────────────────────────

model MarketBrand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logo        String?
  description String?
  category    String?           // (eski — birinchi yo'nalish, backward compat)
  categories  String[] @default([])   // bir nechta yo'nalish
  verified    Boolean  @default(false)
  ownerId     String
  isPaid      Boolean  @default(false)  // 2-chi+ brend pullik
  createdAt   DateTime @default(now())

  products    MarketProduct[]
  reviews     MarketBrandReview[]
}

model MarketWishlist {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([profileId, productId])
}

model MarketReview {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String        // faqat harid qilganlar sharh yoza oladi
  rating    Int           // 1-5
  text      String?
  media     String[] @default([])   // rasm + video URL'lar
  hidden    Boolean  @default(false) // moderatsiya — yashirilgan
  createdAt DateTime @default(now())
  likes     MarketReviewLike[]
  replies   MarketReviewReply[]
  @@unique([profileId, productId])
}

// Sharhga javob — cheksiz ichma-ich (parentId orqali)
model MarketReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?       // null = sharhga to'g'ridan; aks holda javobga javob
  profileId String
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([reviewId])
}

// Sharhga "qo'shilaman" (like) — necha kishi rozi. Avtomatik, qo'lda emas.
model MarketReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([reviewId, profileId])
}

// Bildirishnomalar (avtomatik yaratiladi)
model MarketNotification {
  id        String          @id @default(cuid())
  profileId String          // qabul qiluvchi
  type      MarketNotifType
  title     String
  body      String?
  link      String?         // bosilganda o'tadigan manzil
  image     String?
  read      Boolean         @default(false)
  createdAt DateTime        @default(now())
  @@index([profileId, read])
}

enum MarketNotifType {
  REVIEW_LIKE
  PRODUCT_REVIEW
  BRAND_REVIEW
  ORDER_DELIVERED
  ORDER_ACCEPTED
  ORDER_UPDATE
  REVIEW_REMINDER
  REPLY
  QUESTION
  ANSWER
}

// Brendga sharh + baho (faqat shu brenddan harid qilganlar)
model MarketBrandReview {
  id        String   @id @default(cuid())
  brandId   String
  brand     MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  profileId String
  rating    Int           // 1-5
  text      String?
  createdAt DateTime @default(now())
  @@unique([brandId, profileId])
}

model MarketProduct {
  id          String   @id @default(cuid())
  brandId     String
  brand       MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  slug        String   @unique
  description String?
  images      String[]          // rasm URL massiv
  videos      String[] @default([])   // video URL massiv
  price       Decimal  @db.Decimal(18, 2)   // Zij narxi
  oldPrice    Decimal? @db.Decimal(18, 2)   // chegirma bo'lsa eski narx
  stock       Int      @default(0)
  sold        Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)

  category    String            // asosiy kategoriya slug
  subcategory String?           // kichik kategoriya slug

  variantLabel String?          // variant guruh nomi, masalan "O'lcham" yoki "Rang" (null = variantsiz)

  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems   MarketCartItem[]
  orderItems  MarketOrderItem[]
  wishlists   MarketWishlist[]
  reviews     MarketReview[]
  questions   MarketProductQuestion[]
  variants    MarketProductVariant[]
}

// Mahsulot varianti (rang/o'lcham/xotira...) — har biriga alohida narx va stock
model MarketProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        // ko'rsatiladigan nom: "Qora / XL", "256 GB"
  price     Decimal  @db.Decimal(18, 2)
  oldPrice  Decimal? @db.Decimal(18, 2)
  stock     Int      @default(0)
  image     String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  cartItems MarketCartItem[]
  @@index([productId])
}

// Mahsulotga savol (harid shart emas — sotib olishdan oldin so'raladi)
model MarketProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  answers   MarketProductAnswer[]
  @@index([productId])
}

// Savolga javob (har kim; sotuvchi javobi ajratiladi)
model MarketProductAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   MarketProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profileId  String
  text       String
  hidden     Boolean  @default(false) // moderatsiya
  createdAt  DateTime @default(now())
  @@index([questionId])
}

// Moderatsiya flagi — foydalanuvchi shikoyati + AI xulosasi (Market+Nexus yagona)
model ModerationFlag {
  id           String             @id @default(cuid())
  module       String             // "MARKET" | "NEXUS"
  targetType   String             // PRODUCT/REVIEW/REPLY/QUESTION/ANSWER/POST/COMMENT
  targetId     String
  // foydalanuvchi shikoyatlari
  reportCount  Int                @default(0)
  lastReason   String?
  // AI xulosasi
  aiVerdict    ModerationVerdict?
  aiCategories String[]           @default([])
  aiSeverity   Float?
  aiReason     String?
  // hal qilish holati
  status       ModerationStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@unique([module, targetType, targetId])
  @@index([status])
}

// Har bir foydalanuvchi-shikoyati (dedup + rate-limit uchun). Bir foydalanuvchi
// bir target'ni faqat 1 marta shikoyat qila oladi (@@unique). Takroriy/spam
// shikoyat AI'ni qayta chaqirmaydi — xarajat himoyasi ModerationFlag tomonida.
model NexusReport {
  id         String   @id @default(cuid())
  reporterId String
  module     String   // "MARKET" | "NEXUS"
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  @@unique([reporterId, module, targetType, targetId])
  @@index([reporterId, createdAt])
}

// AI chaqiruvlari jurnali — faqat rate-limit uchun (pullik Gemini suiiste'molini to'sadi).
model AiUsage {
  id        String   @id @default(cuid())
  profileId String
  kind      String?  // "chat" | "search" | "listing" | "assist"
  createdAt DateTime @default(now())
  @@index([profileId, createdAt])
}

// Tavsiya algoritmi 4-bosqich: semantik embeddinglar (pgvector + Gemini).
// Prisma vector turini bilmaydi → Unsupported; insert/qidiruv raw SQL orqali (lib/nexus-embed.ts).
model NexusPostEmbedding {
  postId    String                      @id
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
}

model NexusUserEmbedding {
  profileId  String                      @id
  embedding  Unsupported("vector(768)")?
  computedAt DateTime                    @default(now())
}

// Tavsiya algoritmi 2-bosqich: saqlanadigan qiziqish vektori (kunlik cron'da qayta hisoblanadi).
// Signallar: like/save (post muallif+teg), video ko'rish (muallif+kategoriya+teg), follow (muallif).
// Json = { kalit: og'irlik } (top-N saqlanadi). Feed reytingi shu profil bilan tartiblaydi.
model NexusInterest {
  profileId  String   @id          // bitta foydalanuvchi = bitta vektor
  authors    Json     @default("{}")  // { authorId: weight }
  tags       Json     @default("{}")  // { tag: weight }
  categories Json     @default("{}")  // { category: weight }
  recAuthors Json     @default("{}")  // 3-bosqich CF: { authorId: score } — kuzatmagan, lekin tavsiya
  computedAt DateTime @default(now())
}

enum ModerationStatus {
  PENDING      // admin ko'rishi kutilmoqda
  KEPT         // ko'rib chiqildi — saqlandi
  HIDDEN       // admin yashirdi
  AUTO_HIDDEN  // AI avtomatik yashirdi (jiddiy)
}

enum ModerationVerdict {
  OK
  REVIEW
  BLOCK
}

model MarketCartItem {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   MarketProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([profileId, productId, variantId])
}

model MarketOrder {
  id            String              @id @default(cuid())
  profileId     String
  total         Decimal             @db.Decimal(18, 2)   // chegirmadan keyingi yakuniy summa
  discount      Decimal             @default(0) @db.Decimal(18, 2)
  promoCode     String?
  settledAt     DateTime?           // sotuvchilarga to'lov amalga oshirilgan vaqt (ikki marta to'lamaslik uchun)
  status        MarketOrderStatus   @default(PENDING)
  paymentMethod MarketPaymentMethod @default(ZIJ)
  address       String              // manzil majburiy
  note          String?
  createdAt     DateTime            @default(now())

  items         MarketOrderItem[]
}

// Promokod / kupon (platforma darajasida — asoschilar yaratadi)
model MarketPromoCode {
  id          String          @id @default(cuid())
  code        String          @unique
  type        MarketPromoType
  value       Decimal         @db.Decimal(18, 2)   // PERCENT: 1-100, FIXED: Ƶ miqdori
  minOrder    Decimal         @default(0) @db.Decimal(18, 2)
  maxDiscount Decimal?        @db.Decimal(18, 2)   // PERCENT uchun yuqori chegara
  usageLimit  Int?            // null = cheksiz
  usedCount   Int             @default(0)
  expiresAt   DateTime?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
}

enum MarketPromoType {
  PERCENT
  FIXED
}

enum MarketPaymentMethod {
  ZIJ              // Zij bilan to'landi
  CASH_ON_DELIVERY // Yetkazishda naqd
  CARD_ON_DELIVERY // Yetkazishda karta
}

model MarketOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id])
  variantId   String?       // tanlangan variant (agar bor bo'lsa)
  variantName String?       // denormalizatsiya — variant o'chsa ham tarix saqlanadi
  quantity    Int
  price       Decimal  @db.Decimal(18, 2)   // sotib olingan paytdagi narx
}

enum MarketOrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

// ── Nexus — ijtimoiy tarmoq (postlar, feed, like, izoh, follow) ──────────────
model NexusPost {
  id              String   @id @default(cuid())
  profileId       String                          // muallif (UserProfile.id)
  text            String?
  media           String[] @default([])           // rasm/video URL'lar
  hashtags        String[] @default([])
  marketProductId String?                         // ixtiyoriy — postga biriktirilgan Market mahsuloti ("Sotib olish")
  privacy         NexusPostPrivacy @default(PUBLIC)  // PUBLIC / FOLLOWERS (obunachilar) / PRIVATE (faqat men)
  location        String?                         // ixtiyoriy joylashuv matni
  pollOptions     String[] @default([])           // bo'sh = so'rovnoma yo'q (2-4 variant)
  pollEndsAt      DateTime?                       // so'rovnoma tugash vaqti
  shareCount      Int      @default(0)
  hidden          Boolean  @default(false) // moderatsiya
  editedAt        DateTime?                // tahrirlangan bo'lsa
  createdAt       DateTime @default(now())

  likes     NexusLike[]
  comments  NexusComment[]
  saves     NexusSave[]
  pollVotes NexusPollVote[]

  @@index([profileId])
  @@index([createdAt])
}

enum NexusPostPrivacy {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS   // faqat pullik obunachilar
  PRIVATE
}

// So'rovnoma ovozi — bir post uchun bir ovoz (o'zgartirish mumkin, muddati tugaguncha)
model NexusPollVote {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  optionIdx Int
  createdAt DateTime  @default(now())
  @@unique([postId, profileId])
  @@index([postId])
}

model NexusLike {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
  @@index([profileId, createdAt])   // qiziqish profili (rec-algoritm) uchun
}

model NexusSave {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
}

model NexusComment {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?                               // cheksiz ichma-ich javob uchun
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([postId])
}

model NexusFollow {
  id          String   @id @default(cuid())
  followerId  String                              // kim follow qilyapti
  followingId String                              // kimni
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

// Bloklash — ikki tomonlama ko'rinmaslik. A B'ni bloklasa: B A'ning kontentini
// ko'rmaydi, DM yoza olmaydi, follow qila olmaydi (va aksincha). Mavjud follow'lar uziladi.
model NexusBlock {
  id        String   @id @default(cuid())
  blockerId String                                // kim bloklayapti (UserProfile.id)
  blockedId String                                // kimni
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Ovozsizlantirish — yumshoq, bir tomonlama. A B'ni mute qilsa: A B'ning kontentini
// tasmada ko'rmaydi, lekin B bilmaydi va bemalol o'zaro aloqa qila oladi.
model NexusMute {
  id        String   @id @default(cuid())
  muterId   String                                // kim mute qilyapti (UserProfile.id)
  mutedId   String                                // kimni
  createdAt DateTime @default(now())
  @@unique([muterId, mutedId])
  @@index([muterId])
}

// Bildirishnoma — like/izoh/follow/javob (relation yo'q, MarketNotification kabi)
model NexusNotification {
  id          String         @id @default(cuid())
  recipientId String                              // kim oladi (UserProfile.id)
  actorId     String                              // kim qildi
  type        NexusNotifType
  postId      String?
  commentId   String?
  videoId     String?                             // video like/izoh/xarid uchun
  trackId     String?                             // trek like uchun
  liveId      String?                             // jonli efir uchun
  amountZij   Int?                                // tip/xarid miqdori (Ƶ)
  read        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

enum NexusNotifType {
  LIKE
  COMMENT
  FOLLOW
  REPLY
  VIDEO_LIKE
  VIDEO_COMMENT
  TRACK_LIKE
  PURCHASE
  LIVE
  TIP
  MENTION
  SUB_EXPIRING
}

// Story — 24 soatlik vaqtinchalik kontent
model NexusStory {
  id        String              @id @default(cuid())
  profileId String
  mediaUrl  String
  mediaType NexusStoryMediaType @default(IMAGE)
  caption   String?
  createdAt DateTime            @default(now())
  expiresAt DateTime                              // = createdAt + 24 soat
  views     NexusStoryView[]
  @@index([profileId, expiresAt])
  @@index([expiresAt])
}

enum NexusStoryMediaType {
  IMAGE
  VIDEO
}

// Story ko'rilganligi — halqa (seen) + ko'rganlar soni uchun
model NexusStoryView {
  id        String     @id @default(cuid())
  storyId   String
  story     NexusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profileId String                                // kim ko'rdi
  createdAt DateTime   @default(now())
  @@unique([storyId, profileId])
  @@index([storyId])
}

// Shaxsiy yozishma (1:1) — user1Id < user2Id normalizatsiya
model NexusConversation {
  id              String    @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessageAt   DateTime  @default(now())
  lastMessageText String?
  lastSenderId    String?
  user1ReadAt     DateTime?
  user2ReadAt     DateTime?
  createdAt       DateTime  @default(now())
  messages        NexusMessage[]
  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
}

model NexusMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String
  createdAt      DateTime          @default(now())
  @@index([conversationId, createdAt])
}

// ── Nexus Video — to'liq video (LONG) va Shorts (SHORT) ──────────────────────
model NexusVideo {
  id          String         @id @default(cuid())
  profileId   String                                // kanal / yuklovchi
  title       String
  description String?                               // cheksiz uzunlik
  videoUrl    String                                // Vercel Blob MP4 URL
  thumbUrl    String?                               // muqova (custom yoki client thumbnail)
  durationSec Int            @default(0)
  kind        NexusVideoKind @default(LONG)
  orientation NexusVideoOrientation @default(HORIZONTAL)  // G.Video (gorizontal) / V.Video (vertikal)
  width       Int?                                  // video o'lchami — orientation aniqlash
  height      Int?
  category    String?                               // kino / musiqa / gaming ...
  tags        String[]                              // foydalanuvchi #teglari (cheksiz)
  descImages  String[]                              // tavsifdagi dalil rasmlari
  isMature    Boolean        @default(false)        // 18+ — voyaga yetmaganlardan yashiriladi
  priceZij    Int            @default(0)            // 0 = bepul, >0 = pullik (Ƶ)
  prevVideoId String?                               // series — avvalgi qism (joylangan bo'lishi shart)
  prevVideo   NexusVideo?    @relation("VideoSeries", fields: [prevVideoId], references: [id], onDelete: SetNull)
  nextParts   NexusVideo[]   @relation("VideoSeries")
  views       Int            @default(0)
  hidden      Boolean        @default(false)         // moderatsiya
  createdAt   DateTime       @default(now())
  likes       NexusVideoLike[]
  comments    NexusVideoComment[]
  purchases   NexusVideoPurchase[]
  @@index([kind, createdAt])
  @@index([orientation, createdAt])
  @@index([profileId, createdAt])
}

enum NexusVideoKind {
  LONG
  SHORT
}

enum NexusVideoOrientation {
  HORIZONTAL    // G.Video
  VERTICAL      // V.Video (reels)
}

model NexusVideoView {
  id        String   @id @default(cuid())
  videoId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([videoId, profileId])
  @@index([videoId])
}

model NexusVideoLike {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime   @default(now())
  @@unique([videoId, profileId])
}

model NexusVideoComment {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean    @default(false)   // moderatsiya
  createdAt DateTime   @default(now())
  @@index([videoId, createdAt])
}

// ── Nexus Live — jonli efirlar ───────────────────────────────────────────────
// Faza 1: lifecycle + chat + ko'ruvchi heartbeat. Video transport keyingi faza.
model NexusLiveStream {
  id          String           @id @default(cuid())
  profileId   String                                  // streamer
  title       String
  category    String?
  privacy     NexusLivePrivacy @default(PUBLIC)
  status      NexusLiveStatus  @default(LIVE)
  scheduledAt DateTime?                               // UPCOMING uchun
  startedAt   DateTime?
  endedAt     DateTime?
  peakViewers Int              @default(0)
  likes       Int              @default(0)
  hidden      Boolean          @default(false)      // moderatsiya — yashirilgan efir
  createdAt   DateTime         @default(now())
  messages    NexusLiveMessage[]
  @@index([status, createdAt])
  @@index([profileId, createdAt])
}

enum NexusLiveStatus {
  UPCOMING
  LIVE
  ENDED
}

enum NexusLivePrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}

model NexusLiveMessage {
  id        String          @id @default(cuid())
  streamId  String
  stream    NexusLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  tipZij    Int             @default(0)            // > 0 bo'lsa — Super Chat (pulli, ajratilgan)
  hidden    Boolean         @default(false)        // moderatsiya
  createdAt DateTime        @default(now())
  @@index([streamId, createdAt])
}

// Tip / donat — ijodkorni qo'llab-quvvatlash. Zij donor→ijodkor o'tadi (komissiyasiz).
model NexusTip {
  id          String      @id @default(cuid())
  donorId     String                              // kim yubordi (UserProfile.id)
  recipientId String                              // ijodkor
  amountZij   Int                                 // miqdor (Ƶ)
  targetType  NexusTipTarget @default(PROFILE)    // nimaga: profil/post/video/jonli
  targetId    String?                             // tegishli kontent id (PROFILE uchun null)
  message     String?                             // ixtiyoriy izoh (Super Chat matni)
  createdAt   DateTime    @default(now())
  @@index([recipientId, createdAt])
  @@index([donorId, createdAt])
}

enum NexusTipTarget {
  PROFILE
  POST
  VIDEO
  LIVE
}

// ── Kanallar va Guruhlar ─────────────────────────────────────────────────────
// CHANNEL — bir tomonlama e'lon (faqat admin yozadi, a'zolar o'qiydi).
// GROUP   — ko'p a'zoli suhbat (a'zolar yozadi).
model NexusChannel {
  id          String   @id @default(cuid())
  ownerId     String                              // yaratuvchi (UserProfile.id)
  type        NexusChannelType @default(CHANNEL)
  name        String
  handle      String?  @unique                    // @handle (ixtiyoriy, ommaviy uchun)
  description String?
  avatarUrl   String?
  isPrivate   Boolean  @default(false)            // private = faqat taklif/havola bilan
  memberCount Int      @default(1)
  hidden      Boolean  @default(false)            // moderatsiya
  createdAt   DateTime @default(now())
  members     NexusChannelMember[]
  messages    NexusChannelMessage[]
  @@index([type, isPrivate, createdAt])
}

enum NexusChannelType {
  CHANNEL
  GROUP
}

model NexusChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  profileId String
  role      NexusChannelRole @default(MEMBER)
  lastReadAt DateTime?
  joinedAt  DateTime @default(now())
  @@unique([channelId, profileId])
  @@index([profileId])
}

enum NexusChannelRole {
  OWNER
  ADMIN
  MEMBER
}

model NexusChannelMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([channelId, createdAt])
}

// Web Push obunasi — brauzer push bildirishnomalari uchun (VAPID).
model NexusPushSub {
  id        String   @id @default(cuid())
  profileId String                              // egasi (UserProfile.id)
  endpoint  String   @unique                    // push service endpoint
  p256dh    String                              // kalit
  auth      String                              // kalit
  createdAt DateTime @default(now())
  @@index([profileId])
}

// Humo ID SSO — "Humo ID bilan kirish". Foydalanuvchi rozilik bergach qisqa muddatli
// kod yaratiladi; hamkor uni server-aro (HMAC) profilga almashtiradi (OAuth code-flow uslubi).
model HumoSsoCode {
  id          String   @id @default(cuid())
  code        String   @unique               // tasodifiy kod (token exchange uchun)
  profileId   String                          // rozilik bergan foydalanuvchi (UserProfile.id)
  clientId    String                          // hamkor ilova id
  redirectUri String                          // tasdiqlangan redirect
  scope       String                          // bo'sh bilan ajratilgan: profile email nexus
  expiresAt   DateTime                        // 5 daqiqa
  usedAt      DateTime?                       // bir martalik
  createdAt   DateTime @default(now())
  @@index([profileId, createdAt])
}

// Verifikatsiya arizasi — ijodkor ko'k belgi so'raydi; founder ko'rib chiqadi.
model NexusVerifyRequest {
  id          String   @id @default(cuid())
  profileId   String   @unique                  // ariza beruvchi (UserProfile.id)
  fullName    String                             // haqiqiy ism
  category    String                             // kim: bloger/musiqachi/brend/jurnalist...
  reason      String                             // nega tasdiqlanishi kerak
  links       String[] @default([])              // ijtimoiy tarmoq/manba havolalari
  status      NexusVerifyStatus @default(PENDING)
  reviewedBy  String?                            // founder profileId
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([status, createdAt])
}

enum NexusVerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pullik obuna — obunachi ijodkorga oylik Zij to'laydi, expiresAt gacha SUBSCRIBERS kontent ochiq.
// Avto-uzaytirish yo'q (karta yo'q): obuna = 30 kunlik oldindan to'lov, qo'lda yangilanadi.
model NexusSubscription {
  id           String   @id @default(cuid())
  subscriberId String                              // obunachi (UserProfile.id)
  creatorId    String                              // ijodkor
  priceZij     Int                                 // to'langan oylik narx (obuna paytida qotiriladi)
  startedAt    DateTime @default(now())
  expiresAt    DateTime                            // shu vaqtgacha faol
  expiryNotifiedAt DateTime?                       // tugashga yaqin bildirishnoma yuborilgan vaqt
  createdAt    DateTime @default(now())
  @@unique([subscriberId, creatorId])
  @@index([expiresAt])
  @@index([subscriberId, expiresAt])
  @@index([creatorId, expiresAt])
}

// Jonli ko'ruvchi — heartbeat (lastSeenAt > now-30s = onlayn)
model NexusLiveViewer {
  id         String   @id @default(cuid())
  streamId   String
  profileId  String
  lastSeenAt DateTime @default(now())
  @@unique([streamId, profileId])
  @@index([streamId, lastSeenAt])
}

// Pullik video xaridi — Zij avtorning hamyoniga tushadi
model NexusVideoPurchase {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  buyerId   String                                  // UserProfile id
  priceZij  Int                                     // to'langan summa (Ƶ)
  createdAt DateTime   @default(now())
  @@unique([videoId, buyerId])
  @@index([buyerId, createdAt])
}

// "Keyinroq ko'rish" ro'yxati
model NexusWatchLater {
  id        String   @id @default(cuid())
  profileId String
  videoId   String
  createdAt DateTime @default(now())
  @@unique([profileId, videoId])
  @@index([profileId, createdAt])
}

// ── Nexus Media — audio treklar (musiqa / podkast / audiokitob) ──────────────
model NexusTrack {
  id          String         @id @default(cuid())
  profileId   String                              // yuklovchi
  title       String
  artist      String?                             // ijrochi/muallif ko'rinadigan nomi
  audioUrl    String                              // Vercel Blob audio
  coverUrl    String?                             // muqova rasmi
  durationSec Int            @default(0)
  kind        NexusTrackKind @default(MUSIC)
  genre       String?
  plays       Int            @default(0)
  hidden      Boolean        @default(false)      // moderatsiya
  createdAt   DateTime       @default(now())
  likes       NexusTrackLike[]
  @@index([kind, createdAt])
  @@index([kind, plays])
  @@index([profileId, createdAt])
}

enum NexusTrackKind {
  MUSIC
  PODCAST
  AUDIOBOOK
}

// Tinglash — foydalanuvchi bo'yicha bir marta hisoblanadi
model NexusTrackPlay {
  id        String   @id @default(cuid())
  trackId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([trackId, profileId])
  @@index([trackId])
}

model NexusTrackLike {
  id        String     @id @default(cuid())
  trackId   String
  track     NexusTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime   @default(now())
  @@unique([trackId, profileId])
  @@index([profileId, createdAt])
}

// ── ALKH Pay — real pul hamyoni (UZS / USD) ──────────────────────────────────
//
// Endi real valyuta: O'zbekiston foydalanuvchilari so'm (UZS), xorijliklar dollar (USD).
// ("Zij" tushunchasi olib tashlandi — model nomlari ichki, foydalanuvchiga ko'rinmaydi.)
// Hozir TEST rejimda: deposit darhol tushadi, withdraw payout-so'rov yaratadi.
// MChJ + to'lov shlyuzi (Click/Payme/karta) kalitlari kelganda real ishlaydi (lib/payments).

model ZijWallet {
  id          String   @id @default(cuid())
  profileId   String   @unique
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hamyon valyutasidagi miqdor
  currency    String   @default("UZS")                 // UZS yoki USD (foydalanuvchi davlatidan)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions ZijTransaction[]
  safes        ZijSafe[]
  payouts      PayoutRequest[]
}

model ZijTransaction {
  id          String             @id @default(cuid())
  walletId    String
  wallet      ZijWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type        ZijTransactionType
  amount      Decimal            @db.Decimal(18, 2)   // musbat son (shu tranzaksiya valyutasida)
  currency    String             @default("UZS")      // tranzaksiya valyutasi
  balanceAfter Decimal           @db.Decimal(18, 2)   // tranzaksiyadan keyin balans

  description String?
  ref         String?            // tashqi ref (order ID, payout ID, profil ID)

  createdAt   DateTime @default(now())
}

enum ZijTransactionType {
  DEPOSIT    // pul kirish (to'lov shlyuzi orqali)
  WITHDRAW   // pul chiqish (payout)
  PURCHASE   // xarid
  REFUND     // qaytarish
  SALE       // sotuvchi daromadi (komissiya ayirilgan)
  REWARD     // mukofot / cashback
  TRANSFER_OUT  // yuborish (tip/obuna/do'stga)
  TRANSFER_IN   // qabul qilish
  SAFE_IN       // seyfga o'tkazish
  SAFE_OUT      // seyfdan chiqarish
}

// Pul yechish so'rovi (payout). Test rejimda darhol "tugatilgan"; real rejimda
// to'lov shlyuzi orqali kartaga/hisobga o'tkaziladi.
model PayoutRequest {
  id          String   @id @default(cuid())
  walletId    String
  wallet      ZijWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(18, 2)
  currency    String
  method      String                              // "card" | "bank" | ...
  destination String                              // karta raqami (maskalangan) / hisob
  status      PayoutStatus @default(PENDING)
  providerRef String?                             // shlyuz tranzaksiya id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([walletId, createdAt])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Virtual seyf — maqsadli jamg'arma
model ZijSafe {
  id          String   @id @default(cuid())
  walletId    String
  wallet      ZijWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  name        String              // "Parij sayohati", "Yangi telefon" va h.k.
  emoji       String   @default("🏦")
  targetAmount Decimal @db.Decimal(18, 2)   // maqsad summa
  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hozirgi balans
  isCompleted Boolean  @default(false)      // to'lgan yoki yo'q

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
