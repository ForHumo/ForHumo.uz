generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Humo ID — unified identity across all For Humo services ──────────────────

model UserProfile {
  id            String   @id @default(cuid())
  email         String   @unique
  googleId      String?  @unique

  // Name fields
  name          String?            // display name (editable)
  firstName     String?
  lastName      String?
  fatherName    String?            // Otasining ismi

  // Identity
  username      String?  @unique   // @handle — e.g. "forhumo_ali"
  humoId        String?  @unique   // e.g. "UZ4829341"
  country       String?  @default("UZ")  // ISO alpha-2

  // Profile
  image         String?            // custom avatar URL (null = use Google photo)
  coverImage    String?            // background/banner image URL
  bio           String?            // max 160 chars
  birthday      DateTime?
  city          String?            // legacy short city name
  location      String?            // AES-256-GCM encrypted full address
  locationIv    String?            // base64 IV for location decryption

  // Contact
  phone         String?

  // Verification level:  0 = basic (Google only)
  //                      1 = email confirmed
  //                      2 = KYC (biometric, future)
  level         Int      @default(0)
  emailVerified Boolean  @default(false)

  // Role
  isAdmin       Boolean  @default(false)

  // Onboarding — age gate + legal consents (v1.1)
  onboardingDone    Boolean  @default(false)
  tosAccepted       Boolean  @default(false)
  privacyAccepted   Boolean  @default(false)
  humoLawAccepted   Boolean  @default(false)
  consentedAt       DateTime?

  // Rate-limit: user-initiated profile edits allowed once per 14 days
  profileEditedAt DateTime?

  lastLoginAt   DateTime?
  loginEvents   LoginEvent[]
  supportTickets SupportTicket[]
  emailCodes    EmailVerificationCode[]

  // ALKH Pay
  wallet        Wallet?
  credential    UserCredential?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── ALKH Pay — Closed-Loop Wallet (v1.0: deposit only, NO fiat withdrawal) ────

model Wallet {
  id           String      @id @default(cuid())
  profileId    String      @unique
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// ZIJ balance — single float, no sub-units. Format: "12.5 ZIJ"
  balance      Float       @default(0.0)

  transactions Transaction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Transaction {
  id          String            @id @default(cuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// Positive = credit, negative = debit (in ZIJ)
  amount      Float
  type        TransactionType
  source      TransactionSource
  description String?
  /// Extra metadata: tournamentId, contentId, etc.
  meta        Json?

  createdAt   DateTime @default(now())
}

enum TransactionType {
  CREDIT   // ZIJ added to wallet
  DEBIT    // ZIJ spent from wallet
}

/// Legal guardrail: NO WITHDRAWAL source exists — ZIJ is utility-only (v1.0).
/// Fiat in: TOPUP_* sources only. Fiat out: forbidden until v2.0 + CBU license.
enum TransactionSource {
  TOPUP_UZUM           // UZS → ZIJ via Uzum webhook
  TOPUP_CLICK          // UZS → ZIJ via Click webhook
  TOPUP_PAYME          // UZS → ZIJ via Payme webhook
  NEXUS_SUBSCRIPTION   // Nexus Pro / Creator Pro purchase
  NEXUS_DONATION       // Content creator tip/donation on Nexus
  ESPORT_ENTRY_FEE     // Tournament registration payment
  EDU_REWARD           // Earned from completing Humo EDU activities
  SYSTEM_REWARD        // Admin / promotional grant
  REFUND               // System-initiated refund (credit)
}

// ── Email / Password credentials (fallback to Google OAuth) ───────────────────

model UserCredential {
  id           String      @id @default(cuid())
  profileId    String      @unique
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// bcryptjs hash — NEVER store plaintext passwords
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginEvent {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime    @default(now())
}

model SupportTicket {
  id          String       @id @default(cuid())
  profileId   String?
  profile     UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  email       String
  subject     String
  message     String
  status      String       @default("open")
  createdAt   DateTime     @default(now())
}

model EmailVerificationCode {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  correct     Int         // e.g. 74  — the right answer
  options     Int[]       // e.g. [23, 74, 51, 38] shown on screen

  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

model User {
  id        String   @id @default(cuid())
  nickname  String   @unique
  createdAt DateTime @default(now())

  teams     TeamMember[]
  ownedTeams Team[]
  sentRequests JoinRequest[]
  role      UserRole @default(USER)
}

model PlayerProfile {
  id          String   @id @default(cuid())
  nickname    String   @unique
  firstName   String
  lastName    String
  telegram    String
  avatar      String?
  
  level       Int      @default(1)
  gamesPlayed Int      @default(0)
  isActive    Boolean  @default(false)
  joinedAt    DateTime @default(now())
  
  mlbbInfo    Json?
  pubgInfo    Json?
}

model Team {
  id        String   @id @default(cuid())
  name      String
  tag       String   @unique
  logo      String?
  createdAt DateTime @default(now())
  
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])

  members       TeamMember[]
  requests      JoinRequest[]
  invites       TeamInvite[]
  tournaments   TournamentTeam[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  teamId    String
  createdBy String
  expiresAt DateTime?
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
}

model TeamMember {
  id        String   @id @default(cuid())
  role      TeamRole
  joinedAt  DateTime @default(now())

  userId    String
  teamId    String

  user      User @relation(fields: [userId], references: [id])
  team      Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

enum TeamRole {
  OWNER
  CAPTAIN
  MEMBER
}

model JoinRequest {
  id        String            @id @default(cuid())
  userId    String
  teamId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  season      String
  game        String
  prizePool   Int
  maxTeams    Int
  status      TournamentStatus @default(UPCOMING)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime         @default(now())

  teams       TournamentTeam[]
  matches     TournamentMatch[]
  standings   TournamentStanding[]
}

model TournamentTeam {
  id            String     @id @default(cuid())
  tournamentId  String
  teamId        String
  registeredAt  DateTime   @default(now())
  
  snapshotName  String
  snapshotLogo  String?

  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  team          Team       @relation(fields: [teamId], references: [id])

  matchesAsA    TournamentMatch[] @relation("TeamA")
  matchesAsB    TournamentMatch[] @relation("TeamB")
  matchesWon    TournamentMatch[] @relation("Winner")
  standings     TournamentStanding[]

  @@unique([tournamentId, teamId])
}

model TournamentMatch {
  id          String   @id @default(cuid())
  matchNumber Int
  stage       String
  date        DateTime
  time        String

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  teamAId     String
  teamA       TournamentTeam @relation("TeamA", fields: [teamAId], references: [id])

  teamBId     String
  teamB       TournamentTeam @relation("TeamB", fields: [teamBId], references: [id])

  scoreA      Int?
  scoreB      Int?

  winnerId    String?
  winner      TournamentTeam? @relation("Winner", fields: [winnerId], references: [id])

  status      String
  youtubeUrl  String?
  adminNote   String?
}

model TournamentStanding {
  id          String   @id @default(cuid())
  position    Int
  prize       Int
  proofUrl    String?
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  teamId      String
  team        TournamentTeam @relation(fields: [teamId], references: [id])
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}
