generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Humo ID — unified identity across all For Humo services ──────────────────

model UserProfile {
  id            String   @id @default(cuid())
  email         String   @unique
  googleId      String?  @unique

  // Name fields
  name          String?            // display name (editable)
  firstName     String?
  lastName      String?
  fatherName    String?            // Otasining ismi

  // Identity
  username      String?  @unique   // @handle — e.g. "forhumo_ali"
  humoId        String?  @unique   // e.g. "UZ4829341"
  country       String?  @default("UZ")  // ISO alpha-2

  // Profile
  image         String?            // custom avatar URL (null = use Google photo)
  coverImage    String?            // background/banner image URL
  bio           String?            // max 160 chars
  birthday      DateTime?
  city          String?            // legacy short city name
  location      String?            // AES-256-GCM encrypted full address
  locationIv    String?            // base64 IV for location decryption

  // Contact
  phone         String?

  // Verification level:  0 = basic (Google only)
  //                      1 = email confirmed
  //                      2 = KYC (biometric, future)
  level         Int      @default(0)
  emailVerified Boolean  @default(false)

  // Onboarding
  onboardingDone Boolean @default(false)

  // Rate-limit: user-initiated profile edits allowed once per 14 days
  profileEditedAt DateTime?

  lastLoginAt   DateTime?
  loginEvents   LoginEvent[]
  supportTickets SupportTicket[]
  emailCodes    EmailVerificationCode[]
  zijWallet     ZijWallet?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LoginEvent {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime    @default(now())
}

model SupportTicket {
  id          String       @id @default(cuid())
  profileId   String?
  profile     UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  email       String
  subject     String
  message     String
  status      String       @default("open")
  createdAt   DateTime     @default(now())
}

model EmailVerificationCode {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  correct     Int         // e.g. 74  — the right answer
  options     Int[]       // e.g. [23, 74, 51, 38] shown on screen

  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

model User {
  id        String   @id @default(cuid())
  nickname  String   @unique
  createdAt DateTime @default(now())

  teams     TeamMember[]
  ownedTeams Team[]
  sentRequests JoinRequest[]
  role      UserRole @default(USER)
}

model PlayerProfile {
  id          String   @id @default(cuid())
  nickname    String   @unique
  firstName   String
  lastName    String
  telegram    String
  avatar      String?
  
  level       Int      @default(1)
  gamesPlayed Int      @default(0)
  isActive    Boolean  @default(false)
  joinedAt    DateTime @default(now())
  
  mlbbInfo    Json?
  pubgInfo    Json?
}

model Team {
  id        String   @id @default(cuid())
  name      String
  tag       String   @unique
  logo      String?
  createdAt DateTime @default(now())
  
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])

  members       TeamMember[]
  requests      JoinRequest[]
  invites       TeamInvite[]
  tournaments   TournamentTeam[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  teamId    String
  createdBy String
  expiresAt DateTime?
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
}

model TeamMember {
  id        String   @id @default(cuid())
  role      TeamRole
  joinedAt  DateTime @default(now())

  userId    String
  teamId    String

  user      User @relation(fields: [userId], references: [id])
  team      Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

enum TeamRole {
  OWNER
  CAPTAIN
  MEMBER
}

model JoinRequest {
  id        String            @id @default(cuid())
  userId    String
  teamId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  season      String
  game        String
  prizePool   Int
  maxTeams    Int
  status      TournamentStatus @default(UPCOMING)
  startDate   DateTime
  endDate     DateTime?
  // Zij kirish badali (0 = bepul). 1 Zij = 1 USD, o'zgarmas.
  entryFee    Decimal          @default(0) @db.Decimal(18, 2)
  createdAt   DateTime         @default(now())

  teams       TournamentTeam[]
  matches     TournamentMatch[]
  standings   TournamentStanding[]
}

model TournamentTeam {
  id            String     @id @default(cuid())
  tournamentId  String
  teamId        String
  registeredAt  DateTime   @default(now())
  
  snapshotName  String
  snapshotLogo  String?

  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  team          Team       @relation(fields: [teamId], references: [id])

  matchesAsA    TournamentMatch[] @relation("TeamA")
  matchesAsB    TournamentMatch[] @relation("TeamB")
  matchesWon    TournamentMatch[] @relation("Winner")
  standings     TournamentStanding[]

  @@unique([tournamentId, teamId])
}

model TournamentMatch {
  id          String   @id @default(cuid())
  matchNumber Int
  stage       String
  date        DateTime
  time        String

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  teamAId     String
  teamA       TournamentTeam @relation("TeamA", fields: [teamAId], references: [id])

  teamBId     String
  teamB       TournamentTeam @relation("TeamB", fields: [teamBId], references: [id])

  scoreA      Int?
  scoreB      Int?

  winnerId    String?
  winner      TournamentTeam? @relation("Winner", fields: [winnerId], references: [id])

  status      String
  youtubeUrl  String?
  adminNote   String?
}

model TournamentStanding {
  id          String   @id @default(cuid())
  position    Int
  prize       Int
  proofUrl    String?
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  teamId      String
  team        TournamentTeam @relation(fields: [teamId], references: [id])
}

// ── Humo Market ──────────────────────────────────────────────────────────────

model MarketBrand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logo        String?
  description String?
  category    String?           // (eski — birinchi yo'nalish, backward compat)
  categories  String[] @default([])   // bir nechta yo'nalish
  verified    Boolean  @default(false)
  ownerId     String
  isPaid      Boolean  @default(false)  // 2-chi+ brend pullik
  createdAt   DateTime @default(now())

  products    MarketProduct[]
  reviews     MarketBrandReview[]
}

model MarketWishlist {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([profileId, productId])
}

model MarketReview {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String        // faqat harid qilganlar sharh yoza oladi
  rating    Int           // 1-5
  text      String?
  media     String[] @default([])   // rasm + video URL'lar
  hidden    Boolean  @default(false) // moderatsiya — yashirilgan
  createdAt DateTime @default(now())
  likes     MarketReviewLike[]
  replies   MarketReviewReply[]
  @@unique([profileId, productId])
}

// Sharhga javob — cheksiz ichma-ich (parentId orqali)
model MarketReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?       // null = sharhga to'g'ridan; aks holda javobga javob
  profileId String
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([reviewId])
}

// Sharhga "qo'shilaman" (like) — necha kishi rozi. Avtomatik, qo'lda emas.
model MarketReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([reviewId, profileId])
}

// Bildirishnomalar (avtomatik yaratiladi)
model MarketNotification {
  id        String          @id @default(cuid())
  profileId String          // qabul qiluvchi
  type      MarketNotifType
  title     String
  body      String?
  link      String?         // bosilganda o'tadigan manzil
  image     String?
  read      Boolean         @default(false)
  createdAt DateTime        @default(now())
  @@index([profileId, read])
}

enum MarketNotifType {
  REVIEW_LIKE
  PRODUCT_REVIEW
  BRAND_REVIEW
  ORDER_DELIVERED
  ORDER_ACCEPTED
  ORDER_UPDATE
  REVIEW_REMINDER
  REPLY
  QUESTION
  ANSWER
}

// Brendga sharh + baho (faqat shu brenddan harid qilganlar)
model MarketBrandReview {
  id        String   @id @default(cuid())
  brandId   String
  brand     MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  profileId String
  rating    Int           // 1-5
  text      String?
  createdAt DateTime @default(now())
  @@unique([brandId, profileId])
}

model MarketProduct {
  id          String   @id @default(cuid())
  brandId     String
  brand       MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  slug        String   @unique
  description String?
  images      String[]          // rasm URL massiv
  videos      String[] @default([])   // video URL massiv
  price       Decimal  @db.Decimal(18, 2)   // Zij narxi
  oldPrice    Decimal? @db.Decimal(18, 2)   // chegirma bo'lsa eski narx
  stock       Int      @default(0)
  sold        Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)

  category    String            // asosiy kategoriya slug
  subcategory String?           // kichik kategoriya slug

  variantLabel String?          // variant guruh nomi, masalan "O'lcham" yoki "Rang" (null = variantsiz)

  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems   MarketCartItem[]
  orderItems  MarketOrderItem[]
  wishlists   MarketWishlist[]
  reviews     MarketReview[]
  questions   MarketProductQuestion[]
  variants    MarketProductVariant[]
}

// Mahsulot varianti (rang/o'lcham/xotira...) — har biriga alohida narx va stock
model MarketProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        // ko'rsatiladigan nom: "Qora / XL", "256 GB"
  price     Decimal  @db.Decimal(18, 2)
  oldPrice  Decimal? @db.Decimal(18, 2)
  stock     Int      @default(0)
  image     String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  cartItems MarketCartItem[]
  @@index([productId])
}

// Mahsulotga savol (harid shart emas — sotib olishdan oldin so'raladi)
model MarketProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  answers   MarketProductAnswer[]
  @@index([productId])
}

// Savolga javob (har kim; sotuvchi javobi ajratiladi)
model MarketProductAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   MarketProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profileId  String
  text       String
  hidden     Boolean  @default(false) // moderatsiya
  createdAt  DateTime @default(now())
  @@index([questionId])
}

// Moderatsiya flagi — foydalanuvchi shikoyati + AI xulosasi (Market+Nexus yagona)
model ModerationFlag {
  id           String             @id @default(cuid())
  module       String             // "MARKET" | "NEXUS"
  targetType   String             // PRODUCT/REVIEW/REPLY/QUESTION/ANSWER/POST/COMMENT
  targetId     String
  // foydalanuvchi shikoyatlari
  reportCount  Int                @default(0)
  lastReason   String?
  // AI xulosasi
  aiVerdict    ModerationVerdict?
  aiCategories String[]           @default([])
  aiSeverity   Float?
  aiReason     String?
  // hal qilish holati
  status       ModerationStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@unique([module, targetType, targetId])
  @@index([status])
}

enum ModerationStatus {
  PENDING      // admin ko'rishi kutilmoqda
  KEPT         // ko'rib chiqildi — saqlandi
  HIDDEN       // admin yashirdi
  AUTO_HIDDEN  // AI avtomatik yashirdi (jiddiy)
}

enum ModerationVerdict {
  OK
  REVIEW
  BLOCK
}

model MarketCartItem {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   MarketProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([profileId, productId, variantId])
}

model MarketOrder {
  id            String              @id @default(cuid())
  profileId     String
  total         Decimal             @db.Decimal(18, 2)   // chegirmadan keyingi yakuniy summa
  discount      Decimal             @default(0) @db.Decimal(18, 2)
  promoCode     String?
  settledAt     DateTime?           // sotuvchilarga to'lov amalga oshirilgan vaqt (ikki marta to'lamaslik uchun)
  status        MarketOrderStatus   @default(PENDING)
  paymentMethod MarketPaymentMethod @default(ZIJ)
  address       String              // manzil majburiy
  note          String?
  createdAt     DateTime            @default(now())

  items         MarketOrderItem[]
}

// Promokod / kupon (platforma darajasida — asoschilar yaratadi)
model MarketPromoCode {
  id          String          @id @default(cuid())
  code        String          @unique
  type        MarketPromoType
  value       Decimal         @db.Decimal(18, 2)   // PERCENT: 1-100, FIXED: Ƶ miqdori
  minOrder    Decimal         @default(0) @db.Decimal(18, 2)
  maxDiscount Decimal?        @db.Decimal(18, 2)   // PERCENT uchun yuqori chegara
  usageLimit  Int?            // null = cheksiz
  usedCount   Int             @default(0)
  expiresAt   DateTime?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
}

enum MarketPromoType {
  PERCENT
  FIXED
}

enum MarketPaymentMethod {
  ZIJ              // Zij bilan to'landi
  CASH_ON_DELIVERY // Yetkazishda naqd
  CARD_ON_DELIVERY // Yetkazishda karta
}

model MarketOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id])
  variantId   String?       // tanlangan variant (agar bor bo'lsa)
  variantName String?       // denormalizatsiya — variant o'chsa ham tarix saqlanadi
  quantity    Int
  price       Decimal  @db.Decimal(18, 2)   // sotib olingan paytdagi narx
}

enum MarketOrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

// ── Nexus — ijtimoiy tarmoq (postlar, feed, like, izoh, follow) ──────────────
model NexusPost {
  id              String   @id @default(cuid())
  profileId       String                          // muallif (UserProfile.id)
  text            String?
  media           String[] @default([])           // rasm/video URL'lar
  hashtags        String[] @default([])
  marketProductId String?                         // ixtiyoriy — postga biriktirilgan Market mahsuloti ("Sotib olish")
  shareCount      Int      @default(0)
  hidden          Boolean  @default(false) // moderatsiya
  createdAt       DateTime @default(now())

  likes    NexusLike[]
  comments NexusComment[]
  saves    NexusSave[]

  @@index([profileId])
  @@index([createdAt])
}

model NexusLike {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
}

model NexusSave {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
}

model NexusComment {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?                               // cheksiz ichma-ich javob uchun
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([postId])
}

model NexusFollow {
  id          String   @id @default(cuid())
  followerId  String                              // kim follow qilyapti
  followingId String                              // kimni
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

// Bildirishnoma — like/izoh/follow/javob (relation yo'q, MarketNotification kabi)
model NexusNotification {
  id          String         @id @default(cuid())
  recipientId String                              // kim oladi (UserProfile.id)
  actorId     String                              // kim qildi
  type        NexusNotifType
  postId      String?
  commentId   String?
  read        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

enum NexusNotifType {
  LIKE
  COMMENT
  FOLLOW
  REPLY
}

// ── ALKH Pay — Zij valyuta hamyoni ───────────────────────────────────────────
//
// Zij (Ƶ) — ALKH Pay ichki valyutasi.
// Al-Xorazmiy kitoblari ("Zij") nomidan olingan.
// Kurs: 1 Ƶ = 1 USD — bu kurs O'ZGARMAS, tizim tomonidan qat'iy belgilangan.
// Kelajakda ham bu nisbat saqlanadi.

model ZijWallet {
  id          String   @id @default(cuid())
  profileId   String   @unique
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  balance     Decimal  @default(0) @db.Decimal(18, 2)  // Zij miqdori

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions ZijTransaction[]
  safes        ZijSafe[]
}

model ZijTransaction {
  id          String             @id @default(cuid())
  walletId    String
  wallet      ZijWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type        ZijTransactionType
  amount      Decimal            @db.Decimal(18, 2)   // musbat son
  balanceAfter Decimal           @db.Decimal(18, 2)   // tranzaksiyadan keyin balans

  description String?            // "Test to'ldirish", "eSport turnir kirish badali" va h.k.
  ref         String?            // tashqi ref (kelajakda: turnir ID, order ID)

  createdAt   DateTime @default(now())
}

enum ZijTransactionType {
  DEPOSIT    // pul kirish (test rejim)
  WITHDRAW   // pul chiqish (hozircha o'chirilgan)
  PURCHASE   // xarid (turnir, Nexus Pro va h.k.)
  REFUND     // buyurtma bekor qilinganda qaytarish
  SALE       // Market sotuvchisiga tushgan daromad (komissiya ayirilgan)
  REWARD     // mukofot (turnir yutug'i, cashback)
  TRANSFER_OUT  // do'stga yuborish
  TRANSFER_IN   // do'stdan qabul qilish
  SAFE_IN       // seyfga o'tkazish
  SAFE_OUT      // seyfdan chiqarish
}

// Virtual seyf — maqsadli jamg'arma
model ZijSafe {
  id          String   @id @default(cuid())
  walletId    String
  wallet      ZijWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  name        String              // "Parij sayohati", "Yangi telefon" va h.k.
  emoji       String   @default("🏦")
  targetAmount Decimal @db.Decimal(18, 2)   // maqsad summa
  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hozirgi balans
  isCompleted Boolean  @default(false)      // to'lgan yoki yo'q

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
