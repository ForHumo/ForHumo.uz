enum NexusVideoKind {
  LONG
  SHORT
}

enum NexusVideoOrientation {
  HORIZONTAL    // G.Video
  VERTICAL      // V.Video (reels)
}

model NexusVideoView {
  id        String   @id @default(cuid())
  videoId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([videoId, profileId])
  @@index([videoId])
