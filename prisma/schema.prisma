generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Humo ID — unified identity across all For Humo services ──────────────────

enum AccountType {
  GOOGLE   // To'liq Humo ID — Google bilan (For Humo loyihalari)
  SWEET    // Sweet ID — hamkor (Sevinch Sweets), Telegram bilan; ma'lumotni Humo ID saqlaydi
}

enum AuthProvider {
  GOOGLE
  TELEGRAM
}

// Bitta Humo ID profili ↔ login usuli(lar)i. SWEET profil uchun bu TELEGRAM
// identity bo'ladi; bu Sevinch Sweets ↔ Humo ID "ko'prigi" (Sweet ID).
model Identity {
  id         String       @id @default(cuid())
  profileId  String
  profile    UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  providerId String        // Google "sub" yoki Telegram user id (string)
  username   String?
  photoUrl   String?
  createdAt  DateTime     @default(now())

  @@unique([provider, providerId])
  @@index([profileId])
}

model UserProfile {
  id            String      @id @default(cuid())
  email         String?     @unique   // SWEET (Telegram) profillarda bo'lmaydi
  googleId      String?     @unique
  accountType   AccountType @default(GOOGLE)
  origin        String?                 // SWEET uchun qaysi hamkor yaratgan (masalan "sevinch")

  // Name fields
  name          String?            // display name (editable)
  firstName     String?
  lastName      String?
  fatherName    String?            // Otasining ismi

  // Identity
  username      String?  @unique   // @handle — e.g. "forhumo_ali"
  humoId        String?  @unique   // e.g. "UZ4829341"
  country       String?  @default("UZ")  // ISO alpha-2

  // Profile
  image         String?            // custom avatar URL (null = use Google photo)
  coverImage    String?            // background/banner image URL
  bio           String?            // max 160 chars
  birthday      DateTime?
  city          String?            // legacy short city name
  location      String?            // AES-256-GCM encrypted full address
  locationIv    String?            // base64 IV for location decryption

  // Contact
  phone         String?

  // Verification level:  0 = basic (Google only)
  //                      1 = email confirmed
  //                      2 = KYC (biometric, future)
  level         Int      @default(0)
  emailVerified Boolean  @default(false)

  // Ijodkor pullik obunasi — 0 = o'chiq, >0 = oylik narx (subCurrency valyutasida)
  subPrice      Int      @default(0) @map("subPriceZij")
  subCurrency   Currency @default(UZS)

  // Tasdiqlangan (ko'k belgi) — founderlardan tashqari, ariza orqali
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  // Kategoriya bo'yicha tasdiq (YouTube uslubi): musician/filmmaker/author/sportsman/journalist/
  // creator/gamer/entertainer/organization/government. NULL = generic (founder yoki eski).
  verifiedCategory  String?

  // AI moderation blokirovkalari (progressiv)
  bans              UserBan[]

  // Steam OpenID linking (CS2 sportchilar uchun majburiy; login emas — faqat identity link)
  steamId64     String?   @unique   // Valve SteamID64 (17-rem raqam)
  steamPersona  String?             // Steam displayed nickname (Web API'dan olinadi)
  steamAvatar   String?             // Steam avatar URL (Web API'dan olinadi)
  steamLinkedAt DateTime?

  // Onboarding
  onboardingDone Boolean @default(false)

  // Akkaunt o'chirildi (tombstone) — hamyon/ledger saqlanadi, PII tozalanadi, kontent o'chadi
  deletedAt     DateTime?

  // Rate-limit: user-initiated profile edits allowed once per 14 days
  profileEditedAt DateTime?

  // Ikkinchi valyutani (USD) narxlar yonida referens sifatida ko'rsatish
  showUsdRef    Boolean  @default(false)

  // Bildirishnoma sozlamalari — JSON: { LIKE: false, COMMENT: true, ... }
  // Ro'yxatda YO'Q tur = default yoqilgan. Faqat OFF'lar saqlanadi.
  notifPrefs    Json?

  // Nexus chaqiruv ringtone (signature/whisper/pulse/melody/classic) — default signature
  ringtone      String   @default("signature")

  lastLoginAt   DateTime?
  loginEvents   LoginEvent[]
  supportTickets SupportTicket[]
  marketWorker    MarketWorker? @relation("MarketWorkerProfile")
  marketWorkersAdded MarketWorker[] @relation("MarketWorkerAddedBy")
  emailCodes    EmailVerificationCode[]
  identities    Identity[]
  wallet        Wallet?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LoginEvent {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime    @default(now())
}

model SupportTicket {
  id          String       @id @default(cuid())
  profileId   String?
  profile     UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  email       String
  subject     String
  message     String       // dastlabki xabar (backward compat)
  status      String       @default("open")     // open / pending / closed
  module      String?                            // "bn"|"nexus"|"market"|"pay"|"id"|"esport"|"ai"|"support"
  updatedAt   DateTime     @default(now()) @updatedAt
  createdAt   DateTime     @default(now())
  messages    SupportMessage[]

  @@index([profileId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

// Humo Market — Owner tomonidan taklif qilingan worker'lar.
// Owner = founder (isFounderProfile). Worker = quyidagi jadvalda profileId'si bor.
// Worker keyinchalik username o'zgartirsa ham huquqi qoladi (ID bo'yicha bog'langan).
model MarketWorker {
  id                String       @id @default(cuid())
  profileId         String       @unique
  profile           UserProfile  @relation("MarketWorkerProfile", fields: [profileId], references: [id], onDelete: Cascade)
  addedByProfileId  String                                        // owner profileId
  addedByProfile    UserProfile  @relation("MarketWorkerAddedBy", fields: [addedByProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime     @default(now())
  @@index([addedByProfileId])
}

model SupportMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorRole   String        // "USER" | "ADMIN"
  authorId     String?       // profileId
  body         String        // <= 2000
  readByUser   Boolean       @default(true)
  readByAdmin  Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model EmailVerificationCode {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  correct     Int         // e.g. 74  — the right answer
  options     Int[]       // e.g. [23, 74, 51, 38] shown on screen

  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

// Humo eSport (0dan, Humo ID ustida) -- docs/humo-esport-design.md

model EsAdmin {           // eSport admini (ega Humo ID raqami bilan qo'shadi)
  id        String   @id @default(cuid())
  humoId    String   @unique
  createdBy String                          // qo'shgan ega humoId
  createdAt DateTime @default(now())
}

model EsGame {            // disiplina (JADVAL — yangi o'yin koddа o'zgarishsiz qo'shiladi)
  id          String   @id @default(cuid())
  slug        String   @unique          // "mlbb", "pubgm"
  name        String                    // "Mobile Legends: Bang Bang"
  teamSize    Int                       // MLBB=5, PUBGM=4
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  rosters     EsRoster[]
  athletes    EsAthlete[]
  divisions   EsDivision[]
  tournaments EsTournament[]
}

model EsTeam {            // tashkilot — o'yinга bog'liq EMAS
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   @unique            // qisqa teg (masalan "RMC")
  logo      String?
  coverImage String?                    // jamoa banneri (muqova)
  ownerId   String                      // UserProfile.id (Humo ID egasi)
  bio       String?
  createdAt DateTime @default(now())
  rosters      EsRoster[]
  invites      EsTeamInvite[]
  joinRequests EsJoinRequest[]
  requests     EsRequest[]
  staff        EsTeamStaff[]
  @@index([ownerId])
}

model EsTeamStaff {        // jamoa lavozimlari (o'yinchi bo'lishi shart emas — istalgan Humo ID)
  id        String   @id @default(cuid())
  teamId    String
  profileId String                      // UserProfile.id
  role      String                      // VICE_OWNER | COACH | CAPTAIN | STAFF
  title     String?                     // STAFF uchun erkin lavozim (Direktor/Buxgalter/Admin)
  createdAt DateTime @default(now())
  team      EsTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([teamId, profileId])         // bir odam jamoada bitta lavozim yozuvi
  @@index([teamId])
}

model EsTeamInvite {       // taklif-kod (ega yaratadi, sportchi kod bilan qo'shiladi)
  id        String    @id @default(cuid())
  teamId    String
  code      String    @unique
  createdBy String                        // ega profileId
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  team      EsTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@index([teamId])
}

model EsJoinRequest {      // ariza (sportchi beradi, ega tasdiqlaydi)
  id        String    @id @default(cuid())
  teamId    String
  athleteId String
  status    String    @default("PENDING")  // PENDING/ACCEPTED/REJECTED
  createdAt DateTime  @default(now())
  team      EsTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete   EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([teamId, athleteId])
  @@index([teamId, status])
}

model EsRoster {          // har (jamoa × o'yin) bitta tarkib
  id          String @id @default(cuid())
  teamId      String
  gameId      String
  rating      Int    @default(1000)       // Elo kuch reytingi (mavsumlar aro saqlanadi; 1000 = boshlang'ich)
  peakRating  Int    @default(1000)       // eng yuqori Elo (tarix)
  lowRating   Int    @default(1000)       // eng past Elo (tarix)
  team    EsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  game    EsGame @relation(fields: [gameId], references: [id])
  members EsRosterMember[]
  @@unique([teamId, gameId])
  @@index([gameId])
}

model EsAthlete {         // Humo ID + bitta o'yin (qattiq qulf)
  id            String  @id @default(cuid())
  humoProfileId String  @unique         // bir Humo ID = bitta athlete
  gameId        String                  // IMMUTABLE — hech qachon o'zgarmaydi
  ign           String  @unique         // in-game nom — TAKRORLANMAYDI
  gameUserId    String                  // in-game ID (MLBB raqami) — o'yin ichida takrorlanmaydi
  gameServer    String?                 // server/zona
  role          String?                 // pozitsiya
  image         String?                 // avatar (null = Humo ID rasmi)
  coverImage    String?                 // profil banneri (muqova)
  marketValue   Decimal? @db.Decimal(18, 2)  // transfer bozori narxi
  blockedUntil  DateTime?               // bloklangan bo'lsa shu sanagacha (null=blok yo'q; uzoq sana=abadiy)
  blockReason   String?                 // bloklash sababi (admin)
  createdAt     DateTime @default(now())
  game          EsGame  @relation(fields: [gameId], references: [id])
  memberships   EsRosterMember[]
  transfers     EsTransfer[]
  joinRequests  EsJoinRequest[]
  contracts     EsContract[]
  @@unique([gameId, gameUserId])        // o'yin ID raqami takrorlanmaydi
  @@index([gameId])
}

model EsRosterMember {    // sportchini tarkibга bog'laydi (transfer shu yerda)
  id        String   @id @default(cuid())
  rosterId  String
  athleteId String
  role      String   @default("STARTER")  // CAPTAIN/STARTER/SUB
  joinedAt  DateTime @default(now())
  roster    EsRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  athlete   EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([athleteId])                  // sportchi bir vaqtда bitta tarkibда (o'z o'yinида)
  @@index([rosterId])
}

model EsDivision {        // futboldek tier (1 = eng yuqori; eng katta tier = Ochiq divizion)
  id       String @id @default(cuid())
  gameId   String
  name     String                        // "Pro Division"
  tier     Int                           // 1 = eng yuqori
  capacity Int?                          // jamoalar chegarasi; null = CHEKSIZ (Ochiq divizion)
  game     EsGame @relation(fields: [gameId], references: [id])
  @@unique([gameId, tier])
}

model EsSeason {          // mavsum
  id       String   @id @default(cuid())
  gameId   String
  name     String                        // "2026 Season 1"
  startsAt DateTime @default(now())
  endsAt   DateTime?
  active   Boolean  @default(true)
}

model EsTournament {      // turnir
  id           String   @id @default(cuid())
  gameId       String
  divisionId   String?
  seasonId     String?
  name         String
  format       String   @default("SINGLE_ELIM")  // SINGLE_ELIM/DOUBLE_ELIM/GROUPS
  prizePool    Decimal? @db.Decimal(18, 2)
  prizeFunded  Decimal  @default(0) @db.Decimal(18, 2)  // egadan escrow'ga to'ldirilgan mukofot
  currency     String   @default("UZS")
  status       String   @default("UPCOMING")      // UPCOMING/REGISTRATION/LIVE/ENDED
  maxTeams     Int      @default(16)               // 0 = cheksiz (Ochiq divizion turniri)
  thirdPlace   Boolean  @default(true)             // 3-o'rin o'yini (TOP 3 uchun)
  registrationStartsAt DateTime?                   // Ochiq divizion: ro'yxat ochiladi
  registrationEndsAt DateTime?                     // Ochiq divizion: ro'yxat yopiladi
  bracketAt    DateTime?                           // setka avtomatik tuziladigan vaqt (10:00 +5)
  startsAt     DateTime?
  endsAt       DateTime?
  bracketReady Boolean  @default(false)            // setka tuzilganmi
  createdAt    DateTime @default(now())
  game         EsGame   @relation(fields: [gameId], references: [id])
  participants EsTournamentTeam[]
  matches      EsMatch[]
  @@index([gameId, status])
}

model EsTournamentTeam {  // ro'yxatdan o'tgan jamoa (o'z o'yin-tarkibi bilan)
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  rosterId     String                    // qaysi tarkib bilan kirgan
  seed         Int?
  registeredAt DateTime @default(now())
  tournament   EsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, teamId])
  @@index([tournamentId])
}

model EsMatch {           // bracket o'yini
  id           String    @id @default(cuid())
  tournamentId String
  bracket      String    @default("MAIN")  // MAIN/THIRD (3-o'rin)
  round        Int
  slot         Int                        // round ichидаги o'rin (bracket pozitsiya)
  teamAId      String?
  teamBId      String?
  seedA        Int?                            // seeding raqami (ko'rsatish uchun)
  seedB        Int?
  scoreA       Int?
  scoreB       Int?
  winnerId     String?
  status       String    @default("PENDING")  // PENDING/LIVE/DONE
  streamUrl    String?                         // Nexus/Twitch havola
  proofUrl     String?                         // natija isboti (yakuniy hisob skrinshoti)
  scheduledAt  DateTime?
  // bracket ulanishi: g'olib qayerga, mag'lub qayerga (yarim final -> 3-o'rin)
  nextMatchId      String?
  nextSlot         String?                     // "A" | "B"
  loserNextMatchId String?
  loserNextSlot    String?
  tournament   EsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId, round])
}

model EsStanding {        // divizion/mavsum jadvali
  id         String @id @default(cuid())
  seasonId   String
  divisionId String
  teamId     String
  points     Int    @default(0)
  wins       Int    @default(0)
  losses     Int    @default(0)
  played     Int    @default(0)
  @@unique([seasonId, divisionId, teamId])
  @@index([seasonId, divisionId])
}

model EsLeagueMatch {     // liga o'yini (divizion ichida) — natija standings'ni yangilaydi
  id          String    @id @default(cuid())
  seasonId    String
  divisionId  String
  teamAId     String
  teamBId     String
  scoreA      Int?
  scoreB      Int?
  winnerId    String?                          // hisoblangan natija
  status      String    @default("SCHEDULED")  // SCHEDULED/DONE
  streamUrl   String?
  proofUrl    String?                          // natija isboti (yakuniy hisob skrinshoti)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([seasonId, divisionId, status])
}

model EsTransfer {        // futbol-transfer: o'yinchiga oylik taklif → qabul → jamoaga haq → ALKH Pay
  id            String   @id @default(cuid())
  athleteId     String
  fromTeamId    String?                          // sotuvchi jamoa (null = erkin sportchi)
  toTeamId      String                           // xaridor jamoa
  salary        Decimal? @db.Decimal(18, 2)      // oylik maosh (o'yinchi bilan kelishuv)
  conditions    String?                          // qo'shimcha shartlar
  contractMonths Int?                            // shartnoma muddati (oy)
  fee           Decimal? @db.Decimal(18, 2)      // transfer haqi (jamoaga; marketValuedan kam emas)
  currency      String   @default("UZS")
  status        String   @default("PLAYER_PENDING") // PLAYER_PENDING/AWAIT_FEE/CLUB_PENDING/DONE/REJECTED/CANCELLED
  createdAt     DateTime @default(now())
  athlete    EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, createdAt])
  @@index([toTeamId])
}

model EsNotification {   // eSport bildirishnomalari (transfer/ariza/kelishuv)
  id        String   @id @default(cuid())
  profileId String                          // qabul qiluvchi UserProfile.id
  type      String                          // TRANSFER_OFFER / TRANSFER_FEE / TRANSFER_DONE / JOIN_REQUEST / JOIN_RESULT / LEAVE_REQ / KICK_REQ / TEAM_DELETE_REQ / REQ_RESULT
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([profileId, read])
  @@index([profileId, createdAt])
}

model EsNews {            // Asosiy sahifadagi yangiliklar (admin yozadi)
  id        String   @id @default(cuid())
  title     String
  body      String?
  image     String?
  pinned    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model EsRetro {           // arxiv turnir (tarixiy natijalar — Turnirlar bo'limida)
  id        String   @id @default(cuid())
  name      String                          // "Autumn Tournament"
  season    String                          // "2025-2026"
  game      String                          // "Mobile Legends: Bang Bang"
  organizer String   @default("For Humo & Humo eSport")
  startDate DateTime
  endDate   DateTime
  prizePool Int?
  currency  String   @default("UZS")
  champion  String?
  runnerUp  String?
  third     String?
  createdAt DateTime @default(now())
  matches   EsRetroMatch[]
}

model EsRetroMatch {
  id      String  @id @default(cuid())
  retroId String
  order   Int
  date    String                            // ko'rsatish uchun "10/11/2025"
  time    String?
  stage   String                            // GROUP STAGE / SEMIFINALS / THIRD PLACE / GRAND FINAL
  teamA   String
  teamB   String
  scoreA  Int?
  scoreB  Int?
  winner  String?
  note    String?                           // o'yin holati
  reason  String?                           // sabab
  youtube String?
  retro   EsRetro @relation(fields: [retroId], references: [id], onDelete: Cascade)
  @@index([retroId, order])
}

model EsRequest {         // a'zolik kelishuvi: chiqish/chiqarish/jamoa o'chirish (ikki tomonlama rozilik)
  id          String   @id @default(cuid())
  type        String                          // LEAVE (sportchi chiqmoqchi) / KICK (jamoa chiqarmoqchi) / TEAM_DELETE
  teamId      String
  athleteId   String?                         // LEAVE/KICK — tegishli sportchi
  initiatedBy String                          // profileId
  status      String   @default("PENDING")    // PENDING/APPROVED/REJECTED/CANCELLED
  createdAt   DateTime @default(now())
  team        EsTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  approvals   EsRequestApproval[]
  @@index([teamId, status])
  @@index([athleteId, status])
}

model EsRequestApproval {  // TEAM_DELETE uchun a'zo ovozlari (100% rozilik kerak)
  id        String   @id @default(cuid())
  requestId String
  athleteId String
  createdAt DateTime @default(now())
  request   EsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@unique([requestId, athleteId])
}

model EsContract {        // o'yinchi shartnomasi (transfer/futbol modelidan) — muddat, oylik, status
  id         String    @id @default(cuid())
  athleteId  String
  teamId     String
  salary     Decimal?  @db.Decimal(18, 2)
  currency   String    @default("UZS")
  startsAt   DateTime  @default(now())
  endsAt     DateTime?                          // null = muddatsiz; o'tsa lazy-EXPIRED
  status     String    @default("ACTIVE")       // ACTIVE | EXPIRED | TERMINATED
  createdAt  DateTime  @default(now())
  athlete    EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, status])
  @@index([teamId, status])
}

model EsDispute {         // natija e'tirozi (jamoa egasi bildiradi, admin hakam)
  id            String   @id @default(cuid())
  matchType     String                          // TOURNAMENT | LEAGUE
  matchId       String                          // EsMatch.id yoki EsLeagueMatch.id (polimorf, FK yo'q)
  teamId        String                          // e'tiroz bildirgan jamoa
  filedBy       String                          // UserProfile id (ega)
  reason        String
  screenshotUrl String?                         // dalil skrinshoti
  status        String   @default("OPEN")       // OPEN | RESOLVED | REJECTED
  adminNote     String?                         // hakam izohi
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  @@index([status, createdAt])
  @@index([matchType, matchId])
}

model EsBroadcast {       // turnir translyatsiyasi (Asosiy 16:9 oyna — Nexus integratsiya)
  id           String    @id @default(cuid())
  title        String
  status       String    @default("SCHEDULED")  // LIVE/SCHEDULED/ENDED
  streamUrl    String?                           // embed havola (YouTube/Twitch/Nexus)
  source       String    @default("EXTERNAL")     // EXTERNAL (YouTube/Twitch) | CLOUDFLARE; Nexus = nexusLiveId
  liveInputId  String?                           // Cloudflare live input uid
  playbackId   String?                           // Cloudflare playback uid
  streamKey    String?                           // MAXFIY — faqat admin/ega (OBS)
  ingestUrl    String?                           // RTMP ingest URL
  nexusLiveId  String?                           // Nexus jonli efir bog'lanishi
  posterUrl    String?                           // muqova rasmi (oblojka)
  tournamentId String?
  matchId      String?
  scheduledAt  DateTime?                         // boshlanish vaqti (rejalashtirilgan)
  endsAt       DateTime?                         // tugash vaqti (avto-status uchun)
  endedAt      DateTime?
  viewers      Int       @default(0)
  createdBy    String                            // admin Humo ID
  createdAt    DateTime  @default(now())
  @@index([status, scheduledAt])
}

// ── Humo Market ──────────────────────────────────────────────────────────────

model MarketBrand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logo        String?
  description String?
  category    String?           // (eski — birinchi yo'nalish, backward compat)
  categories  String[] @default([])   // bir nechta yo'nalish
  verified    Boolean  @default(false)
  ownerId     String
  isPaid      Boolean  @default(false)  // 2-chi+ brend pullik
  createdAt   DateTime @default(now())

  products    MarketProduct[]
  reviews     MarketBrandReview[]
}

model MarketWishlist {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([profileId, productId])
}

model MarketReview {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String        // faqat harid qilganlar sharh yoza oladi
  rating    Int           // 1-5
  text      String?
  media     String[] @default([])   // rasm + video URL'lar
  hidden    Boolean  @default(false) // moderatsiya — yashirilgan
  createdAt DateTime @default(now())
  likes     MarketReviewLike[]
  replies   MarketReviewReply[]
  @@unique([profileId, productId])
}

// Sharhga javob — cheksiz ichma-ich (parentId orqali)
model MarketReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?       // null = sharhga to'g'ridan; aks holda javobga javob
  profileId String
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([reviewId])
}

// Sharhga "qo'shilaman" (like) — necha kishi rozi. Avtomatik, qo'lda emas.
model MarketReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([reviewId, profileId])
}

// Bildirishnomalar (avtomatik yaratiladi)
model MarketNotification {
  id        String          @id @default(cuid())
  profileId String          // qabul qiluvchi
  type      MarketNotifType
  title     String
  body      String?
  link      String?         // bosilganda o'tadigan manzil
  image     String?
  read      Boolean         @default(false)
  createdAt DateTime        @default(now())
  @@index([profileId, read])
}

enum MarketNotifType {
  REVIEW_LIKE
  PRODUCT_REVIEW
  BRAND_REVIEW
  ORDER_DELIVERED
  ORDER_ACCEPTED
  ORDER_UPDATE
  REVIEW_REMINDER
  REPLY
  QUESTION
  ANSWER
}

// Brendga sharh + baho (faqat shu brenddan harid qilganlar)
model MarketBrandReview {
  id        String   @id @default(cuid())
  brandId   String
  brand     MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  profileId String
  rating    Int           // 1-5
  text      String?
  createdAt DateTime @default(now())
  @@unique([brandId, profileId])
}

model MarketProduct {
  id          String   @id @default(cuid())
  brandId     String
  brand       MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  slug        String   @unique
  description String?
  images      String[]          // rasm URL massiv
  videos      String[] @default([])   // video URL massiv
  price       Decimal  @db.Decimal(18, 2)   // narx (currency bo'yicha)
  oldPrice    Decimal? @db.Decimal(18, 2)   // chegirma bo'lsa eski narx
  currency    Currency @default(UZS)         // valyuta — mahsulot sotuvchisi qaysida narxlagan
  stock       Int      @default(0)
  sold        Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)

  category    String            // asosiy kategoriya slug
  subcategory String?           // kichik kategoriya slug

  variantLabel String?          // variant guruh nomi, masalan "O'lcham" yoki "Rang" (null = variantsiz)

  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems   MarketCartItem[]
  orderItems  MarketOrderItem[]
  wishlists   MarketWishlist[]
  reviews     MarketReview[]
  questions   MarketProductQuestion[]
  variants    MarketProductVariant[]
}

// Mahsulot varianti (rang/o'lcham/xotira...) — har biriga alohida narx va stock
model MarketProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        // ko'rsatiladigan nom: "Qora / XL", "256 GB"
  price     Decimal  @db.Decimal(18, 2)
  oldPrice  Decimal? @db.Decimal(18, 2)
  stock     Int      @default(0)
  image     String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  cartItems MarketCartItem[]
  @@index([productId])
}

// Mahsulotga savol (harid shart emas — sotib olishdan oldin so'raladi)
model MarketProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  answers   MarketProductAnswer[]
  @@index([productId])
}

// Savolga javob (har kim; sotuvchi javobi ajratiladi)
model MarketProductAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   MarketProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profileId  String
  text       String
  hidden     Boolean  @default(false) // moderatsiya
  createdAt  DateTime @default(now())
  @@index([questionId])
}

// Moderatsiya flagi — foydalanuvchi shikoyati + AI xulosasi (Market+Nexus yagona)
model ModerationFlag {
  id           String             @id @default(cuid())
  module       String             // "MARKET" | "NEXUS"
  targetType   String             // PRODUCT/REVIEW/REPLY/QUESTION/ANSWER/POST/COMMENT
  targetId     String
  // foydalanuvchi shikoyatlari
  reportCount  Int                @default(0)
  lastReason   String?
  // AI xulosasi
  aiVerdict    ModerationVerdict?
  aiCategories String[]           @default([])
  aiSeverity   Float?
  aiReason     String?
  // hal qilish holati
  status       ModerationStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@unique([module, targetType, targetId])
  @@index([status])
}

// Har bir foydalanuvchi-shikoyati (dedup + rate-limit uchun). Bir foydalanuvchi
// bir target'ni faqat 1 marta shikoyat qila oladi (@@unique). Takroriy/spam
// shikoyat AI'ni qayta chaqirmaydi — xarajat himoyasi ModerationFlag tomonida.
model NexusReport {
  id         String   @id @default(cuid())
  reporterId String
  module     String   // "MARKET" | "NEXUS"
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  @@unique([reporterId, module, targetType, targetId])
  @@index([reporterId, createdAt])
}

// AI chaqiruvlari jurnali — faqat rate-limit uchun (pullik Gemini suiiste'molini to'sadi).
model AiUsage {
  id        String   @id @default(cuid())
  profileId String
  kind      String?  // "chat" | "search" | "listing" | "assist"
  createdAt DateTime @default(now())
  @@index([profileId, createdAt])
}

// Tavsiya algoritmi 4-bosqich: semantik embeddinglar (pgvector + Gemini).
// Prisma vector turini bilmaydi → Unsupported; insert/qidiruv raw SQL orqali (lib/nexus-embed.ts).
model NexusPostEmbedding {
  postId    String                      @id
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
}

model NexusUserEmbedding {
  profileId  String                      @id
  embedding  Unsupported("vector(768)")?
  computedAt DateTime                    @default(now())
}

// Tavsiya algoritmi 2-bosqich: saqlanadigan qiziqish vektori (kunlik cron'da qayta hisoblanadi).
// Signallar: like/save (post muallif+teg), video ko'rish (muallif+kategoriya+teg), follow (muallif).
// Json = { kalit: og'irlik } (top-N saqlanadi). Feed reytingi shu profil bilan tartiblaydi.
model NexusInterest {
  profileId  String   @id          // bitta foydalanuvchi = bitta vektor
  authors    Json     @default("{}")  // { authorId: weight }
  tags       Json     @default("{}")  // { tag: weight }
  categories Json     @default("{}")  // { category: weight }
  recAuthors Json     @default("{}")  // 3-bosqich CF: { authorId: score } — kuzatmagan, lekin tavsiya
  computedAt DateTime @default(now())
}

enum ModerationStatus {
  PENDING      // admin ko'rishi kutilmoqda
  KEPT         // ko'rib chiqildi — saqlandi
  HIDDEN       // admin yashirdi
  AUTO_HIDDEN  // AI avtomatik yashirdi (jiddiy)
}

enum ModerationVerdict {
  OK
  REVIEW
  BLOCK
}

model MarketCartItem {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   MarketProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([profileId, productId, variantId])
}

model MarketOrder {
  id            String              @id @default(cuid())
  profileId     String
  total         Decimal             @db.Decimal(18, 2)   // chegirmadan keyingi yakuniy summa
  discount      Decimal             @default(0) @db.Decimal(18, 2)
  currency      Currency            @default(UZS)         // buyurtma valyutasi (mahsulot valyutalariga mos)
  exchangeRate  Decimal?            @db.Decimal(18, 6)    // Buyurtma vaqtidagi USD/UZS kursi (Shariat: gharar oldini oladi)
  promoCode     String?
  settledAt     DateTime?           // sotuvchilarga to'lov amalga oshirilgan vaqt (ikki marta to'lamaslik uchun)
  status        MarketOrderStatus   @default(PENDING)
  paymentMethod MarketPaymentMethod @default(WALLET)
  address       String              // manzil majburiy
  note          String?
  createdAt     DateTime            @default(now())

  items         MarketOrderItem[]
}

// Promokod / kupon (platforma darajasida — asoschilar yaratadi)
model MarketPromoCode {
  id          String          @id @default(cuid())
  code        String          @unique
  type        MarketPromoType
  value       Decimal         @db.Decimal(18, 2)   // PERCENT: 1-100, FIXED: Ƶ miqdori
  minOrder    Decimal         @default(0) @db.Decimal(18, 2)
  maxDiscount Decimal?        @db.Decimal(18, 2)   // PERCENT uchun yuqori chegara
  usageLimit  Int?            // null = cheksiz
  usedCount   Int             @default(0)
  expiresAt   DateTime?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
}

enum MarketPromoType {
  PERCENT
  FIXED
}

enum MarketPaymentMethod {
  WALLET           @map("ZIJ")  // Hamyondan to'lash (DB'da eski 'ZIJ' qiymati saqlanadi)
  CASH_ON_DELIVERY                // Yetkazishda naqd
  CARD_ON_DELIVERY                // Yetkazishda karta
}

// Valyuta (money.ts Currency tipiga mos: UZS | USD)
enum Currency {
  UZS
  USD
}

model MarketOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id])
  variantId   String?       // tanlangan variant (agar bor bo'lsa)
  variantName String?       // denormalizatsiya — variant o'chsa ham tarix saqlanadi
  quantity    Int
  price       Decimal  @db.Decimal(18, 2)   // sotib olingan paytdagi narx
}

enum MarketOrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

// ── Nexus — ijtimoiy tarmoq (postlar, feed, like, izoh, follow) ──────────────
model NexusPost {
  id              String   @id @default(cuid())
  profileId       String                          // muallif (UserProfile.id)
  text            String?
  media           String[] @default([])           // rasm/video URL'lar
  hashtags        String[] @default([])
  marketProductId String?                         // ixtiyoriy — postga biriktirilgan Market mahsuloti ("Sotib olish")
  bnProductId     String?                         // ixtiyoriy — BN mahsuloti (shoppable, BN Media integratsiya)
  privacy         NexusPostPrivacy @default(PUBLIC)  // PUBLIC / FOLLOWERS (obunachilar) / PRIVATE (faqat men)
  location        String?                         // ixtiyoriy joylashuv matni
  pollOptions     String[] @default([])           // bo'sh = so'rovnoma yo'q (2-4 variant)
  pollEndsAt      DateTime?                       // so'rovnoma tugash vaqti
  shareCount      Int      @default(0)
  hidden          Boolean  @default(false) // moderatsiya
  editedAt        DateTime?                // tahrirlangan bo'lsa
  createdAt       DateTime @default(now())

  likes     NexusLike[]
  comments  NexusComment[]
  saves     NexusSave[]
  pollVotes NexusPollVote[]

  @@index([profileId])
  @@index([createdAt])
  @@index([bnProductId])
}

enum NexusPostPrivacy {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS   // faqat pullik obunachilar
  PRIVATE
}

// So'rovnoma ovozi — bir post uchun bir ovoz (o'zgartirish mumkin, muddati tugaguncha)
model NexusPollVote {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  optionIdx Int
  createdAt DateTime  @default(now())
  @@unique([postId, profileId])
  @@index([postId])
}

model NexusLike {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
  @@index([profileId, createdAt])   // qiziqish profili (rec-algoritm) uchun
}

model NexusSave {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
}

model NexusComment {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?                               // cheksiz ichma-ich javob uchun
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([postId])
}

model NexusFollow {
  id          String   @id @default(cuid())
  followerId  String                              // kim follow qilyapti
  followingId String                              // kimni
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

// Bloklash — ikki tomonlama ko'rinmaslik. A B'ni bloklasa: B A'ning kontentini
// ko'rmaydi, DM yoza olmaydi, follow qila olmaydi (va aksincha). Mavjud follow'lar uziladi.
model NexusBlock {
  id        String   @id @default(cuid())
  blockerId String                                // kim bloklayapti (UserProfile.id)
  blockedId String                                // kimni
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Ovozsizlantirish — yumshoq, bir tomonlama. A B'ni mute qilsa: A B'ning kontentini
// tasmada ko'rmaydi, lekin B bilmaydi va bemalol o'zaro aloqa qila oladi.
model NexusMute {
  id        String   @id @default(cuid())
  muterId   String                                // kim mute qilyapti (UserProfile.id)
  mutedId   String                                // kimni
  createdAt DateTime @default(now())
  @@unique([muterId, mutedId])
  @@index([muterId])
}

// Bildirishnoma — like/izoh/follow/javob (relation yo'q, MarketNotification kabi)
model NexusNotification {
  id          String         @id @default(cuid())
  recipientId String                              // kim oladi (UserProfile.id)
  actorId     String                              // kim qildi
  type        NexusNotifType
  postId      String?
  commentId   String?
  videoId     String?                             // video like/izoh/xarid uchun
  trackId     String?                             // trek like uchun
  liveId      String?                             // jonli efir uchun
  callId      String?                             // qo'ng'iroq (MISSED/ENDED) uchun
  amount      Int?           @map("amountZij")    // tip/xarid miqdori (foydalanuvchi valyutasida)
  read        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

enum NexusNotifType {
  LIKE
  COMMENT
  FOLLOW
  REPLY
  VIDEO_LIKE
  VIDEO_COMMENT
  TRACK_LIKE
  PURCHASE
  LIVE
  TIP
  MENTION
  SUB_EXPIRING
  CALL_MISSED
  MOD_WARN         // AI moderatsiya yumshoq ogohlantirish (yaqin do'st + o'rta severity)
}

// Story — 24 soatlik vaqtinchalik kontent (multi-slide)
// Foydalanuvchi so'rovi: "Storis qo'yish funksiyamiz juda sodda uni
// to'g'rilashimiz kerak" — Instagram sifati: matn overlay, sticker,
// drawing, filter, musiqa, multi-slide, javob (DM), highlights, reaksiya.
model NexusStory {
  id          String              @id @default(cuid())
  profileId   String
  // Backward compat: birinchi slide (eski single-slide fallback)
  mediaUrl    String
  mediaType   NexusStoryMediaType @default(IMAGE)
  caption     String?
  // Musiqa (ixtiyoriy) — barcha slidelar uchun umumiy fon
  musicTrackId String?                            // NexusTrack.id
  musicTitle   String?                            // qisqa yorliq (offline uchun)
  musicUrl     String?                            // to'g'ridan-to'g'ri audio URL
  createdAt   DateTime            @default(now())
  expiresAt   DateTime                            // = createdAt + 24 soat
  views       NexusStoryView[]
  slides      NexusStorySlide[]
  reactions   NexusStoryReaction[]
  @@index([profileId, expiresAt])
  @@index([expiresAt])
}

enum NexusStoryMediaType {
  IMAGE
  VIDEO
  TEXT              // faqat matn (fon rangi + katta shrift)
}

// Bir story ichida bir necha slide (2-10 ta). Backward compat: agar slide
// yo'q bo'lsa NexusStory ning o'zi bitta slide sifatida ko'riladi.
model NexusStorySlide {
  id         String              @id @default(cuid())
  storyId    String
  story      NexusStory          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order      Int                                     // 0-based tartib
  mediaUrl   String                                  // rasm/video URL yoki bo'sh (TEXT uchun)
  mediaType  NexusStoryMediaType @default(IMAGE)
  durationMs Int?                                    // video davomiyligi (video uchun); IMAGE uchun 5s default
  caption    String?
  // Overlays JSON — matn, sticker, drawing pixels.
  // Klient tomonida canvas'ga chiziladi. Namuna:
  //   { texts: [{x,y,text,font,size,color,bg}], stickers: [{x,y,kind,value}], drawing: {strokes:[...]} }
  overlays   Json?
  // Filter — "none", "grayscale", "sepia", "warm", "cool", "vintage", ...
  filter     String              @default("none")
  // Fon rangi (TEXT slide uchun)
  bgColor    String?
  createdAt  DateTime            @default(now())
  @@unique([storyId, order])
  @@index([storyId, order])
}

// Story ko'rilganligi — halqa (seen) + ko'rganlar soni uchun
model NexusStoryView {
  id        String     @id @default(cuid())
  storyId   String
  story     NexusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profileId String                                // kim ko'rdi
  slideId   String?                               // qaysi slide (ixtiyoriy)
  createdAt DateTime   @default(now())
  @@unique([storyId, profileId])
  @@index([storyId])
}

// Story'ga emoji reaksiya (Instagram uslubi — heart, laugh, wow, ...)
model NexusStoryReaction {
  id        String     @id @default(cuid())
  storyId   String
  story     NexusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profileId String
  slideId   String?                               // qaysi slide
  emoji     String                                 // "❤️" | "😂" | "😮" | "🔥" | "👏" | "😢"
  createdAt DateTime   @default(now())
  @@index([storyId, createdAt])
  @@index([profileId])
}

// Story highlight — profilda saqlanadigan story kolleksiyalari
// (24 soatdan keyin ham ko'rinadi, profil ostida yoritiladi)
model NexusStoryHighlight {
  id          String   @id @default(cuid())
  profileId   String
  title       String                              // "Sayohat", "Ishlar", ...
  coverUrl    String?
  storyIds    String[] @default([])               // NexusStory.id lar (24s'dan keyin ham qoladi)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([profileId, order])
}

// Shaxsiy yozishma (1:1) — user1Id < user2Id normalizatsiya
model NexusConversation {
  id              String    @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessageAt   DateTime  @default(now())
  lastMessageText String?
  lastSenderId    String?
  user1ReadAt     DateTime?
  user2ReadAt     DateTime?
  createdAt       DateTime  @default(now())
  messages        NexusMessage[]
  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
}

model NexusMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String                                    // media bo'lsa caption yoki bo'sh
  // Ixtiyoriy media qo'shimchasi (rasm/video/audio/fayl/video-circle/location/poll)
  mediaUrl       String?
  mediaType      String?                                   // "image" | "video" | "audio" | "file" | "video-circle" | "location" | "poll"
  mediaMime      String?                                   // "image/jpeg", "video/mp4", "audio/webm", ...
  mediaName      String?                                   // fayl ko'rsatiladigan nomi
  mediaSize      Int?                                      // baytlar (fayl/audio/video hajmi)
  durationMs     Int?                                      // audio/video davomiyligi (ms)
  // Joylashuv (mediaType="location" bo'lganda)
  locLat         Float?
  locLng         Float?
  locUpdatedAt   DateTime?                                 // oxirgi yangilangan vaqti (jonli uchun)
  locExpiresAt   DateTime?                                 // NULL = statik; sana bo'lsa jonli, shundan keyin to'xtaydi
  // So'rovnoma (mediaType="poll" bo'lganda)
  pollQuestion   String?                                   // savol matni
  pollOptions    String[]          @default([])            // 2-10 variant
  pollExpiresAt  DateTime?                                 // NULL = cheklovsiz
  pollMulti      Boolean           @default(false)         // bir necha variant tanlash mumkinmi
  pollVotes      NexusDmPollVote[]
  // Pul o'tkazma (mediaType="transfer"): sender→recipient darhol (immediate)
  transferAmount    Decimal?  @db.Decimal(18, 2)
  transferCurrency  String?                                    // "UZS" | "USD"
  transferRef       String?                                    // WalletTransaction ref (xfer:UUID)
  transferNote      String?                                    // izoh (<= 120)
  createdAt      DateTime          @default(now())
  @@index([conversationId, createdAt])
}

model NexusDmPollVote {
  id           String        @id @default(cuid())
  messageId    String
  message      NexusMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId    String
  optionIndex  Int                                         // 0-based; multi bo'lsa har variant uchun alohida yozuv
  createdAt    DateTime      @default(now())
  @@unique([messageId, profileId, optionIndex])
  @@index([messageId])
}

// ── Nexus Calls (1:1 WebRTC ovoz/video) ──────────────────────────────────────
model NexusCall {
  id          String           @id @default(cuid())
  callerId    String                                    // UserProfile.id — chaqiruvchi
  calleeId    String                                    // UserProfile.id — qabul qiluvchi
  kind        NexusCallKind    @default(AUDIO)
  status      NexusCallStatus  @default(RINGING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  endedAt     DateTime?
  duration    Int              @default(0)             // sekundlarda (acceptedAt→endedAt)
  signals     NexusCallSignal[]
  recordings  NexusCallRecording[]
  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([calleeId, status])                          // incoming poller uchun
}

model NexusCallRecording {
  id          String    @id @default(cuid())
  callId      String
  call        NexusCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  startedById String                                   // UserProfile.id — yozuvni boshlagan
  audioUrl    String                                   // Vercel Blob URL
  durationSec Int                                       // sekundlar
  sizeKb      Int                                       // kilobayt
  createdAt   DateTime  @default(now())
  @@index([callId, createdAt])
  @@index([startedById, createdAt])
}

// ── Guruh chaqiruvi (LiveKit SFU) ────────────────────────────────────────────
model NexusGroupCall {
  id           String                       @id @default(cuid())
  roomName     String                       @unique  // LiveKit room name (chaqiruv id + prefix)
  title        String?                                // ixtiyoriy nom
  hostId       String                                 // UserProfile.id — yaratuvchi
  status       NexusGroupCallStatus         @default(ACTIVE)
  createdAt    DateTime                     @default(now())
  endedAt      DateTime?
  participants NexusGroupCallParticipant[]
  recordings   NexusGroupCallRecording[]
  @@index([hostId, createdAt])
  @@index([status, createdAt])
}

model NexusGroupCallRecording {
  id            String         @id @default(cuid())
  groupCallId   String
  groupCall     NexusGroupCall @relation(fields: [groupCallId], references: [id], onDelete: Cascade)
  startedById   String                                   // UserProfile.id
  audioUrl      String                                   // Vercel Blob
  durationSec   Int
  sizeKb        Int
  createdAt     DateTime       @default(now())
  @@index([groupCallId, createdAt])
  @@index([startedById, createdAt])
}

model NexusGroupCallParticipant {
  id          String         @id @default(cuid())
  groupCallId String
  groupCall   NexusGroupCall @relation(fields: [groupCallId], references: [id], onDelete: Cascade)
  profileId   String                                     // UserProfile.id
  role        NexusGroupCallRole @default(GUEST)
  joinedAt    DateTime       @default(now())
  leftAt      DateTime?
  @@unique([groupCallId, profileId])
  @@index([profileId, joinedAt])
}

enum NexusGroupCallStatus {
  ACTIVE
  ENDED
}

enum NexusGroupCallRole {
  HOST
  GUEST
}

model NexusCallSignal {
  id        String    @id @default(cuid())
  callId    String
  call      NexusCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  fromId    String                                     // UserProfile.id — yuboruvchi peer
  kind      String                                     // "offer" | "answer" | "ice"
  payload   String    @db.Text                         // JSON: SDP yoki ICE candidate
  createdAt DateTime  @default(now())
  @@index([callId, createdAt])
}

enum NexusCallKind {
  AUDIO
  VIDEO
}

enum NexusCallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

// ── Nexus Video — to'liq video (LONG) va Shorts (SHORT) ──────────────────────
model NexusVideo {
  id          String         @id @default(cuid())
  profileId   String                                // kanal / yuklovchi
  title       String
  description String?                               // cheksiz uzunlik
  videoUrl    String                                // Vercel Blob MP4 URL
  thumbUrl    String?                               // muqova (custom yoki client thumbnail)
  durationSec Int            @default(0)
  kind        NexusVideoKind @default(LONG)
  orientation NexusVideoOrientation @default(HORIZONTAL)  // G.Video (gorizontal) / V.Video (vertikal)
  width       Int?                                  // video o'lchami — orientation aniqlash
  height      Int?
  category    String?                               // kino / musiqa / gaming ...
  tags        String[]                              // foydalanuvchi #teglari (cheksiz)
  descImages  String[]                              // tavsifdagi dalil rasmlari
  isMature    Boolean        @default(false)        // 18+ — voyaga yetmaganlardan yashiriladi
  price       Int            @default(0) @map("priceZij")  // 0 = bepul, >0 = pullik (priceCurrency valyutasida)
  priceCurrency Currency     @default(UZS)
  prevVideoId String?                               // series — avvalgi qism (joylangan bo'lishi shart)
  prevVideo   NexusVideo?    @relation("VideoSeries", fields: [prevVideoId], references: [id], onDelete: SetNull)
  nextParts   NexusVideo[]   @relation("VideoSeries")
  views       Int            @default(0)
  hidden      Boolean        @default(false)         // moderatsiya
  createdAt   DateTime       @default(now())
  likes       NexusVideoLike[]
  comments    NexusVideoComment[]
  purchases   NexusVideoPurchase[]
  @@index([kind, createdAt])
  @@index([orientation, createdAt])
  @@index([profileId, createdAt])
}

enum NexusVideoKind {
  LONG
  SHORT
}

enum NexusVideoOrientation {
  HORIZONTAL    // G.Video
  VERTICAL      // V.Video (reels)
}

model NexusVideoView {
  id        String   @id @default(cuid())
  videoId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([videoId, profileId])
  @@index([videoId])
}

model NexusVideoLike {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime   @default(now())
  @@unique([videoId, profileId])
}

model NexusVideoComment {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean    @default(false)   // moderatsiya
  createdAt DateTime   @default(now())
  @@index([videoId, createdAt])
}

// ── Nexus Live — jonli efirlar ───────────────────────────────────────────────
// Faza 1: lifecycle + chat + ko'ruvchi heartbeat. Video transport keyingi faza.
model NexusLiveStream {
  id          String           @id @default(cuid())
  profileId   String                                  // streamer
  title       String
  category    String?
  privacy     NexusLivePrivacy @default(PUBLIC)
  status      NexusLiveStatus  @default(LIVE)
  scheduledAt DateTime?                               // UPCOMING uchun
  startedAt   DateTime?
  endedAt     DateTime?
  peakViewers Int              @default(0)
  likes       Int              @default(0)
  hidden      Boolean          @default(false)      // moderatsiya — yashirilgan efir
  createdAt   DateTime         @default(now())
  messages    NexusLiveMessage[]
  @@index([status, createdAt])
  @@index([profileId, createdAt])
}

enum NexusLiveStatus {
  UPCOMING
  LIVE
  ENDED
}

enum NexusLivePrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}

model NexusLiveMessage {
  id        String          @id @default(cuid())
  streamId  String
  stream    NexusLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  tipAmount Int             @default(0) @map("tipZij")  // > 0 bo'lsa — Super Chat (pulli, ajratilgan)
  hidden    Boolean         @default(false)        // moderatsiya
  createdAt DateTime        @default(now())
  @@index([streamId, createdAt])
}

// Tip / donat — ijodkorni qo'llab-quvvatlash. Zij donor→ijodkor o'tadi (komissiyasiz).
model NexusTip {
  id          String      @id @default(cuid())
  donorId     String                              // kim yubordi (UserProfile.id)
  recipientId String                              // ijodkor
  amount      Int            @map("amountZij")    // miqdor (currency valyutasida)
  currency    Currency       @default(UZS)
  targetType  NexusTipTarget @default(PROFILE)    // nimaga: profil/post/video/jonli
  targetId    String?                             // tegishli kontent id (PROFILE uchun null)
  message     String?                             // ixtiyoriy izoh (Super Chat matni)
  createdAt   DateTime    @default(now())
  @@index([recipientId, createdAt])
  @@index([donorId, createdAt])
}

enum NexusTipTarget {
  PROFILE
  POST
  VIDEO
  LIVE
}

// ── Kanallar va Guruhlar ─────────────────────────────────────────────────────
// CHANNEL — bir tomonlama e'lon (faqat admin yozadi, a'zolar o'qiydi).
// GROUP   — ko'p a'zoli suhbat (a'zolar yozadi).
model NexusChannel {
  id          String   @id @default(cuid())
  ownerId     String                              // yaratuvchi (UserProfile.id)
  type        NexusChannelType @default(CHANNEL)
  name        String
  handle      String?  @unique                    // @handle (ixtiyoriy, ommaviy uchun)
  description String?
  avatarUrl   String?
  isPrivate   Boolean  @default(false)            // private = faqat taklif/havola bilan
  memberCount Int      @default(1)
  hidden      Boolean  @default(false)            // moderatsiya
  createdAt   DateTime @default(now())
  members     NexusChannelMember[]
  messages    NexusChannelMessage[]
  @@index([type, isPrivate, createdAt])
}

enum NexusChannelType {
  CHANNEL
  GROUP
}

model NexusChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  profileId String
  role      NexusChannelRole @default(MEMBER)
  lastReadAt DateTime?
  joinedAt  DateTime @default(now())
  @@unique([channelId, profileId])
  @@index([profileId])
}

enum NexusChannelRole {
  OWNER
  ADMIN
  MEMBER
}

model NexusChannelMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false)
  // So'rovnoma (Telegram uslubi) — foydalanuvchi so'rovi bo'yicha
  pollQuestion  String?
  pollOptions   String[]  @default([])
  pollExpiresAt DateTime?
  pollMulti     Boolean   @default(false)
  pollVotes     NexusChannelPollVote[]
  createdAt DateTime @default(now())
  @@index([channelId, createdAt])
}

model NexusChannelPollVote {
  id          String              @id @default(cuid())
  messageId   String
  message     NexusChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId   String
  optionIndex Int
  createdAt   DateTime            @default(now())
  @@unique([messageId, profileId, optionIndex])
  @@index([messageId])
}

// Web Push obunasi — brauzer push bildirishnomalari uchun (VAPID).
model NexusPushSub {
  id        String   @id @default(cuid())
  profileId String                              // egasi (UserProfile.id)
  endpoint  String   @unique                    // push service endpoint
  p256dh    String                              // kalit
  auth      String                              // kalit
  createdAt DateTime @default(now())
  @@index([profileId])
}

// Humo ID SSO — "Humo ID bilan kirish". Foydalanuvchi rozilik bergach qisqa muddatli
// kod yaratiladi; hamkor uni server-aro (HMAC) profilga almashtiradi (OAuth code-flow uslubi).
model HumoSsoCode {
  id          String   @id @default(cuid())
  code        String   @unique               // tasodifiy kod (token exchange uchun)
  profileId   String                          // rozilik bergan foydalanuvchi (UserProfile.id)
  clientId    String                          // hamkor ilova id
  redirectUri String                          // tasdiqlangan redirect
  scope       String                          // bo'sh bilan ajratilgan: profile email nexus
  expiresAt   DateTime                        // 5 daqiqa
  usedAt      DateTime?                       // bir martalik
  createdAt   DateTime @default(now())
  @@index([profileId, createdAt])
}

// Verifikatsiya arizasi — ijodkor ko'k belgi so'raydi; founder ko'rib chiqadi.
model NexusVerifyRequest {
  id          String   @id @default(cuid())
  profileId   String   @unique                  // ariza beruvchi (UserProfile.id)
  fullName    String                             // haqiqiy ism
  category    String                             // kim: bloger/musiqachi/brend/jurnalist...
  reason      String                             // nega tasdiqlanishi kerak
  links       String[] @default([])              // ijtimoiy tarmoq/manba havolalari
  status      NexusVerifyStatus @default(PENDING)
  reviewedBy  String?                            // founder profileId
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([status, createdAt])
}

enum NexusVerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pullik obuna — obunachi ijodkorga oylik Zij to'laydi, expiresAt gacha SUBSCRIBERS kontent ochiq.
// Avto-uzaytirish yo'q (karta yo'q): obuna = 30 kunlik oldindan to'lov, qo'lda yangilanadi.
model NexusSubscription {
  id           String   @id @default(cuid())
  subscriberId String                              // obunachi (UserProfile.id)
  creatorId    String                              // ijodkor
  price        Int            @map("priceZij")    // to'langan oylik narx (obuna paytida qotiriladi)
  currency     Currency       @default(UZS)
  startedAt    DateTime @default(now())
  expiresAt    DateTime                            // shu vaqtgacha faol
  expiryNotifiedAt DateTime?                       // tugashga yaqin bildirishnoma yuborilgan vaqt
  createdAt    DateTime @default(now())
  @@unique([subscriberId, creatorId])
  @@index([expiresAt])
  @@index([subscriberId, expiresAt])
  @@index([creatorId, expiresAt])
}

// Jonli ko'ruvchi — heartbeat (lastSeenAt > now-30s = onlayn)
model NexusLiveViewer {
  id         String   @id @default(cuid())
  streamId   String
  profileId  String
  lastSeenAt DateTime @default(now())
  @@unique([streamId, profileId])
  @@index([streamId, lastSeenAt])
}

// Pullik video xaridi — Zij avtorning hamyoniga tushadi
model NexusVideoPurchase {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  buyerId   String                                  // UserProfile id
  price     Int            @map("priceZij")        // to'langan summa
  createdAt DateTime   @default(now())
  @@unique([videoId, buyerId])
  @@index([buyerId, createdAt])
}

// "Keyinroq ko'rish" ro'yxati
model NexusWatchLater {
  id        String   @id @default(cuid())
  profileId String
  videoId   String
  createdAt DateTime @default(now())
  @@unique([profileId, videoId])
  @@index([profileId, createdAt])
}

// ── Nexus Media — audio treklar (musiqa / podkast / audiokitob) ──────────────
model NexusTrack {
  id          String         @id @default(cuid())
  profileId   String                              // yuklovchi
  title       String
  artist      String?                             // ijrochi/muallif ko'rinadigan nomi
  audioUrl    String                              // Vercel Blob audio
  coverUrl    String?                             // muqova rasmi
  durationSec Int            @default(0)
  kind        NexusTrackKind @default(MUSIC)
  genre       String?
  plays       Int            @default(0)
  hidden      Boolean        @default(false)      // moderatsiya
  createdAt   DateTime       @default(now())
  likes       NexusTrackLike[]
  @@index([kind, createdAt])
  @@index([kind, plays])
  @@index([profileId, createdAt])
}

enum NexusTrackKind {
  MUSIC
  PODCAST
  AUDIOBOOK
}

// Tinglash — foydalanuvchi bo'yicha bir marta hisoblanadi
model NexusTrackPlay {
  id        String   @id @default(cuid())
  trackId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([trackId, profileId])
  @@index([trackId])
}

model NexusTrackLike {
  id        String     @id @default(cuid())
  trackId   String
  track     NexusTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime   @default(now())
  @@unique([trackId, profileId])
  @@index([profileId, createdAt])
}

// ── ALKH Pay — real pul hamyoni (UZS / USD) ──────────────────────────────────
//
// Endi real valyuta: O'zbekiston foydalanuvchilari so'm (UZS), xorijliklar dollar (USD).
// ("Zij" tushunchasi olib tashlandi — model nomlari ichki, foydalanuvchiga ko'rinmaydi.)
// Hozir TEST rejimda: deposit darhol tushadi, withdraw payout-so'rov yaratadi.
// MChJ + to'lov shlyuzi (Click/Payme/karta) kalitlari kelganda real ishlaydi (lib/payments).

model Wallet {
  id          String   @id @default(cuid())
  profileId   String   @unique
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hamyon valyutasidagi miqdor
  currency    String   @default("UZS")                 // UZS yoki USD (foydalanuvchi davlatidan)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]
  safes        WalletSafe[]
  payouts      PayoutRequest[]

  @@map("ZijWallet")
}

model WalletTransaction {
  id          String             @id @default(cuid())
  walletId    String
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type        TransactionType
  amount      Decimal            @db.Decimal(18, 2)   // musbat son (shu tranzaksiya valyutasida)
  currency    String             @default("UZS")      // tranzaksiya valyutasi
  balanceAfter Decimal           @db.Decimal(18, 2)   // tranzaksiyadan keyin balans

  description String?
  ref         String?            // tashqi ref (order ID, payout ID, provider txn)

  createdAt   DateTime @default(now())

  // Idempotentlik: bir hamyonda bir ref bo'yicha ikkinchi marta yozib bo'lmaydi.
  // NULL ref'lar cheklovga tushmaydi (Postgres NULL != NULL).
  @@unique([walletId, ref])
  @@map("ZijTransaction")
}

enum TransactionType {
  DEPOSIT    // pul kirish (to'lov shlyuzi orqali)
  WITHDRAW   // pul chiqish (payout)
  PURCHASE   // xarid
  REFUND     // qaytarish
  SALE       // sotuvchi daromadi (komissiya ayirilgan)
  REWARD     // mukofot / cashback
  TRANSFER_OUT  // yuborish (tip/obuna/do'stga)
  TRANSFER_IN   // qabul qilish
  SAFE_IN       // seyfga o'tkazish
  SAFE_OUT      // seyfdan chiqarish

  @@map("ZijTransactionType")
}

// Pul yechish so'rovi (payout). Test rejimda darhol "tugatilgan"; real rejimda
// to'lov shlyuzi orqali kartaga/hisobga o'tkaziladi.
model PayoutRequest {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(18, 2)
  currency    String
  method      String                              // "card" | "bank" | ...
  destination String                              // karta raqami (maskalangan) / hisob
  status      PayoutStatus @default(PENDING)
  providerRef String?                             // shlyuz tranzaksiya id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([walletId, createdAt])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Virtual seyf — maqsadli jamg'arma
model WalletSafe {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  name        String              // "Parij sayohati", "Yangi telefon" va h.k.
  emoji       String   @default("🏦")
  targetAmount Decimal @db.Decimal(18, 2)   // maqsad summa
  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hozirgi balans
  isCompleted Boolean  @default(false)      // to'lgan yoki yo'q

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ZijSafe")
}

// ─────────────────────────────────────────────────────────────
// Yutuqlar (Achievement) — cross-modul (eSport + Nexus + Market + Pay)
// UserProfile.id + code bo'yicha unique — bir yutuq bir marta beriladi.
// ─────────────────────────────────────────────────────────────
model UserAchievement {
  id         String   @id @default(cuid())
  profileId  String
  code       String            // "esport.first_win", "nexus.100_followers", "market.first_sale" ...
  title      String            // ko'rsatiladigan sarlavha (til foydalanuvchi tilida bo'lishi mumkin)
  icon       String   @default("Trophy")  // Lucide icon nomi (masalan "Trophy", "Star")
  category   String            // "esport" | "nexus" | "market" | "pay" | "id"
  tier       String   @default("bronze")  // "bronze" | "silver" | "gold" | "platinum"
  meta       Json?             // qo'shimcha ma'lumot (masalan: { count: 100, tournamentId: "..." })
  earnedAt   DateTime @default(now())

  @@unique([profileId, code])
  @@index([profileId, category])
  @@index([category, earnedAt])
}

// ─────────────────────────────────────────────────────────────
// KYC (Know Your Customer) — Level 2
// Katta summalar (>10M UZS / >1000 USD) chiqarish uchun majburiy.
// Hozircha qo'lda tekshiruv (passport rasm); kelajakda avto-face API.
// ─────────────────────────────────────────────────────────────
enum KycStatus {
  PENDING     // yuborilgan, admin tekshirmoqda
  APPROVED    // tasdiqlangan → UserProfile.level = 2
  REJECTED    // rad etilgan (sabab bilan)
}

// UserBan — AI moderation tomonidan berilgan vaqtincha yoki abadiy bloklash.
// Progressiv jazo: har yangi bloklash oldingisidan uzunroq (1h → 3h → ... → forever).
// Foydalanuvchi ariza berishi mumkin (appealText); founder ko'rib chiqadi.
model UserBan {
  id           String       @id @default(cuid())
  profileId    String
  profile      UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  level        Int                                  // 0..13 (BAN_LADDER indeksi); 13 = forever
  reason       String                               // "hate_speech", "threat", "csam", "spam", "explicit", "other"
  category     String       @default("soft")        // "hard" = darhol forever (CSAM/terrorizm), "soft" = ladder bo'yicha
  contextSnippet String?                            // qisqa parcha (moderator ko'rishi uchun; ariza bo'lganda)
  aiVerdict    String?                              // "BLOCK" | "REVIEW"
  aiSeverity   Float?                               // 0-1
  aiRelationScore Int?                              // 0-100 (yaqin do'st balli)
  issuedAt     DateTime     @default(now())
  expiresAt    DateTime?                            // NULL = abadiy
  appealAt     DateTime?
  appealText   String?                              // foydalanuvchi ariza matni
  reviewedById String?                              // founder ko'rgan bo'lsa
  reviewedAt   DateTime?
  lifted       Boolean      @default(false)         // ariza tasdiqlangan bo'lsa qaytariladi
  liftReason   String?

  @@index([profileId, expiresAt])
  @@index([expiresAt])
  @@index([appealAt, reviewedAt])
}

model UserKyc {
  id           String    @id @default(cuid())
  profileId    String    @unique   // bitta foydalanuvchida bitta faol ariza
  passportUrl  String              // Vercel Blob URL — passport 1-bet skan
  selfieUrl    String?             // ixtiyoriy — passport bilan selfi (autentiklik)
  status       KycStatus @default(PENDING)
  rejectReason String?             // REJECTED bo'lsa sabab
  reviewedById String?             // admin UserProfile.id (kim ko'rdi)
  reviewedAt   DateTime?
  submittedAt  DateTime  @default(now())

  @@index([status, submittedAt])
}
// ─────────────────────────────────────────────────────────────────────────────
// BOZOR NARXIDA (BN) — For Humo loyihalaridan biri. bozornarxida.uz
// Reja: docs/BN-PLAN.md (yagona manba — o'zgarish avval o'sha faylda)
//
// ASOSIY G'OYA: Bozor = JOY, Do'kon = BIZNES.
//   BnMarket (bozor)  — jismoniy bozor (Sergeli avto, Chorsu, Malika...)
//     └── BnShop      — sotuvchining do'koni (marketId null = alohida/onlayn)
//           └── BnProduct
// Bozor hech narsa sotmaydi — u konteyner. 1 profil = 1 do'kon.
//
// UNIVERSAL KATEGORIYA: BnCategory.attributeSchema (JSON) har toifa qanday
// maydonlar kerakligini aytadi; BnProduct.attributes qiymatlarni saqlaydi.
// Shu tufayli avto/telefon/kiyim bir xil kod bilan ishlaydi.
//
// Boshqaruv: Jalol = BnAdmin OWNER (BN ichida hamma narsa).
//            Founder (Abduvoris) = tizim/kod/integratsiya.
// Komissiya: 5% (BN_COMMISSION env), naqddan olinmaydi.
// ─────────────────────────────────────────────────────────────────────────────

// ── Bozor (JOY) ──────────────────────────────────────────────────────────────
model BnMarket {
  id          String   @id @default(cuid())
  slug        String   @unique                    // "sergeli-avto-bozor"
  name        String                              // "Sergeli avtomobil bozori"
  nameRu      String?
  description String?
  city        String   @default("Toshkent")
  district    String?                             // "Sergeli tumani"
  address     String?
  lat         Float?                              // xarita
  lng         Float?
  coverUrl    String?
  logoUrl     String?
  workHours   String?                             // "Dush-Yak 08:00-18:00"
  phone       String?
  sections    String[] @default([])               // ["12-qator", "Elektronika rastasi"]
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  shopCount   Int      @default(0)                // kesh
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shops       BnShop[]

  @@index([city, isActive, order])
}

// ── Do'kon (BIZNES) ──────────────────────────────────────────────────────────
model BnShop {
  id            String         @id @default(cuid())
  profileId     String                             // UserProfile.id — bir odam ko'p do'kon ochishi mumkin (turli bozorlarda + ko'chada filiallar)
  slug          String         @unique
  // Filial uchun ota-do'kon (STANDALONE): ko'cha do'konlari bir nechta filial ochishi mumkin
  parentShopId  String?
  parent        BnShop?        @relation("ShopBranches", fields: [parentShopId], references: [id], onDelete: SetNull)
  branches      BnShop[]       @relation("ShopBranches")
  name          String
  description   String?
  logoUrl       String?
  coverUrl      String?

  // Yuridik ma'lumot (MAJBURIY — YaTT yoki MChJ)
  legalType     BnLegalType
  innNumber     String         @unique             // STIR/INN
  legalName     String                             // F.I.SH yoki MChJ to'liq nomi
  phone         String
  phoneVerified Boolean        @default(false)

  // Joylashuv
  locationType  BnLocationType
  marketId      String?
  market        BnMarket?      @relation(fields: [marketId], references: [id], onDelete: SetNull)
  marketSection String?                            // "12-qator"
  marketShopNo  String?                            // "45"
  address       String?                            // STANDALONE uchun
  city          String         @default("Toshkent")
  lat           Float?
  lng           Float?

  // Bank (payout)
  bankName      String?
  bankAccount   String?
  bankMfo       String?

  // Holat va reyting
  status        BnShopStatus   @default(PENDING)
  tier          BnShopTier     @default(NEW)
  rating        Float          @default(0)
  ratingCount   Int            @default(0)
  orderCount    Int            @default(0)
  productCount  Int            @default(0)

  // Tasdiqlanganlik (galochka) — kunlik cron hisoblaydi.
  // NONE = yo'q; RETAIL = chakana sotuvchi galochkasi; WHOLESALE = ulgurji galochka.
  // Kriteriyalar: 50/100 muvaffaqiyatli buyurtma, reyting 4.7/4.8+, rad etilgan 3/2%dan kam,
  // 90/180 kun faol, ogohlantirish/ban yo'q. Sotib olib bo'lmaydi.
  verifiedTier    BnVerifiedTier  @default(NONE)
  verifiedAt      DateTime?
  verifiedProgress Json           @default("{}")   // motivatsiya paneli uchun kesh
  approvedAt    DateTime?
  approvedById  String?
  rejectReason  String?
  suspendedAt   DateTime?
  suspendReason String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  products      BnProduct[]
  orders        BnOrder[]
  reviews       BnShopReview[]

  @@index([status, createdAt])
  @@index([marketId, status])
  @@index([city, status])
  @@index([profileId])
  @@index([parentShopId])
  // Bir profil bitta bozorda bitta do'kon ocha oladi (marketId null bo'lsa — ko'chada — ko'p filial ruxsat, Postgres NULLni unique dan istisno qiladi)
  @@unique([profileId, marketId])
}

enum BnLegalType {
  YATT
  MCHJ
}
enum BnLocationType {
  IN_MARKET
  STANDALONE
  ONLINE
}
enum BnShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED         // Vaqtincha muzlatilgan (ban vaqtida)
  TERMINATED        // Chiqarib yuborilgan — qayta ochib bo'lmaydi
}

// ── Ban tizim ───────────────────────────────────────────────────────────────
// Ban = profil (yoki uning do'koni) muzlatiladi. Elonlar ko'rinmaydi, foydalanuvchi
// balansidan pul yechishi mumkin. Vaqtincha (expiresAt) yoki abadiy bo'ladi.
// AI, OWNER yoki MODERATOR ban bera oladi. Faqat OWNER/MODERATOR ban olib tashlay oladi.
model BnBan {
  id           String        @id @default(cuid())
  profileId    String                                     // Kim banlangan
  shopId       String?                                    // Aynan do'kon banlansa
  scope        BnBanScope    @default(SHOP)               // PROFILE (butun BN'dan) yoki SHOP (bir do'kon)
  type         BnBanType                                  // TEMP vaqtincha, PERM abadiy
  reason       String                                     // Ichki sabab (foydalanuvchiga ko'rinmaydi to'liq)
  publicReason String?                                    // Foydalanuvchiga qisqa xabar (ixtiyoriy)
  expiresAt    DateTime?                                  // TEMP uchun
  decidedBy    BnBanDecidedBy                             // AI | OWNER | MODERATOR
  decidedById  String?                                    // OWNER/MODERATOR bo'lsa profil id
  status       BnBanStatus   @default(ACTIVE)
  liftedAt     DateTime?
  liftedById   String?
  liftReason   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([profileId, status])
  @@index([shopId, status])
  @@index([status, expiresAt])
}

enum BnBanScope {
  PROFILE
  SHOP
}
enum BnBanType {
  TEMP
  PERM
}
enum BnBanStatus {
  ACTIVE
  LIFTED
  EXPIRED
}
enum BnBanDecidedBy {
  AI
  OWNER
  MODERATOR
}

// ── Chiqarib yuborish so'rovi ────────────────────────────────────────────────
// MODERATOR yuboradi, OWNER tasdiqlaydi (yoki rad etadi). AI/OWNER to'g'ridan-to'g'ri terminate qila oladi (so'rovsiz).
model BnTerminationRequest {
  id            String                       @id @default(cuid())
  profileId     String                                                        // Kim chiqariladi (BnShop.profileId)
  shopId        String                                                        // Aynan qaysi do'kon
  reason        String                                                        // Nima uchun (batafsil)
  requestedById String                                                        // Kim yubordi (MODERATOR profil id)
  status        BnTerminationRequestStatus   @default(PENDING)
  decidedById   String?                                                       // OWNER profil id
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime                     @default(now())

  @@index([status, createdAt])
  @@index([shopId])
}

enum BnTerminationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Rekomendatsiya tizim ─────────────────────────────────────────────────────
// Foydalanuvchi hodisalari — mahsulot bilan har o'zaro ta'sir. Kunlik cron
// bularni yig'ib qiziqish vektoriga aylantiradi (BnInterest).

model BnUserEvent {
  id         String          @id @default(cuid())
  profileId  String
  productId  String
  type       BnEventType
  weight     Float           @default(1)   // signal darajasi (VIEW=1, CART=3, FAV=4, PURCHASE=10)
  createdAt  DateTime        @default(now())

  @@index([profileId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
}

enum BnEventType {
  VIEW
  CART
  FAV
  PURCHASE
}

// Foydalanuvchining qiziqish vektori — kunlik cron hisoblab yozadi.
// Cold start yoki hech qanday event yo'q bo'lsa null bo'ladi.
model BnInterest {
  id              String   @id @default(cuid())
  profileId       String   @unique
  // JSON: { "elektronika": 8.5, "kiyim": 3.2, ... } — kategoriya slug → score
  categoryScores  Json     @default("{}")
  // JSON: { "shopId1": 5.5, "shopId2": 2.1, ... }
  shopScores      Json     @default("{}")
  // JSON: { "marketId1": 4.0, ... }
  marketScores    Json     @default("{}")
  // Foydalanuvchi o'rtacha narx tanlovi
  avgPrice        Int?
  minPrice        Int?
  maxPrice        Int?
  // Foydalanuvchi ko'p ishlatgan atributlar (masalan: brand=Samsung)
  attrScores      Json     @default("{}")
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}
enum BnShopTier {
  NEW
  TRUSTED
  VERIFIED
  PREMIUM
}

enum BnVerifiedTier {
  NONE
  RETAIL      // Chakana sotuvchi galochkasi
  WHOLESALE   // Ulgurji galochkasi (retail'dan qiyinroq)
}

// ── Kategoriya (atribut sxemasi bilan — universal) ───────────────────────────
model BnCategory {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  nameRu          String?
  parentId        String?
  parent          BnCategory?  @relation("BnCatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        BnCategory[] @relation("BnCatTree")
  icon            String?                          // Lucide ikon nomi (emoji EMAS)
  attributeSchema Json         @default("[]")      // [{key,label,type,options,required,filterable}]
  order           Int          @default(0)
  isActive        Boolean      @default(true)
  productCount    Int          @default(0)         // kesh
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products        BnProduct[]

  @@index([parentId, order])
  @@index([isActive, order])
}

// ── Mahsulot ─────────────────────────────────────────────────────────────────
model BnProduct {
  id             String            @id @default(cuid())
  shopId         String
  shop           BnShop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       BnCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title          String
  slug           String            @unique
  description    String?
  images         String[]          @default([])    // maks 10
  videos         String[]          @default([])    // maks 2

  price          Int                               // so'm (butun)
  oldPrice       Int?
  isNegotiable   Boolean           @default(false) // "Kelishilgan narxda"

  attributes     Json              @default("{}")  // kategoriya sxemasiga mos qiymatlar

  stock          Int               @default(1)
  sold           Int               @default(0)

  // Olish usullari
  allowPickup    Boolean           @default(true)
  allowDelivery  Boolean           @default(false)
  allowInspect   Boolean           @default(true)  // "ko'rib sotib olish"

  // 18+ tovar (masalan ichki kiyim, kondom, sog'liq buyumlari). Xiralashtirib
  // ko'rsatiladi, foydalanuvchi tasdig'i bilan ochiladi. Diniga ZID mahsulot
  // umuman taqiqlanadi (bu flag emas — BLOCK bo'ladi).
  isMature       Boolean           @default(false)

  // Ulgurji (B2B) — faqat BN do'kon egalari ko'radi va sotib oladi.
  // wholesaleTiers = [{minQty:20,price:8000},{minQty:50,price:7500},{minQty:100,price:7000}]
  isWholesale    Boolean           @default(false)
  minWholesaleQty Int?                              // minimal buyurtma (masalan 20)
  wholesaleTiers Json              @default("[]")   // narx pog'onalari

  // Bozor narxi — BN ning asosiy va'dasi
  marketAvgPrice Int?                              // o'xshash mahsulotlar o'rtachasi
  priceRank      String?                           // "cheap" | "fair" | "expensive"
  priceCalcAt    DateTime?

  isActive       Boolean           @default(true)
  hidden         Boolean           @default(false) // moderatsiya
  views          Int               @default(0)
  rating         Float             @default(0)
  ratingCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  orderItems     BnOrderItem[]
  reviews        BnProductReview[]
  variants       BnProductVariant[]

  @@index([shopId, createdAt])
  @@index([categoryId, isActive, hidden])
  @@index([isActive, hidden, createdAt])
  @@index([price])
}

// ── Savat va sevimlilar ──────────────────────────────────────────────────────
model BnCartItem {
  id        String   @id @default(cuid())
  profileId String
  productId String
  variantId String?                                          // agar variant tanlangan bo'lsa
  variant   BnProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([profileId, productId, variantId])
  @@index([profileId])
}

model BnFavorite {
  id        String   @id @default(cuid())
  profileId String
  productId String
  privacy   BnFavPrivacy @default(PRIVATE)   // Do'stlar wishlist funksiyasi
  createdAt DateTime @default(now())

  @@unique([profileId, productId])
  @@index([profileId, createdAt])
  @@index([profileId, privacy])
}

enum BnFavPrivacy {
  PRIVATE     // faqat men (default)
  FOLLOWERS   // Nexus obunachilarim ko'radi
  PUBLIC      // hammaga ochiq
}

// Xaridor manzillar kitobchasi — uy, ish, va h.k. Checkout'da tanlash uchun.
model BnAddress {
  id         String   @id @default(cuid())
  profileId  String
  label      String   @default("Manzil")    // "Uy", "Ish", ...
  address    String                          // ochiq matn
  phone      String
  city       String   @default("Toshkent")
  district   String?                         // tuman
  landmark   String?                         // "Muzey oldi"
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId, isDefault])
}

// Narx tushdi kuzatish — foydalanuvchi mahsulotni "kuzatishga" qo'yadi.
// Kunlik cron narx N% pastga tushsa Nexus notification yuboradi.
model BnPriceWatch {
  id           String   @id @default(cuid())
  profileId    String
  productId    String
  targetPct    Int      @default(10)         // masalan: 10% (narx 10% tushsa xabar)
  basePrice    Int                           // qo'shilgan paytdagi narx (foiz shu bilan taqqoslanadi)
  lastNotified DateTime?
  createdAt    DateTime @default(now())

  @@unique([profileId, productId])
  @@index([productId])
}

// ── Buyurtma ─────────────────────────────────────────────────────────────────
model BnOrder {
  id            String        @id @default(cuid())
  code          String        @unique              // "BN-2026-000123"
  buyerId       String
  shopId        String
  shop          BnShop        @relation(fields: [shopId], references: [id])
  items         BnOrderItem[]

  subtotal      Int
  deliveryFee   Int           @default(0)
  commission    Int           @default(0)          // For Humo ulushi (5%)
  total         Int

  fulfillType   BnFulfillType
  address       String?
  phone         String
  note          String?

  paymentMethod BnPayMethod   @default(WALLET)
  paymentStatus BnPayStatus   @default(PENDING)
  escrowHeld    Boolean       @default(false)      // pul ushlanganmi
  settledAt     DateTime?                          // sotuvchiga to'langan

  status        BnOrderStatus @default(PLACED)
  cancelReason  String?

  placedAt      DateTime      @default(now())
  confirmedAt   DateTime?
  readyAt       DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  @@index([shopId, placedAt])
  @@index([buyerId, placedAt])
  @@index([status, placedAt])
}

model BnOrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       BnOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     BnProduct @relation(fields: [productId], references: [id])
  variantId   String?                                 // tanlangan variant (agar bor bo'lsa)
  variantName String?                                 // denorm — variant o'chsa ham tarix
  title       String                                  // snapshot
  price       Int                                     // snapshot (variant narxi bo'lsa)
  qty         Int       @default(1)
  imageUrl    String?

  @@index([orderId])
}

enum BnFulfillType {
  PICKUP
  DELIVERY
  INSPECT
}
enum BnPayMethod {
  WALLET
  CASH
}
enum BnPayStatus {
  PENDING
  HELD
  PAID
  REFUNDED
}
enum BnOrderStatus {
  PLACED
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  DISPUTED
}

// ── "Ko'rib sotib olish" bandi (24 soat) ─────────────────────────────────────
// Xaridor bozorga borib ko'radi, yoqsa kodni aytadi. BN ning asosiy farqi.
model BnInspectHold {
  id          String    @id @default(cuid())
  code        String    @unique                    // "BN-4821"
  productId   String
  profileId   String                               // xaridor
  qty         Int       @default(1)
  expiresAt   DateTime                             // +24 soat
  usedAt      DateTime?                            // sotuvchi tasdiqladi
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([productId, expiresAt])
  @@index([profileId, createdAt])
}

// ── Sharhlar ─────────────────────────────────────────────────────────────────
model BnProductReview {
  id        String    @id @default(cuid())
  productId String
  product   BnProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  orderId   String?                                // xarid tasdig'i
  rating    Int                                    // 1-5
  text      String?
  images    String[]  @default([])
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([productId, profileId])
  @@index([productId, hidden])
}

model BnShopReview {
  id        String   @id @default(cuid())
  shopId    String
  shop      BnShop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  profileId String
  orderId   String?
  rating    Int
  text      String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([shopId, profileId])
  @@index([shopId, hidden])
}

// ── Boshqaruv rollari ────────────────────────────────────────────────────────
// Jalol = OWNER (BN ichida hamma narsa). Founder doim o'tadi (yozuv shart emas).
model BnAdmin {
  id        String      @id @default(cuid())
  profileId String      @unique
  role      BnAdminRole
  addedById String?
  note      String?                                // "BN loyiha rahbari"
  createdAt DateTime    @default(now())
}

enum BnAdminRole {
  OWNER
  MODERATOR
}

// ── Mahsulot variantlari (rang/o'lcham/xotira) ───────────────────────────────
// Kiyim/poyabzal/telefon uchun majburiy — har variantda alohida narx va stok.
// Mahsulotda variant bo'lsa: `BnProduct.price`=eng arzoni, `stock`=yig'indi.
model BnProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   BnProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String                                        // "Qora / XL", "256 GB / Kumush"
  price     Int                                            // so'm (butun)
  oldPrice  Int?
  stock     Int      @default(0)
  image     String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  cartItems BnCartItem[]

  @@index([productId, sort])
}

// ── BN bildirishnomalar ──────────────────────────────────────────────────────
// Order status o'zgargani, sharh, boyot, narx tushdi... — xaridor/sotuvchiga.
model BnNotification {
  id        String        @id @default(cuid())
  profileId String                                         // qabul qiluvchi UserProfile.id
  type      BnNotifType
  title     String
  body      String?
  link      String?                                        // bosilganda o'tadigan manzil (masalan /buyurtmalarim/xxx)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([profileId, read])
  @@index([profileId, createdAt])
}

enum BnNotifType {
  ORDER_PLACED         // Sotuvchiga: yangi buyurtma keldi
  ORDER_CONFIRMED      // Xaridorga: sotuvchi tasdiqladi
  ORDER_READY          // Xaridorga: mahsulot tayyor
  ORDER_COMPLETED      // Xaridorga: buyurtma yakunlandi
  ORDER_CANCELLED      // Xaridorga: sotuvchi bekor qildi (yoki aksincha)
  REVIEW_RECEIVED      // Sotuvchiga: yangi sharh
  PRICE_DROP           // Xaridorga: kuzatilgan mahsulot narxi tushdi
  BAN_APPLIED          // Sotuvchiga: sizga ban qo'yildi
  BAN_LIFTED           // Sotuvchiga: ban olib tashlandi
  RETURN_REQUESTED     // Sotuvchiga: qaytarish so'ralgan
  RETURN_DECIDED       // Xaridorga: qaytarish qabul/rad
  SHOP_APPROVED        // Sotuvchiga: do'kon tasdiqlandi
  SHOP_REJECTED        // Sotuvchiga: do'kon rad etildi
}

// ── Qaytarish (return) tizimi ────────────────────────────────────────────────
// Xaridor mahsulotni qaytarishi mumkin — sabab bilan.
// Sotuvchi qabul qilsa: stok tiklanadi, xaridor puli qaytariladi (WALLET).
model BnReturn {
  id           String            @id @default(cuid())
  orderId      String                                       // BnOrder.id
  buyerId      String                                       // xaridor
  reason       String                                       // qisqa sabab
  detail       String?                                      // batafsil (ixtiyoriy)
  images       String[]          @default([])               // dalil rasm URL'lari (maks 5)
  status       BnReturnStatus    @default(REQUESTED)
  decidedById  String?                                      // sotuvchi profileId
  decidedAt    DateTime?
  decisionNote String?                                      // sotuvchi izohi
  refunded     Boolean           @default(false)            // hamyonga qaytarilganmi
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orderId])
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

enum BnReturnStatus {
  REQUESTED     // Xaridor so'radi
  APPROVED      // Sotuvchi qabul qildi (mahsulot qaytariladi, pul tiklanadi)
  REJECTED      // Sotuvchi rad etdi (sabab bilan)
  CANCELLED     // Xaridor o'zi bekor qildi
}

// ── Boykot brendlar ──────────────────────────────────────────────────────────
// OWNER (@abduvoris/@x) yozadi. Bu brendlar mahsuloti BN'da sotilmaydi.
// Sabab: har xil (siyosiy, axloqiy, sifat, boykot chaqiruvi).
// Mahsulot yaratilayotganda title/description tekshiriladi, mos kelsa BLOCK.
// Foydalanuvchi /bn/boykot sahifada ro'yxatni + sabablarini ko'radi.
model BnBoycottBrand {
  id         String   @id @default(cuid())
  name       String   @unique                       // Asosiy nom (masalan "Coca-Cola")
  aliases    String[] @default([])                  // Boshqa nomlar/sinonimlar ("coke", "coca cola")
  reason     String                                 // Nima uchun (foydalanuvchiga ko'rinadigan)
  detail     String?                                // Batafsil (ixtiyoriy)
  categories String[] @default([])                  // Yo'nalish teglari ("ichimlik", "siyosiy")
  addedById  String                                 // OWNER profileId
  addedAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([addedAt])
}

// ── Zaxira usernamelar ───────────────────────────────────────────────────────
// Foydalanuvchi olmaydigan @nomlar (tizim, brend, mashhur odam, davlat,
// PERSONAL — yaqin odamlarga ajratilgan). VIP toifa keyin 10K+ faol
// foydalanuvchi bo'lganda sotiladi (hozircha bepul band ko'rsatiladi).
model ReservedUsername {
  id           String   @id @default(cuid())
  username     String   @unique                       // lowercase canonical
  category     ReservedCategory
  priceUzs     Int?                                    // VIP: kelajakda sotiladigan narx
  note         String?                                 // "Onamga", "Cristiano Ronaldo", "Apple Inc."
  assignedToId String?                                 // PERSONAL: aynan qaysi profil ololadi
  reservedById String?                                 // Qo'shgan founder (audit)
  createdAt    DateTime @default(now())
  claimedAt    DateTime?                               // Kimgadir topshirilganda (arxiv)
  @@index([category])
}

enum ReservedCategory {
  SYSTEM      // admin, api, humo — hech kimga
  VIP         // 777, ali, vip — kelajakda pullik
  CELEBRITY   // cristiano, ronaldo — mashhur odam kelsa beriladi
  BRAND       // apple, samsung — rasmiy vakilga beriladi
  COUNTRY     // uzbekistan, russia — davlat rasmiy vakili
  GOVERNMENT  // president, mvd — davlat organi
  PERSONAL    // do'st/qarindosh — assignedToId bo'yicha
}

