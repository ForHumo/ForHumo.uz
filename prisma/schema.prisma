generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Humo ID — unified identity across all For Humo services ──────────────────

enum AccountType {
  GOOGLE   // To'liq Humo ID — Google bilan (For Humo loyihalari)
  SWEET    // Sweet ID — hamkor (Sevinch Sweets), Telegram bilan; ma'lumotni Humo ID saqlaydi
  SYSTEM   // Tizim profillari (Humo eSport, Belis, BN — avto-postlar uchun). Login qilinmaydi.
}

enum AuthProvider {
  GOOGLE
  TELEGRAM
}

// Bitta Humo ID profili ↔ login usuli(lar)i. SWEET profil uchun bu TELEGRAM
// identity bo'ladi; bu Sevinch Sweets ↔ Humo ID "ko'prigi" (Sweet ID).
model Identity {
  id         String       @id @default(cuid())
  profileId  String
  profile    UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  providerId String        // Google "sub" yoki Telegram user id (string)
  username   String?
  photoUrl   String?
  createdAt  DateTime     @default(now())

  @@unique([provider, providerId])
  @@index([profileId])
}

model UserProfile {
  id            String      @id @default(cuid())
  email         String?     @unique   // SWEET (Telegram) profillarda bo'lmaydi
  googleId      String?     @unique
  accountType   AccountType @default(GOOGLE)
  origin        String?                 // SWEET uchun qaysi hamkor yaratgan (masalan "sevinch")

  // Name fields
  name          String?            // display name (editable)
  firstName     String?
  lastName      String?
  fatherName    String?            // Otasining ismi

  // Identity
  username      String?  @unique   // @handle — e.g. "forhumo_ali"
  humoId        String?  @unique   // e.g. "UZ4829341"
  country       String?  @default("UZ")  // ISO alpha-2

  // Profile
  image         String?            // custom avatar URL (null = use Google photo)
  coverImage    String?            // background/banner image URL
  bio           String?            // max 160 chars
  birthday      DateTime?
  city          String?            // legacy short city name
  location      String?            // AES-256-GCM encrypted full address
  locationIv    String?            // base64 IV for location decryption

  // Contact
  // DEPRECATED: phone plaintext — endi phoneEnc/phoneIv shifrlangan.
  // Backfill script tomonidan bo'shatilyapti (null bo'ladi).
  phone         String?
  phoneEnc      String?            // AES-256-GCM shifrlangan phone (base64)
  phoneIv       String?            // base64 IV
  // Kontakt sinxronizatsiyasi uchun raqamning SHA-256 hashi (E.164 normalizatsiya).
  // Boshqa foydalanuvchilar mening telefonimni topib men bilan bog'lanishi uchun.
  // Raw raqam saqlanmaydi (bu ustunda). phone o'zgarganda phoneHash ham yangilanadi.
  phoneHash     String? @unique

  // Verification level:  0 = basic (Google only)
  //                      1 = email confirmed
  //                      2 = KYC (biometric, future)
  level         Int      @default(0)
  emailVerified Boolean  @default(false)

  // Ijodkor pullik obunasi — 0 = o'chiq, >0 = oylik narx (subCurrency valyutasida)
  subPrice      Int      @default(0) @map("subPriceZij")
  subCurrency   Currency @default(UZS)

  // "Har safar ovoraga tushmaysiz" — ijodkor bir marta yoqib qo'ysa,
  // barcha post/video/live/track avtomatik o'z kanaliga xabar sifatida ketadi.
  autoRepostToOwnChannel Boolean @default(false)

  // Rasmiy For Humo agent'lari (@id, @ai, @nexus, @esport, @market, @pay,
  // @bn, @support, @forhumo) — foydalanuvchi profil emas, tizim identity.
  // isOfficialAgent=true bo'lsa kanal/guruh nomi shu username bilan mavjud;
  // managerId — bu agent'ni boshqaruvchi profil (CEO va uning delegatlari).
  isOfficialAgent   Boolean   @default(false)
  managerId         String?                     // UserProfile.id — nazoratchi

  // Tasdiqlangan (ko'k belgi) — founderlardan tashqari, ariza orqali
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  // Kategoriya bo'yicha tasdiq (YouTube uslubi): musician/filmmaker/author/sportsman/journalist/
  // creator/gamer/entertainer/organization/government. NULL = generic (founder yoki eski).
  verifiedCategory  String?

  // AI moderation blokirovkalari (progressiv)
  bans              UserBan[]

  // Steam OpenID linking (CS2 sportchilar uchun majburiy; login emas — faqat identity link)
  steamId64     String?   @unique   // Valve SteamID64 (17-rem raqam)
  steamPersona  String?             // Steam displayed nickname (Web API'dan olinadi)
  steamAvatar   String?             // Steam avatar URL (Web API'dan olinadi)
  steamLinkedAt DateTime?

  // Onboarding
  onboardingDone Boolean @default(false)

  // Akkaunt o'chirildi (tombstone) — hamyon/ledger saqlanadi, PII tozalanadi, kontent o'chadi
  deletedAt     DateTime?

  // Rate-limit: user-initiated profile edits allowed once per 14 days
  profileEditedAt DateTime?

  // Maxsus status (Slack/Discord uslubi) — emoji + qisqa matn, ixtiyoriy amal muddati
  statusEmoji     String?             // "🎮", "💻", "😴", ...
  statusText      String?             // "O'yinda", "Ishda", "Uxlayapman"
  statusExpiresAt DateTime?           // NULL = doimiy; bo'lsa keyin avto-tozalanadi

  // Ikkinchi valyutani (USD) narxlar yonida referens sifatida ko'rsatish
  showUsdRef    Boolean  @default(false)

  // Bildirishnoma sozlamalari — JSON: { LIKE: false, COMMENT: true, ... }
  // Ro'yxatda YO'Q tur = default yoqilgan. Faqat OFF'lar saqlanadi.
  notifPrefs    Json?

  // Nexus chaqiruv ringtone (signature/whisper/pulse/melody/classic) — default signature
  ringtone      String   @default("signature")

  // 2FA (TOTP RFC 6238) — authenticator app (Google Authenticator, Authy, 1Password, ...)
  // Google OAuth ustidan qo'shimcha bosqich: sign-in → TOTP kod → sessiya
  totpEnabled       Boolean   @default(false)
  // DEPRECATED: totpSecret plaintext base32 — endi totpSecretEnc/Iv (AES-256-GCM).
  // Backfill script bo'shatadi (null). Yangi 2FA yoqishlar to'g'ridan-to'g'ri
  // shifrlangan formatda yoziladi.
  totpSecret        String?
  totpSecretEnc     String?              // AES-256-GCM shifrlangan (base64)
  totpSecretIv      String?              // base64 IV
  totpEnabledAt     DateTime?
  totpBackupCodes   Json?                // string[] — SHA-256 hex hashlangan; ishlatilgani ro'yxatdan chiqadi

  // GDPR data portability — foydalanuvchi 7 kunda 1 marta o'z ma'lumotlarini yuklab olishi mumkin.
  // Rate-limit: `lastExportAt` bo'yicha (JSON eksporti resurs talabchan).
  lastExportAt      DateTime?

  // Nearby (yaqin atrofdagi) — opt-in geolokatsiya. Foydalanuvchi yoqsa, boshqa
  // opt-in foydalanuvchilar uni topib DM yozishi mumkin. 24 soatdan eski koordinatalar
  // hisobga olinmaydi (nearbyUpdatedAt > now-24h filtri).
  //
  // Xavfsizlik: koordinatalar boshqalarga qaytmaydi — faqat masofa (Haversine).
  nearbyEnabled     Boolean   @default(false)
  nearbyLat         Float?
  nearbyLng         Float?
  nearbyUpdatedAt   DateTime?

  lastLoginAt   DateTime?
  // Oxirgi faollik vaqti — presence + REST fallback (heartbeat) bilan yangilanadi.
  // Onlayn: presence-nexus'da bor. Offline: lastSeenAt ko'rsatiladi (privacy'ga bo'ysunadi).
  lastSeenAt    DateTime?
  // Privacy — kim mening online/last seen ma'lumotimni ko'ra oladi:
  //   "all" — hamma (default), "contacts" — bir-birini follow qilganlar, "none" — hech kim
  privacyLastSeen String @default("all")
  // Kim menga DM yozishi mumkin:
  //   "all" — hamma (default), "contacts" — men kuzatgan yoki meni kuzatgan, "none" — hech kim
  privacyDm       String @default("all")
  // Kim mening profil rasmimni ko'radi (chat, feed vaqti):
  //   "all" — hamma (default), "contacts" — kontaktlar, "none" — hech kim
  privacyProfilePhoto String @default("all")
  // Push bildirishnomasida ko'rinish rejimi:
  //   "full" — yuboruvchi ismi + xabar preview (default), "name" — faqat ism ("Yangi xabar"),
  //   "hidden" — hech qanday ma'lumot ("For Humo · Yangi xabar")
  privacyPushPreview String @default("full")
  loginEvents   LoginEvent[]
  supportTickets SupportTicket[]
  marketWorker    MarketWorker? @relation("MarketWorkerProfile")
  marketWorkersAdded MarketWorker[] @relation("MarketWorkerAddedBy")
  nexusAgent      NexusAgent?   @relation("NexusAgentProfile")
  nexusAgentsCreated NexusAgent[] @relation("NexusAgentOwner")
  nexusFolders    NexusChatFolder[] @relation("NexusFolderProfile")
  emailCodes    EmailVerificationCode[]
  identities    Identity[]
  wallet        Wallet?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nearbyEnabled, nearbyUpdatedAt])
}

model LoginEvent {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  createdAt   DateTime    @default(now())
}

model SupportTicket {
  id            String       @id @default(cuid())
  profileId     String?
  profile       UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  email         String
  subject       String
  message       String       // dastlabki xabar (backward compat)
  status        String       @default("open")     // open / pending / closed
  module        String?                            // "bn"|"nexus"|"market"|"pay"|"id"|"esport"|"ai"|"support"|"belis"
  // C yondashuv — AI first-line
  aiHandled     Boolean      @default(false)      // AI (Gemini) hech bo'lmasa 1 marta javob berdi
  aiConfidence  Float?                            // 0..1 — oxirgi AI javobiga ishonch
  escalated     Boolean      @default(false)      // Insonga eskalatsiya qilindi (foydalanuvchi so'radi yoki AI qila olmadi)
  escalatedAt   DateTime?
  escalatedReason String?                         // "user_requested" | "ai_low_confidence" | "ai_limit" | "manual"
  updatedAt     DateTime     @default(now()) @updatedAt
  createdAt     DateTime     @default(now())
  messages      SupportMessage[]

  @@index([profileId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([escalated, updatedAt(sort: Desc)])
}

// ── Nexus foydalanuvchi papkalari (Telegram-style custom folders) ────────────
// Har foydalanuvchi o'z chatlarini turli papkalarga bo'lib olishi mumkin.
// Papka filtri: turlar (private/channel/group/bot) + aniq chat ID (include/exclude).
model NexusChatFolder {
  id             String       @id @default(cuid())
  profileId      String
  profile        UserProfile  @relation("NexusFolderProfile", fields: [profileId], references: [id], onDelete: Cascade)
  name           String                                         // "Ish", "IT" ...
  emoji          String?                                        // masalan "📁"
  color          String?                                        // "red"|"orange"|"violet"|... (Telegram uslubi)
  includeTypes   String[]     @default([])                      // ["private","channel","group","bot","contacts","noncontacts"]
  includeUnread  Boolean      @default(false)                   // faqat o'qilmagan
  includeChatIds String[]     @default([])                      // qo'shimcha profile/chat IDlar
  excludeChatIds String[]     @default([])
  sort           Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([profileId, sort])
}

// ── Nexus Agentlar (Telegram Bot API ekvivalenti) ────────────────────────────
// Agent = maxsus UserProfile (username `_agent` bilan tugaydi). Foydalanuvchilar
// bilan bir tomonlama (agent → user) DM orqali strukturaviy xabar almashadi.
// Yaratuvchi: @create (BotFather ekvivalenti). Hozircha faqat @abduvoris.
model NexusAgent {
  id           String       @id @default(cuid())
  profileId    String       @unique
  profile      UserProfile  @relation("NexusAgentProfile", fields: [profileId], references: [id], onDelete: Cascade)
  module       String                                                          // ID/AI/NEXUS/ESPORT/MARKET/PAY/SUPPORT/BN
  ownerId      String                                                          // yaratuvchi profileId (@create egasi)
  ownerProfile UserProfile  @relation("NexusAgentOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  webhookUrl   String?                                                         // ixtiyoriy tashqi integratsiya
  // API kaliti — HMAC uchun secret va agent so'rov autentifikatsiyasi.
  // Prefix: agk_ + 32 hex bayt (agk_ + 64 hex chars). Bir marta ko'rsatiladi
  // (yaratilganda yoki qayta generatsiya paytida), hash saqlanmaydi — foydalanuvchi
  // xohlasa qayta olishi mumkin (rotate).
  apiKey       String?      @unique
  // Bot commands menyu (Telegram BotFather uslub) — JSON massiv:
  //   [{ cmd: "start", description: "Botni ishga tushirish" }, ...]
  //   cmd: 1-32 belgi (a-z, 0-9, _), description: 1-256 belgi
  //   Chat composer'da "/" bosilsa autocomplete ko'rsatiladi.
  commands     Json?
  isSystem     Boolean      @default(false)                                    // rasmiy agent (bir marta seed qilingan)
  // Kategoriya taglar (kelajak discover uchun): masalan ["oyin", "utility", "narx"]
  // Foydalanuvchi maks 5 ta tag qo'shadi. Har biri 2-24 belgi, a-z0-9_-.
  tags         String[]     @default([])
  // Per-agent rate-limit — daqiqada maks so'rov (0 = default 60/min).
  // Faqat webhook chaqiruvlariga tegishli. Owner o'zgartira oladi.
  rateLimitPerMinute Int    @default(0)
  createdAt    DateTime     @default(now())
  logs         NexusAgentLog[]
  @@index([ownerId])
  @@index([tags])
}

// Bot webhook logs — so'nggi 100 chaqiruv audit (owner ko'radi).
model NexusAgentLog {
  id         String     @id @default(cuid())
  agentId    String
  agent      NexusAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  event      String                              // "message.new" | "webhook.ping" | "inline.query"
  ok         Boolean                             // webhook success?
  statusCode Int?                                // HTTP status kod
  elapsedMs  Int                                 // response vaqti
  error      String?    @db.VarChar(500)         // xato matni (agar bor bo'lsa)
  preview    String?    @db.VarChar(200)         // request matn preview
  createdAt  DateTime   @default(now())
  @@index([agentId, createdAt])
}

// Humo Market — Owner tomonidan taklif qilingan worker'lar.
// Owner = founder (isFounderProfile). Worker = quyidagi jadvalda profileId'si bor.
// Worker keyinchalik username o'zgartirsa ham huquqi qoladi (ID bo'yicha bog'langan).
model MarketWorker {
  id                String       @id @default(cuid())
  profileId         String       @unique
  profile           UserProfile  @relation("MarketWorkerProfile", fields: [profileId], references: [id], onDelete: Cascade)
  addedByProfileId  String                                        // owner profileId
  addedByProfile    UserProfile  @relation("MarketWorkerAddedBy", fields: [addedByProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime     @default(now())
  @@index([addedByProfileId])
}

model SupportMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorRole   String        // "USER" | "ADMIN" | "AI"
  authorId     String?       // profileId (AI uchun @support agent id)
  body         String        // <= 2000
  aiModel      String?       // masalan "gemini-2.5-flash-lite" — AI javoblarida
  aiConfidence Float?        // 0..1 — bu javob bo'yicha ishonch
  readByUser   Boolean       @default(true)
  readByAdmin  Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model EmailVerificationCode {
  id          String      @id @default(cuid())
  profileId   String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  correct     Int         // e.g. 74  — the right answer
  options     Int[]       // e.g. [23, 74, 51, 38] shown on screen

  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

// Humo eSport (0dan, Humo ID ustida) -- docs/humo-esport-design.md

model EsAdmin {           // eSport admini (ega Humo ID raqami bilan qo'shadi)
  id        String   @id @default(cuid())
  humoId    String   @unique
  createdBy String                          // qo'shgan ega humoId
  createdAt DateTime @default(now())
}

model EsGame {            // disiplina (JADVAL — yangi o'yin koddа o'zgarishsiz qo'shiladi)
  id          String   @id @default(cuid())
  slug        String   @unique          // "mlbb", "pubgm"
  name        String                    // "Mobile Legends: Bang Bang"
  teamSize    Int                       // MLBB=5, PUBGM=4
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  rosters     EsRoster[]
  athletes    EsAthlete[]
  divisions   EsDivision[]
  tournaments EsTournament[]
}

model EsTeam {            // tashkilot — o'yinга bog'liq EMAS
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   @unique            // qisqa teg (masalan "RMC")
  logo      String?
  coverImage String?                    // jamoa banneri (muqova)
  ownerId   String                      // UserProfile.id (Humo ID egasi)
  bio       String?
  createdAt DateTime @default(now())
  rosters      EsRoster[]
  invites      EsTeamInvite[]
  joinRequests EsJoinRequest[]
  requests     EsRequest[]
  staff        EsTeamStaff[]
  @@index([ownerId])
}

model EsTeamStaff {        // jamoa lavozimlari (o'yinchi bo'lishi shart emas — istalgan Humo ID)
  id        String   @id @default(cuid())
  teamId    String
  profileId String                      // UserProfile.id
  role      String                      // VICE_OWNER | COACH | CAPTAIN | STAFF
  title     String?                     // STAFF uchun erkin lavozim (Direktor/Buxgalter/Admin)
  createdAt DateTime @default(now())
  team      EsTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([teamId, profileId])         // bir odam jamoada bitta lavozim yozuvi
  @@index([teamId])
}

model EsTeamInvite {       // taklif-kod (ega yaratadi, sportchi kod bilan qo'shiladi)
  id        String    @id @default(cuid())
  teamId    String
  code      String    @unique
  createdBy String                        // ega profileId
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  team      EsTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@index([teamId])
}

model EsJoinRequest {      // ariza (sportchi beradi, ega tasdiqlaydi)
  id        String    @id @default(cuid())
  teamId    String
  athleteId String
  status    String    @default("PENDING")  // PENDING/ACCEPTED/REJECTED
  createdAt DateTime  @default(now())
  team      EsTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete   EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([teamId, athleteId])
  @@index([teamId, status])
}

model EsRoster {          // har (jamoa × o'yin) bitta tarkib
  id          String @id @default(cuid())
  teamId      String
  gameId      String
  rating      Int    @default(1000)       // Elo kuch reytingi (mavsumlar aro saqlanadi; 1000 = boshlang'ich)
  peakRating  Int    @default(1000)       // eng yuqori Elo (tarix)
  lowRating   Int    @default(1000)       // eng past Elo (tarix)
  team    EsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  game    EsGame @relation(fields: [gameId], references: [id])
  members EsRosterMember[]
  @@unique([teamId, gameId])
  @@index([gameId])
}

model EsAthlete {         // Humo ID + bitta o'yin (qattiq qulf)
  id            String  @id @default(cuid())
  humoProfileId String  @unique         // bir Humo ID = bitta athlete
  gameId        String                  // IMMUTABLE — hech qachon o'zgarmaydi
  ign           String  @unique         // in-game nom — TAKRORLANMAYDI
  gameUserId    String                  // in-game ID (MLBB raqami) — o'yin ichida takrorlanmaydi
  gameServer    String?                 // server/zona
  role          String?                 // pozitsiya
  image         String?                 // avatar (null = Humo ID rasmi)
  coverImage    String?                 // profil banneri (muqova)
  marketValue   Decimal? @db.Decimal(18, 2)  // transfer bozori narxi
  blockedUntil  DateTime?               // bloklangan bo'lsa shu sanagacha (null=blok yo'q; uzoq sana=abadiy)
  blockReason   String?                 // bloklash sababi (admin)
  createdAt     DateTime @default(now())
  game          EsGame  @relation(fields: [gameId], references: [id])
  memberships   EsRosterMember[]
  transfers     EsTransfer[]
  joinRequests  EsJoinRequest[]
  contracts     EsContract[]
  @@unique([gameId, gameUserId])        // o'yin ID raqami takrorlanmaydi
  @@index([gameId])
}

model EsRosterMember {    // sportchini tarkibга bog'laydi (transfer shu yerda)
  id        String   @id @default(cuid())
  rosterId  String
  athleteId String
  role      String   @default("STARTER")  // CAPTAIN/STARTER/SUB
  joinedAt  DateTime @default(now())
  roster    EsRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  athlete   EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([athleteId])                  // sportchi bir vaqtда bitta tarkibда (o'z o'yinида)
  @@index([rosterId])
}

model EsDivision {        // futboldek tier (1 = eng yuqori; eng katta tier = Ochiq divizion)
  id       String @id @default(cuid())
  gameId   String
  name     String                        // "Pro Division"
  tier     Int                           // 1 = eng yuqori
  capacity Int?                          // jamoalar chegarasi; null = CHEKSIZ (Ochiq divizion)
  game     EsGame @relation(fields: [gameId], references: [id])
  @@unique([gameId, tier])
}

model EsSeason {          // mavsum
  id       String   @id @default(cuid())
  gameId   String
  name     String                        // "2026 Season 1"
  startsAt DateTime @default(now())
  endsAt   DateTime?
  active   Boolean  @default(true)
}

model EsTournament {      // turnir
  id           String   @id @default(cuid())
  gameId       String
  divisionId   String?
  seasonId     String?
  name         String
  format       String   @default("SINGLE_ELIM")  // SINGLE_ELIM/DOUBLE_ELIM/GROUPS
  prizePool    Decimal? @db.Decimal(18, 2)
  prizeFunded  Decimal  @default(0) @db.Decimal(18, 2)  // egadan escrow'ga to'ldirilgan mukofot
  currency     String   @default("UZS")
  status       String   @default("UPCOMING")      // UPCOMING/REGISTRATION/LIVE/ENDED
  maxTeams     Int      @default(16)               // 0 = cheksiz (Ochiq divizion turniri)
  thirdPlace   Boolean  @default(true)             // 3-o'rin o'yini (TOP 3 uchun)
  registrationStartsAt DateTime?                   // Ochiq divizion: ro'yxat ochiladi
  registrationEndsAt DateTime?                     // Ochiq divizion: ro'yxat yopiladi
  bracketAt    DateTime?                           // setka avtomatik tuziladigan vaqt (10:00 +5)
  startsAt     DateTime?
  endsAt       DateTime?
  bracketReady Boolean  @default(false)            // setka tuzilganmi
  createdAt    DateTime @default(now())
  game         EsGame   @relation(fields: [gameId], references: [id])
  participants EsTournamentTeam[]
  matches      EsMatch[]
  @@index([gameId, status])
}

model EsTournamentTeam {  // ro'yxatdan o'tgan jamoa (o'z o'yin-tarkibi bilan)
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  rosterId     String                    // qaysi tarkib bilan kirgan
  seed         Int?
  registeredAt DateTime @default(now())
  tournament   EsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, teamId])
  @@index([tournamentId])
}

model EsMatch {           // bracket o'yini
  id           String    @id @default(cuid())
  tournamentId String
  bracket      String    @default("MAIN")  // MAIN/THIRD (3-o'rin)
  round        Int
  slot         Int                        // round ichидаги o'rin (bracket pozitsiya)
  teamAId      String?
  teamBId      String?
  seedA        Int?                            // seeding raqami (ko'rsatish uchun)
  seedB        Int?
  scoreA       Int?
  scoreB       Int?
  winnerId     String?
  status       String    @default("PENDING")  // PENDING/LIVE/DONE
  streamUrl    String?                         // Nexus/Twitch havola
  proofUrl     String?                         // natija isboti (yakuniy hisob skrinshoti)
  scheduledAt  DateTime?
  // bracket ulanishi: g'olib qayerga, mag'lub qayerga (yarim final -> 3-o'rin)
  nextMatchId      String?
  nextSlot         String?                     // "A" | "B"
  loserNextMatchId String?
  loserNextSlot    String?
  tournament   EsTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId, round])
}

model EsStanding {        // divizion/mavsum jadvali
  id         String @id @default(cuid())
  seasonId   String
  divisionId String
  teamId     String
  points     Int    @default(0)
  wins       Int    @default(0)
  losses     Int    @default(0)
  played     Int    @default(0)
  @@unique([seasonId, divisionId, teamId])
  @@index([seasonId, divisionId])
}

model EsLeagueMatch {     // liga o'yini (divizion ichida) — natija standings'ni yangilaydi
  id          String    @id @default(cuid())
  seasonId    String
  divisionId  String
  teamAId     String
  teamBId     String
  scoreA      Int?
  scoreB      Int?
  winnerId    String?                          // hisoblangan natija
  status      String    @default("SCHEDULED")  // SCHEDULED/DONE
  streamUrl   String?
  proofUrl    String?                          // natija isboti (yakuniy hisob skrinshoti)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([seasonId, divisionId, status])
}

model EsTransfer {        // futbol-transfer: o'yinchiga oylik taklif → qabul → jamoaga haq → ALKH Pay
  id            String   @id @default(cuid())
  athleteId     String
  fromTeamId    String?                          // sotuvchi jamoa (null = erkin sportchi)
  toTeamId      String                           // xaridor jamoa
  salary        Decimal? @db.Decimal(18, 2)      // oylik maosh (o'yinchi bilan kelishuv)
  conditions    String?                          // qo'shimcha shartlar
  contractMonths Int?                            // shartnoma muddati (oy)
  fee           Decimal? @db.Decimal(18, 2)      // transfer haqi (jamoaga; marketValuedan kam emas)
  currency      String   @default("UZS")
  status        String   @default("PLAYER_PENDING") // PLAYER_PENDING/AWAIT_FEE/CLUB_PENDING/DONE/REJECTED/CANCELLED
  createdAt     DateTime @default(now())
  athlete    EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, createdAt])
  @@index([toTeamId])
}

model EsNotification {   // eSport bildirishnomalari (transfer/ariza/kelishuv)
  id        String   @id @default(cuid())
  profileId String                          // qabul qiluvchi UserProfile.id
  type      String                          // TRANSFER_OFFER / TRANSFER_FEE / TRANSFER_DONE / JOIN_REQUEST / JOIN_RESULT / LEAVE_REQ / KICK_REQ / TEAM_DELETE_REQ / REQ_RESULT
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([profileId, read])
  @@index([profileId, createdAt])
}

model EsNews {            // Asosiy sahifadagi yangiliklar (admin yozadi)
  id        String   @id @default(cuid())
  title     String
  body      String?
  image     String?
  pinned    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model EsRetro {           // arxiv turnir (tarixiy natijalar — Turnirlar bo'limida)
  id        String   @id @default(cuid())
  name      String                          // "Autumn Tournament"
  season    String                          // "2025-2026"
  game      String                          // "Mobile Legends: Bang Bang"
  organizer String   @default("For Humo & Humo eSport")
  startDate DateTime
  endDate   DateTime
  prizePool Int?
  currency  String   @default("UZS")
  champion  String?
  runnerUp  String?
  third     String?
  createdAt DateTime @default(now())
  matches   EsRetroMatch[]
}

model EsRetroMatch {
  id      String  @id @default(cuid())
  retroId String
  order   Int
  date    String                            // ko'rsatish uchun "10/11/2025"
  time    String?
  stage   String                            // GROUP STAGE / SEMIFINALS / THIRD PLACE / GRAND FINAL
  teamA   String
  teamB   String
  scoreA  Int?
  scoreB  Int?
  winner  String?
  note    String?                           // o'yin holati
  reason  String?                           // sabab
  youtube String?
  retro   EsRetro @relation(fields: [retroId], references: [id], onDelete: Cascade)
  @@index([retroId, order])
}

model EsRequest {         // a'zolik kelishuvi: chiqish/chiqarish/jamoa o'chirish (ikki tomonlama rozilik)
  id          String   @id @default(cuid())
  type        String                          // LEAVE (sportchi chiqmoqchi) / KICK (jamoa chiqarmoqchi) / TEAM_DELETE
  teamId      String
  athleteId   String?                         // LEAVE/KICK — tegishli sportchi
  initiatedBy String                          // profileId
  status      String   @default("PENDING")    // PENDING/APPROVED/REJECTED/CANCELLED
  createdAt   DateTime @default(now())
  team        EsTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  approvals   EsRequestApproval[]
  @@index([teamId, status])
  @@index([athleteId, status])
}

model EsRequestApproval {  // TEAM_DELETE uchun a'zo ovozlari (100% rozilik kerak)
  id        String   @id @default(cuid())
  requestId String
  athleteId String
  createdAt DateTime @default(now())
  request   EsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@unique([requestId, athleteId])
}

model EsContract {        // o'yinchi shartnomasi (transfer/futbol modelidan) — muddat, oylik, status
  id         String    @id @default(cuid())
  athleteId  String
  teamId     String
  salary     Decimal?  @db.Decimal(18, 2)
  currency   String    @default("UZS")
  startsAt   DateTime  @default(now())
  endsAt     DateTime?                          // null = muddatsiz; o'tsa lazy-EXPIRED
  status     String    @default("ACTIVE")       // ACTIVE | EXPIRED | TERMINATED
  createdAt  DateTime  @default(now())
  athlete    EsAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, status])
  @@index([teamId, status])
}

model EsDispute {         // natija e'tirozi (jamoa egasi bildiradi, admin hakam)
  id            String   @id @default(cuid())
  matchType     String                          // TOURNAMENT | LEAGUE
  matchId       String                          // EsMatch.id yoki EsLeagueMatch.id (polimorf, FK yo'q)
  teamId        String                          // e'tiroz bildirgan jamoa
  filedBy       String                          // UserProfile id (ega)
  reason        String
  screenshotUrl String?                         // dalil skrinshoti
  status        String   @default("OPEN")       // OPEN | RESOLVED | REJECTED
  adminNote     String?                         // hakam izohi
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  @@index([status, createdAt])
  @@index([matchType, matchId])
}

model EsBroadcast {       // turnir translyatsiyasi (Asosiy 16:9 oyna — Nexus integratsiya)
  id           String    @id @default(cuid())
  title        String
  status       String    @default("SCHEDULED")  // LIVE/SCHEDULED/ENDED
  streamUrl    String?                           // embed havola (YouTube/Twitch/Nexus)
  source       String    @default("EXTERNAL")     // EXTERNAL (YouTube/Twitch) | CLOUDFLARE; Nexus = nexusLiveId
  liveInputId  String?                           // Cloudflare live input uid
  playbackId   String?                           // Cloudflare playback uid
  streamKey    String?                           // MAXFIY — faqat admin/ega (OBS)
  ingestUrl    String?                           // RTMP ingest URL
  nexusLiveId  String?                           // Nexus jonli efir bog'lanishi
  posterUrl    String?                           // muqova rasmi (oblojka)
  tournamentId String?
  matchId      String?
  scheduledAt  DateTime?                         // boshlanish vaqti (rejalashtirilgan)
  endsAt       DateTime?                         // tugash vaqti (avto-status uchun)
  endedAt      DateTime?
  viewers      Int       @default(0)
  createdBy    String                            // admin Humo ID
  createdAt    DateTime  @default(now())
  @@index([status, scheduledAt])
}

// ── Humo Market ──────────────────────────────────────────────────────────────

model MarketBrand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logo        String?
  description String?
  category    String?           // (eski — birinchi yo'nalish, backward compat)
  categories  String[] @default([])   // bir nechta yo'nalish
  verified    Boolean  @default(false)
  ownerId     String
  isPaid      Boolean  @default(false)  // 2-chi+ brend pullik
  createdAt   DateTime @default(now())

  products    MarketProduct[]
  reviews     MarketBrandReview[]
}

model MarketWishlist {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([profileId, productId])
}

model MarketReview {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String        // faqat harid qilganlar sharh yoza oladi
  rating    Int           // 1-5
  text      String?
  media     String[] @default([])   // rasm + video URL'lar
  hidden    Boolean  @default(false) // moderatsiya — yashirilgan
  createdAt DateTime @default(now())
  likes     MarketReviewLike[]
  replies   MarketReviewReply[]
  @@unique([profileId, productId])
}

// Sharhga javob — cheksiz ichma-ich (parentId orqali)
model MarketReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parentId  String?       // null = sharhga to'g'ridan; aks holda javobga javob
  profileId String
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([reviewId])
}

// Sharhga "qo'shilaman" (like) — necha kishi rozi. Avtomatik, qo'lda emas.
model MarketReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([reviewId, profileId])
}

// Bildirishnomalar (avtomatik yaratiladi)
model MarketNotification {
  id        String          @id @default(cuid())
  profileId String          // qabul qiluvchi
  type      MarketNotifType
  title     String
  body      String?
  link      String?         // bosilganda o'tadigan manzil
  image     String?
  read      Boolean         @default(false)
  createdAt DateTime        @default(now())
  @@index([profileId, read])
}

enum MarketNotifType {
  REVIEW_LIKE
  PRODUCT_REVIEW
  BRAND_REVIEW
  ORDER_DELIVERED
  ORDER_ACCEPTED
  ORDER_UPDATE
  REVIEW_REMINDER
  REPLY
  QUESTION
  ANSWER
}

// Brendga sharh + baho (faqat shu brenddan harid qilganlar)
model MarketBrandReview {
  id        String   @id @default(cuid())
  brandId   String
  brand     MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  profileId String
  rating    Int           // 1-5
  text      String?
  createdAt DateTime @default(now())
  @@unique([brandId, profileId])
}

model MarketProduct {
  id          String   @id @default(cuid())
  brandId     String
  brand       MarketBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  slug        String   @unique
  description String?
  images      String[]          // rasm URL massiv
  videos      String[] @default([])   // video URL massiv
  price       Decimal  @db.Decimal(18, 2)   // narx (currency bo'yicha)
  oldPrice    Decimal? @db.Decimal(18, 2)   // chegirma bo'lsa eski narx
  currency    Currency @default(UZS)         // valyuta — mahsulot sotuvchisi qaysida narxlagan
  stock       Int      @default(0)
  sold        Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)

  category    String            // asosiy kategoriya slug
  subcategory String?           // kichik kategoriya slug

  variantLabel String?          // variant guruh nomi, masalan "O'lcham" yoki "Rang" (null = variantsiz)

  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems   MarketCartItem[]
  orderItems  MarketOrderItem[]
  wishlists   MarketWishlist[]
  reviews     MarketReview[]
  questions   MarketProductQuestion[]
  variants    MarketProductVariant[]
}

// Mahsulot varianti (rang/o'lcham/xotira...) — har biriga alohida narx va stock
model MarketProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        // ko'rsatiladigan nom: "Qora / XL", "256 GB"
  price     Decimal  @db.Decimal(18, 2)
  oldPrice  Decimal? @db.Decimal(18, 2)
  stock     Int      @default(0)
  image     String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  cartItems MarketCartItem[]
  @@index([productId])
}

// Mahsulotga savol (harid shart emas — sotib olishdan oldin so'raladi)
model MarketProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  answers   MarketProductAnswer[]
  @@index([productId])
}

// Savolga javob (har kim; sotuvchi javobi ajratiladi)
model MarketProductAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   MarketProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profileId  String
  text       String
  hidden     Boolean  @default(false) // moderatsiya
  createdAt  DateTime @default(now())
  @@index([questionId])
}

// Moderatsiya flagi — foydalanuvchi shikoyati + AI xulosasi (Market+Nexus yagona)
model ModerationFlag {
  id           String             @id @default(cuid())
  module       String             // "MARKET" | "NEXUS"
  targetType   String             // PRODUCT/REVIEW/REPLY/QUESTION/ANSWER/POST/COMMENT
  targetId     String
  // foydalanuvchi shikoyatlari
  reportCount  Int                @default(0)
  lastReason   String?
  // AI xulosasi
  aiVerdict    ModerationVerdict?
  aiCategories String[]           @default([])
  aiSeverity   Float?
  aiReason     String?
  // hal qilish holati
  status       ModerationStatus   @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@unique([module, targetType, targetId])
  @@index([status])
}

// Har bir foydalanuvchi-shikoyati (dedup + rate-limit uchun). Bir foydalanuvchi
// bir target'ni faqat 1 marta shikoyat qila oladi (@@unique). Takroriy/spam
// shikoyat AI'ni qayta chaqirmaydi — xarajat himoyasi ModerationFlag tomonida.
model NexusReport {
  id         String   @id @default(cuid())
  reporterId String
  module     String   // "MARKET" | "NEXUS"
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  @@unique([reporterId, module, targetType, targetId])
  @@index([reporterId, createdAt])
}

// AI chaqiruvlari jurnali — faqat rate-limit uchun (pullik Gemini suiiste'molini to'sadi).
model AiUsage {
  id        String   @id @default(cuid())
  profileId String
  kind      String?  // "chat" | "search" | "listing" | "assist"
  createdAt DateTime @default(now())
  @@index([profileId, createdAt])
}

// Tavsiya algoritmi 4-bosqich: semantik embeddinglar (pgvector + Gemini).
// Prisma vector turini bilmaydi → Unsupported; insert/qidiruv raw SQL orqali (lib/nexus-embed.ts).
model NexusPostEmbedding {
  postId    String                      @id
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
}

model NexusUserEmbedding {
  profileId  String                      @id
  embedding  Unsupported("vector(768)")?
  computedAt DateTime                    @default(now())
}

// Tavsiya algoritmi 2-bosqich: saqlanadigan qiziqish vektori (kunlik cron'da qayta hisoblanadi).
// Signallar: like/save (post muallif+teg), video ko'rish (muallif+kategoriya+teg), follow (muallif).
// Json = { kalit: og'irlik } (top-N saqlanadi). Feed reytingi shu profil bilan tartiblaydi.
model NexusInterest {
  profileId  String   @id          // bitta foydalanuvchi = bitta vektor
  authors    Json     @default("{}")  // { authorId: weight }
  tags       Json     @default("{}")  // { tag: weight }
  categories Json     @default("{}")  // { category: weight }
  recAuthors Json     @default("{}")  // 3-bosqich CF: { authorId: score } — kuzatmagan, lekin tavsiya
  computedAt DateTime @default(now())
}

enum ModerationStatus {
  PENDING      // admin ko'rishi kutilmoqda
  KEPT         // ko'rib chiqildi — saqlandi
  HIDDEN       // admin yashirdi
  AUTO_HIDDEN  // AI avtomatik yashirdi (jiddiy)
}

enum ModerationVerdict {
  OK
  REVIEW
  BLOCK
}

model MarketCartItem {
  id        String   @id @default(cuid())
  profileId String
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   MarketProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([profileId, productId, variantId])
}

model MarketOrder {
  id            String              @id @default(cuid())
  profileId     String
  total         Decimal             @db.Decimal(18, 2)   // chegirmadan keyingi yakuniy summa
  discount      Decimal             @default(0) @db.Decimal(18, 2)
  currency      Currency            @default(UZS)         // buyurtma valyutasi (mahsulot valyutalariga mos)
  exchangeRate  Decimal?            @db.Decimal(18, 6)    // Buyurtma vaqtidagi USD/UZS kursi (Shariat: gharar oldini oladi)
  promoCode     String?
  settledAt     DateTime?           // sotuvchilarga to'lov amalga oshirilgan vaqt (ikki marta to'lamaslik uchun)
  status        MarketOrderStatus   @default(PENDING)
  paymentMethod MarketPaymentMethod @default(WALLET)
  address       String              // manzil majburiy
  note          String?
  createdAt     DateTime            @default(now())

  items         MarketOrderItem[]
}

// Promokod / kupon (platforma darajasida — asoschilar yaratadi)
model MarketPromoCode {
  id          String          @id @default(cuid())
  code        String          @unique
  type        MarketPromoType
  value       Decimal         @db.Decimal(18, 2)   // PERCENT: 1-100, FIXED: Ƶ miqdori
  minOrder    Decimal         @default(0) @db.Decimal(18, 2)
  maxDiscount Decimal?        @db.Decimal(18, 2)   // PERCENT uchun yuqori chegara
  usageLimit  Int?            // null = cheksiz
  usedCount   Int             @default(0)
  expiresAt   DateTime?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
}

enum MarketPromoType {
  PERCENT
  FIXED
}

enum MarketPaymentMethod {
  WALLET           @map("ZIJ")  // Hamyondan to'lash (DB'da eski 'ZIJ' qiymati saqlanadi)
  CASH_ON_DELIVERY                // Yetkazishda naqd
  CARD_ON_DELIVERY                // Yetkazishda karta
}

// Valyuta (money.ts Currency tipiga mos: UZS | USD)
enum Currency {
  UZS
  USD
}

model MarketOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id])
  variantId   String?       // tanlangan variant (agar bor bo'lsa)
  variantName String?       // denormalizatsiya — variant o'chsa ham tarix saqlanadi
  quantity    Int
  price       Decimal  @db.Decimal(18, 2)   // sotib olingan paytdagi narx
}

enum MarketOrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

// ── Nexus — ijtimoiy tarmoq (postlar, feed, like, izoh, follow) ──────────────
model NexusPost {
  id              String   @id @default(cuid())
  profileId       String                          // muallif (UserProfile.id)
  text            String?
  media           String[] @default([])           // rasm/video URL'lar
  hashtags        String[] @default([])
  bnProductId     String?                         // ixtiyoriy — BN mahsuloti (shoppable, BN Media integratsiya)
  privacy         NexusPostPrivacy @default(PUBLIC)  // PUBLIC / FOLLOWERS (obunachilar) / PRIVATE (faqat men)
  location        String?                         // ixtiyoriy joylashuv nomi (xaritadan tanlangan)
  locationLat     Float?                          // xarita koordinatasi (foydalanuvchi qoidasi: HAR DOIM kartada)
  locationLng     Float?
  pollOptions     String[] @default([])           // bo'sh = so'rovnoma yo'q (2-4 variant)
  pollEndsAt      DateTime?                       // so'rovnoma tugash vaqti
  shareCount      Int      @default(0)
  hidden          Boolean  @default(false) // moderatsiya
  editedAt        DateTime?                // tahrirlangan bo'lsa
  createdAt       DateTime @default(now())

  // Pullik post — bir marta sotib olish orqali ochiladi
  price           Int      @default(0)                      // 0 = bepul, >0 = pullik (egasi valyutasida)
  priceCurrency   Currency @default(UZS)
  subsFree        Boolean  @default(false)                  // true = pullik obunachi (kuzatuvchi) bepul ko'radi; qolganlar sotib oladi

  likes     NexusLike[]
  comments  NexusComment[]
  saves     NexusSave[]
  pollVotes NexusPollVote[]
  purchases NexusPostPurchase[]

  @@index([profileId])
  @@index([createdAt])
  @@index([bnProductId])
}

model NexusPostPurchase {
  id         String   @id @default(cuid())
  postId     String
  buyerId    String                                // sotib oluvchi UserProfile.id
  price      Int
  currency   Currency @default(UZS)
  createdAt  DateTime @default(now())
  post       NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, buyerId])
  @@index([buyerId])
}

enum NexusPostPrivacy {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS   // faqat pullik obunachilar
  PRIVATE
}

// So'rovnoma ovozi — bir post uchun bir ovoz (o'zgartirish mumkin, muddati tugaguncha)
model NexusPollVote {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  optionIdx Int
  createdAt DateTime  @default(now())
  @@unique([postId, profileId])
  @@index([postId])
}

model NexusLike {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
  @@index([profileId, createdAt])   // qiziqish profili (rec-algoritm) uchun
}

model NexusSave {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime @default(now())
  @@unique([postId, profileId])
}

model NexusComment {
  id        String   @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?                               // cheksiz ichma-ich javob uchun
  profileId String
  text      String
  hidden    Boolean  @default(false) // moderatsiya
  createdAt DateTime @default(now())
  @@index([postId])
}

model NexusFollow {
  id          String   @id @default(cuid())
  followerId  String                              // kim follow qilyapti
  followingId String                              // kimni
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

// Bloklash — ikki tomonlama ko'rinmaslik. A B'ni bloklasa: B A'ning kontentini
// ko'rmaydi, DM yoza olmaydi, follow qila olmaydi (va aksincha). Mavjud follow'lar uziladi.
model NexusBlock {
  id        String   @id @default(cuid())
  blockerId String                                // kim bloklayapti (UserProfile.id)
  blockedId String                                // kimni
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Ovozsizlantirish — yumshoq, bir tomonlama. A B'ni mute qilsa: A B'ning kontentini
// tasmada ko'rmaydi, lekin B bilmaydi va bemalol o'zaro aloqa qila oladi.
model NexusMute {
  id        String   @id @default(cuid())
  muterId   String                                // kim mute qilyapti (UserProfile.id)
  mutedId   String                                // kimni
  createdAt DateTime @default(now())
  @@unique([muterId, mutedId])
  @@index([muterId])
}

// Bildirishnoma — like/izoh/follow/javob (relation yo'q, MarketNotification kabi)
model NexusNotification {
  id          String         @id @default(cuid())
  recipientId String                              // kim oladi (UserProfile.id)
  actorId     String                              // kim qildi
  type        NexusNotifType
  postId      String?
  commentId   String?
  videoId     String?                             // video like/izoh/xarid uchun
  trackId     String?                             // trek like uchun
  liveId      String?                             // jonli efir uchun
  callId      String?                             // qo'ng'iroq (MISSED/ENDED) uchun
  ticketId    String?                             // Support tiket ID (SUPPORT type uchun)
  amount      Int?           @map("amountZij")    // tip/xarid miqdori (foydalanuvchi valyutasida)
  read        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

enum NexusNotifType {
  LIKE
  COMMENT
  FOLLOW
  REPLY
  VIDEO_LIKE
  VIDEO_COMMENT
  TRACK_LIKE
  PURCHASE
  LIVE
  TIP
  MENTION
  SUB_EXPIRING
  CALL_MISSED
  MOD_WARN         // AI moderatsiya yumshoq ogohlantirish (yaqin do'st + o'rta severity)
  SUPPORT          // Support ticket javob/status yangilanishi (@support agent orqali)
}

// Story — 24 soatlik vaqtinchalik kontent (multi-slide)
// Foydalanuvchi so'rovi: "Storis qo'yish funksiyamiz juda sodda uni
// to'g'rilashimiz kerak" — Instagram sifati: matn overlay, sticker,
// drawing, filter, musiqa, multi-slide, javob (DM), highlights, reaksiya.
model NexusStory {
  id          String              @id @default(cuid())
  profileId   String
  // Backward compat: birinchi slide (eski single-slide fallback)
  mediaUrl    String
  mediaType   NexusStoryMediaType @default(IMAGE)
  caption     String?
  // Musiqa (ixtiyoriy) — barcha slidelar uchun umumiy fon
  musicTrackId String?                            // NexusTrack.id
  musicTitle   String?                            // qisqa yorliq (offline uchun)
  musicUrl     String?                            // to'g'ridan-to'g'ri audio URL
  createdAt   DateTime            @default(now())
  expiresAt   DateTime                            // = createdAt + 24 soat
  views       NexusStoryView[]
  slides      NexusStorySlide[]
  reactions   NexusStoryReaction[]
  @@index([profileId, expiresAt])
  @@index([expiresAt])
}

enum NexusStoryMediaType {
  IMAGE
  VIDEO
  TEXT              // faqat matn (fon rangi + katta shrift)
}

// Bir story ichida bir necha slide (2-10 ta). Backward compat: agar slide
// yo'q bo'lsa NexusStory ning o'zi bitta slide sifatida ko'riladi.
model NexusStorySlide {
  id         String              @id @default(cuid())
  storyId    String
  story      NexusStory          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order      Int                                     // 0-based tartib
  mediaUrl   String                                  // rasm/video URL yoki bo'sh (TEXT uchun)
  mediaType  NexusStoryMediaType @default(IMAGE)
  durationMs Int?                                    // video davomiyligi (video uchun); IMAGE uchun 5s default
  caption    String?
  // Overlays JSON — matn, sticker, drawing pixels.
  // Klient tomonida canvas'ga chiziladi. Namuna:
  //   { texts: [{x,y,text,font,size,color,bg}], stickers: [{x,y,kind,value}], drawing: {strokes:[...]} }
  overlays   Json?
  // Filter — "none", "grayscale", "sepia", "warm", "cool", "vintage", ...
  filter     String              @default("none")
  // Fon rangi (TEXT slide uchun)
  bgColor    String?
  createdAt  DateTime            @default(now())
  @@unique([storyId, order])
  @@index([storyId, order])
}

// Story ko'rilganligi — halqa (seen) + ko'rganlar soni uchun
model NexusStoryView {
  id        String     @id @default(cuid())
  storyId   String
  story     NexusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profileId String                                // kim ko'rdi
  slideId   String?                               // qaysi slide (ixtiyoriy)
  createdAt DateTime   @default(now())
  @@unique([storyId, profileId])
  @@index([storyId])
}

// Story'ga emoji reaksiya (Instagram uslubi — heart, laugh, wow, ...)
model NexusStoryReaction {
  id        String     @id @default(cuid())
  storyId   String
  story     NexusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profileId String
  slideId   String?                               // qaysi slide
  emoji     String                                 // "❤️" | "😂" | "😮" | "🔥" | "👏" | "😢"
  createdAt DateTime   @default(now())
  @@index([storyId, createdAt])
  @@index([profileId])
}

// Story highlight — profilda saqlanadigan story kolleksiyalari
// (24 soatdan keyin ham ko'rinadi, profil ostida yoritiladi)
model NexusStoryHighlight {
  id          String   @id @default(cuid())
  profileId   String
  title       String                              // "Sayohat", "Ishlar", ...
  coverUrl    String?
  storyIds    String[] @default([])               // NexusStory.id lar (24s'dan keyin ham qoladi)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([profileId, order])
}

// Shaxsiy yozishma (1:1) — user1Id < user2Id normalizatsiya
model NexusConversation {
  id              String    @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessageAt   DateTime  @default(now())
  lastMessageText String?
  lastSenderId    String?
  user1ReadAt     DateTime?
  user2ReadAt     DateTime?
  // Chatni pinga qo'yish — har foydalanuvchi alohida (Telegram uslubi)
  pinnedByUser1   DateTime?                                   // user1 chatni pinga qo'ygan vaqti
  pinnedByUser2   DateTime?                                   // user2 chatni pinga qo'ygan vaqti
  // Arxiv — har foydalanuvchi alohida (asosiy ro'yxatdan yashiriladi, "Arxiv"da qoladi)
  archivedByUser1 DateTime?
  archivedByUser2 DateTime?
  // Mute — har foydalanuvchi alohida (bildirishnoma/badge kuchsizlantiriladi)
  mutedByUser1    DateTime?
  mutedByUser2    DateTime?
  // Tozalash: shu vaqtdan oldingi xabarlar shu foydalanuvchiga ko'rsatilmaydi
  clearedBeforeUser1 DateTime?
  clearedBeforeUser2 DateTime?
  // Vaqtinchalik yashirish (tekshiruv rejimi) — chat butunlay ro'yxatdan ketadi lekin
  // xabarlar saqlanadi. "Yashirin chatlar" bo'limidan qaytariladi. Har foydalanuvchi
  // uchun alohida — bir tomon yashirsa, boshqa tomonda ko'rinaveradi.
  hiddenByUser1   DateTime?
  hiddenByUser2   DateTime?
  // Auto-delete (WhatsApp uslub) — chatdagi barcha xabarlar shu sekunddan keyin
  // avtomatik o'chiriladi (kunlik cron). 0 = o'chirilgan. Har ikkala foydalanuvchi
  // uchun umumiy (chat-wide) sozlama.
  autoDeleteAfterSeconds Int @default(0)
  // Draft — foydalanuvchining kompozitorda yozgan matni. Server tomonida saqlanadi
  // (cross-device sync). Har foydalanuvchi alohida (user1/user2).
  // Composer 500ms debounce bilan avtomatik saqlaydi; xabar yuborilgach tozalanadi.
  draftUser1      String?   @db.VarChar(2000)
  draftUser2      String?   @db.VarChar(2000)
  draftUser1At    DateTime?
  draftUser2At    DateTime?
  createdAt       DateTime  @default(now())
  messages        NexusMessage[]
  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
}

model NexusMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String                                    // media bo'lsa caption yoki bo'sh
  // Ixtiyoriy media qo'shimchasi (rasm/video/audio/fayl/video-circle/location/poll)
  mediaUrl       String?
  mediaType      String?                                   // "image" | "video" | "audio" | "file" | "video-circle" | "location" | "poll"
  mediaMime      String?                                   // "image/jpeg", "video/mp4", "audio/webm", ...
  mediaName      String?                                   // fayl ko'rsatiladigan nomi
  mediaSize      Int?                                      // baytlar (fayl/audio/video hajmi)
  durationMs     Int?                                      // audio/video davomiyligi (ms)
  // Joylashuv (mediaType="location" bo'lganda)
  locLat         Float?
  locLng         Float?
  locUpdatedAt   DateTime?                                 // oxirgi yangilangan vaqti (jonli uchun)
  locExpiresAt   DateTime?                                 // NULL = statik; sana bo'lsa jonli, shundan keyin to'xtaydi
  // So'rovnoma (mediaType="poll" bo'lganda)
  pollQuestion   String?                                   // savol matni
  pollOptions    String[]          @default([])            // 2-10 variant
  pollExpiresAt  DateTime?                                 // NULL = cheklovsiz
  pollMulti      Boolean           @default(false)         // bir necha variant tanlash mumkinmi
  pollVotes      NexusDmPollVote[]
  // Pul o'tkazma (mediaType="transfer"): sender→recipient darhol (immediate)
  transferAmount    Decimal?  @db.Decimal(18, 2)
  transferCurrency  String?                                    // "UZS" | "USD"
  transferRef       String?                                    // WalletTransaction ref (xfer:UUID)
  transferNote      String?                                    // izoh (<= 120)
  // Agent xabari (mediaType="agent")
  agentKind         String?                                    // "product-review"|"support-status"|"pay-tx"|...
  agentPayload      Json?                                      // {productId, image, title, price, requestedRating:true}
  agentActionRef    String?                                    // MarketReview.id yoki boshqa yozuv id (foydalanuvchi javob bergach yoziladi)
  // Reply — boshqa xabarga javob (Telegram uslubi)
  replyToId         String?
  // Tahrirlash
  editedAt          DateTime?
  // Emoji reaksiyalar
  reactions         NexusMessageReaction[]
  // Bookmark (per-user shaxsiy saqlash)
  bookmarks         NexusMessageBookmark[]
  // Xabarni pinga qo'yish (suhbatda global — ikkala ishtirokchi ham ko'radi)
  pinnedAt          DateTime?
  // Self-destruct: xabar shu vaqtdan keyin avtomatik o'chiriladi (NULL = doimiy)
  expiresAt         DateTime?
  // Jadvalga qo'yilgan xabar — bu vaqtga qadar suhbatda ko'rinmaydi (cron faollashtiradi)
  scheduledFor      DateTime?
  edits             NexusMessageEdit[]
  // Forward (yuborilgan) — asl yozuvchining profil ID'si (relation bez FK — profil o'chib ketsa xabar qoladi)
  forwardedFromId       String?
  forwardedFromName     String?                                    // asl yozuvchining ismi/username (snapshot)
  // Kanal/guruh'dan yuborilgan bo'lsa — kanal metadatasi (Telegram uslub)
  // forwardedFromId null bo'lsa va bu maydonlar to'la bo'lsa → "Kanaldan yuborilgan"
  forwardedChannelId     String?
  forwardedChannelName   String?
  forwardedChannelHandle String?                                   // @handle — link uchun
  // Yetkazildi — client Pusher orqali qabul qilganini serverga bildirgan vaqt.
  // NULL = hali yetmagan (offline/no push). Not-null = qurilma qabul qildi.
  deliveredAt       DateTime?
  // "Hamma uchun o'chirish" (WhatsApp uslub) — 60 daqiqa ichida yozuvchi
  // xabarni ikkalasi uchun ham o'chira oladi. Client tomon "Bu xabar
  // o'chirildi" tombstone ko'rsatadi (matn/media tozalanadi).
  deletedForEveryoneAt DateTime?
  // View-once (WhatsApp) — 1 martalik xabar. Qabul qiluvchi ochsa viewedAt yoziladi;
  // ikkinchi marta ochib bo'lmaydi. Serverdan ham matn/media null qaytadi.
  viewOnce   Boolean  @default(false)
  viewedAt   DateTime?
  // Bot inline tugmalari (Telegram uslub) — agent javobida qatorlar:
  //   [[{ text: "OK", callbackData: "ok" }, { text: "Bekor", callbackData: "cancel" }], ...]
  //   Bosilsa agent webhook'iga event="callback.query" yuboriladi.
  buttons    Json?
  // Bot invoice (to'lov so'rovi) — Telegram uslubi:
  //   { amount: number, currency: "UZS"|"USD", description: string, payload?: string }
  //   Foydalanuvchi bosgach summa agent hamyoniga o'tadi va agent webhook'iga
  //   event="invoice.paid" yuboriladi.
  invoice    Json?
  invoicePaidAt DateTime?
  // Broadcast — bu xabar broadcast list orqali fan-out qilingan bo'lsa uning ID'si
  // (WhatsApp uslub: qabul qiluvchi buni bilmaydi, oddiy DM sifatida ko'radi).
  broadcastListId String?
  // End-to-end shifrlash payload (yuboruvchi shifrlagan, server hech qachon plaintext ko'rmaydi).
  // Struktura: { ephemeralPub, iv, ciphertext, v, senderKeyId }
  // Bo'lsa: text = "" (yoki placeholder), moderatsiya, tarjima, TTS, qidiruv ishlamaydi.
  e2ePayload Json?
  // Album (Telegram uslub) — birga yuborilgan bir necha rasm/video guruhlash.
  // Bir xil albumId'ga ega ketma-ket xabarlar UI'da bitta grid bubble sifatida ko'rinadi.
  // Yuborish: /api/nexus/messages/[id]/album ↔ N ta xabar bitta albumId bilan yaratiladi.
  albumId    String?
  createdAt      DateTime          @default(now())
  @@index([conversationId, createdAt])
  @@index([conversationId, pinnedAt])
  @@index([expiresAt])
  @@index([scheduledFor])
  @@index([broadcastListId])
  @@index([albumId])
}

// DM Chat Lock (PIN) — foydalanuvchi ba'zi chatlarni PIN kod bilan yashiradi.
// Chat "Yopilgan" bo'lsa ro'yxatda ko'rinmaydi; foydalanuvchi PIN kiritsa vaqtincha ochiladi.
// pinHash: sha256(pin + ownerId) — server hech qachon raw PIN ni bilmaydi.
model NexusChatLock {
  id             String   @id @default(cuid())
  ownerId        String   @unique                    // per-user global PIN (butun locked chatlar uchun)
  pinHash        String                              // sha256 hex
  hintText       String?  @db.VarChar(80)            // ixtiyoriy eslatma matni
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([ownerId])
}

// Locked chats — qaysi peerLabels'da lock qo'yilgan.
// Locked bo'lsa (per-owner) — chat ro'yxatida yashirilgan, faqat PIN bilan ochiladi.
// PeerLabel'ga isLocked flag qo'shish o'rniga ayrim jadval — kelajakda ohorada
// per-conv lockedUntil'ni ham saqlash uchun.
model NexusLockedChat {
  id         String   @id @default(cuid())
  ownerId    String                                  // kim yashirgan
  peerId     String                                  // qaysi peer bilan chatni
  createdAt  DateTime @default(now())
  @@unique([ownerId, peerId])
  @@index([ownerId])
}

// View-once screenshot ogohlantirish — qabul qiluvchi view-once xabar ochilgan
// paytda screenshot olishga urinsa (client tomon detect qilinsa) yoziladi.
// Yuboruvchiga notif chiqadi.
model NexusScreenshotAlert {
  id         String   @id @default(cuid())
  messageId  String                                  // NexusMessage.id
  viewerId   String                                  // ko'rgan foydalanuvchi
  senderId   String                                  // yuboruvchi (notif kimga)
  detectedAt DateTime @default(now())
  @@index([senderId, detectedAt])
  @@index([messageId])
}

// Peer nickname/label (Telegram uslub) — owner uchun peer'ning maxfiy nomi.
// Faqat owner'ga ko'rinadi. Chat ro'yxatida, header'da, mention'da real ism o'rniga
// nickname chiqadi. Peer o'zi bilmaydi.
model NexusPeerLabel {
  id         String   @id @default(cuid())
  ownerId    String                              // kimning label'i (UserProfile.id)
  peerId     String                              // kimga label qo'yilgan
  nickname   String?  @db.VarChar(40)            // Maxfiy nom (masalan "Mama", "Ish")
  color      String?  @db.VarChar(20)            // rang tag: "red"|"orange"|"green"|"blue"|"purple"
  wallpaper  String?  @db.VarChar(500)           // rang preset yoki rasm URL (per-conv theme)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([ownerId, peerId])
  @@index([ownerId])
}

// Kontakt sinxronizatsiya (WhatsApp/Telegram uslub) — foydalanuvchining telefondagi
// kontaktlaridan qay biri ForHumo'da borligini topish uchun.
//
// Xavfsizlik: Raw telefon raqam serverda saqlanmaydi. Faqat SHA-256 hash (pepper bilan).
// nameHint ixtiyoriy (telefon egasining ismini foydalanuvchi ko'rsatishi uchun local hint).
model NexusContactHash {
  id         String   @id @default(cuid())
  ownerId    String                                  // kimning kontakti (UserProfile.id)
  phoneHash  String                                  // normalized phone → sha256
  nameHint   String?                                 // ownerning telefonda ko'rgan ismi (yordamchi)
  addedAt    DateTime @default(now())
  @@unique([ownerId, phoneHash])
  @@index([ownerId])
  @@index([phoneHash])
}

// End-to-end shifrlash kalitlari (Signal/WhatsApp uslub).
// Foydalanuvchi shu qurilmada kalit juftligi yaratganda public key shu jadvalga
// yuklanadi (private key faqat brauzer IndexedDB'sida qoladi). Boshqa foydalanuvchi
// shu odamga E2E DM yozganda ECDH orqali shared secret hosil qilib, AES-GCM bilan
// shifrlaydi.
//
// Algoritm: ECDH P-256 (Web Crypto SPKI base64) + AES-256-GCM.
// Kalit rotatsiya: eski kalit revokedAt bilan belgilanadi (o'chirilmaydi — eski
// xabarlarni deshifrlash uchun kerak bo'lishi mumkin).
model UserE2eKey {
  id           String    @id @default(cuid())
  profileId    String                              // UserProfile.id
  publicKey    String                              // SPKI DER, base64
  keyAlgorithm String    @default("ECDH-P256")     // kelajakda "X25519" ham
  fingerprint  String                              // SHA-256(publicKey) qisqartma — UI'da ko'rsatiladi
  deviceLabel  String?                             // "Chrome · Windows" — qaysi qurilmadan
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  @@index([profileId, revokedAt])
}

// Business profil (Instagram Business uslub) — foydalanuvchi o'zini biznes
// sifatida ko'rsatishi mumkin. Nexus profilida "Business" badge + tez amallar
// (qo'ng'iroq/email/marshrut). Buyurtma qabul qilish keyingi PR'da (booking).
//
// Kategoriya: erkin matn (foydalanuvchi kiritadi — "Kafe", "Barber", "Studio").
// Ish vaqti: haftalik jadval JSON — [{ day: 0..6, open: "09:00", close: "22:00" }].
// Yopiq kunlar shu massivda umuman bo'lmasa.
model BusinessProfile {
  id           String   @id @default(cuid())
  profileId    String   @unique                    // UserProfile.id (1:1)
  category     String                              // "Kafe", "Barber", "Fitnes studiya", ...
  subcategory  String?                             // ixtiyoriy
  address      String?                             // ko'chsa xarita bilan mos keladi
  lat          Float?                              // xarita uchun
  lng          Float?
  phone        String?                             // qo'ng'iroq tugmasi uchun (bosh telefondan alohida bo'lishi mumkin)
  email        String?                             // email tugmasi uchun
  website      String?                             // ixtiyoriy
  // Haftalik ish vaqti — [{ day: 0=Ya, 1=Du, ..., 6=Sha, open: "09:00", close: "22:00" }]
  hours        Json?
  // Statistika (kelajakda: ko'rish, bosilishlar)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([category])
}

// Aktiv sessiyalar (multi-device). Foydalanuvchi bir necha qurilmada
// login bo'lishi mumkin; har biri alohida jti (JWT ID) bilan yozib boriladi.
// Foydalanuvchi qaysi qurilmada kirganini ko'rishi va uzoqdan chiqarishi mumkin.
//
// JWT decrypt bo'lganda `jti` topilib, bu jadvalda revokedAt bo'lmagan bo'lsa
// sessiya yaroqli. Aks holda auth callback bo'sh token qaytaradi → re-login.
model AuthSession {
  id           String    @id @default(cuid())
  jti          String    @unique              // JWT identifier — token'da saqlanadi
  profileId    String                          // UserProfile.id
  deviceHint   String?                         // User-Agent qisqacha (browser + OS)
  ipHint       String?
  origin       String    @default("google")    // "google" | "qr" (kelajakda kengayadi)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())       // har jwt callback'da yangilanadi (throttled)
  revokedAt    DateTime?                       // NULL = aktiv; sana = uzoqdan chiqarilgan
  @@index([profileId, revokedAt])
  @@index([lastSeenAt])
}

// QR login (WhatsApp Web uslub). Desktop QR ko'rsatadi, telefon tasdiqlaydi,
// desktop avtomatik login bo'ladi. Google auth qoidasi buzilmaydi — bu faqat
// mavjud Google akkaunti egasi uchun qayta-kirish (re-authentication) mexanizmi.
//
// Oqim:
//   1. Desktop (anonim): POST /api/auth/qr/start  → { code, url }
//   2. Desktop QR chizadi (URL = /nexus/qr/<code>) va status'ni pollingdan boshlaydi
//   3. Telefon (login qilingan) URL'ga o'tadi → "Kirishga ruxsatmi?" tasdiqlaydi
//   4. POST /api/auth/qr/<code>/approve — status=APPROVED, approvedProfileId=me.id
//   5. Desktop pollingda "APPROVED" ko'radi → POST /api/auth/qr/<code>/consume
//   6. Server NextAuth JWT cookie'sini serverda yaratib qaytaradi → desktop reload → login
//
// TTL: 3 daqiqa (approved bo'lmasa EXPIRED). Ishlatilgan kod qayta ishlatilmaydi.
model AuthQrRequest {
  id                 String   @id @default(cuid())
  code               String   @unique              // qisqa random (12 belgi) — QR ichida
  status             String   @default("PENDING")  // PENDING | APPROVED | CONSUMED | EXPIRED
  deviceHint         String?                       // desktop UA snippet (tasdiqlashda ko'rsatiladi)
  ipHint             String?                       // ip (ma'lumot uchun)
  approvedProfileId  String?                       // kim tasdiqladi (UserProfile.id)
  approvedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime @default(now())
  expiresAt          DateTime                      // createdAt + 3 daq
  @@index([status, expiresAt])
  @@index([expiresAt])
}

// Broadcast list (WhatsApp uslub) — bir marta yozib, ro'yxatdagi barcha
// kontaktlarga individual DM tarzida yetkaziladi. Qabul qiluvchi oddiy shaxsiy
// xabar ko'radi (list mavjudligi haqida bilmaydi). Faqat egasi ro'yxatni ko'ra
// oladi va tahrirlashi mumkin.
model NexusBroadcastList {
  id         String                     @id @default(cuid())
  ownerId    String                                                  // UserProfile.id
  name       String                                                  // "Do'stlar", "Xarid mijozlari"
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  members    NexusBroadcastListMember[]
  @@index([ownerId, updatedAt])
}

model NexusBroadcastListMember {
  id         String              @id @default(cuid())
  listId     String
  list       NexusBroadcastList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  profileId  String                                                    // UserProfile.id — qabul qiluvchi
  addedAt    DateTime            @default(now())
  @@unique([listId, profileId])
  @@index([listId])
  @@index([profileId])
}

model NexusMessageReaction {
  id         String       @id @default(cuid())
  messageId  String
  message    NexusMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId  String
  emoji      String                                                         // "❤️" | "👍" | ...
  createdAt  DateTime     @default(now())
  @@unique([messageId, profileId, emoji])
  @@index([messageId])
}

// Xabar bookmark — per-user (o'z shaxsiy saqlash ro'yxati)
model NexusMessageBookmark {
  id         String       @id @default(cuid())
  messageId  String
  message    NexusMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId  String                                                         // saqlangan foydalanuvchi
  note       String?                                                        // ixtiyoriy izoh
  createdAt  DateTime     @default(now())
  @@unique([messageId, profileId])
  @@index([profileId, createdAt])
}

model NexusDmPollVote {
  id           String        @id @default(cuid())
  messageId    String
  message      NexusMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId    String
  optionIndex  Int                                         // 0-based; multi bo'lsa har variant uchun alohida yozuv
  createdAt    DateTime      @default(now())
  @@unique([messageId, profileId, optionIndex])
  @@index([messageId])
}

model NexusMessageEdit {
  id           String       @id @default(cuid())
  messageId    String
  message      NexusMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  previousText String       @db.Text
  editedAt     DateTime     @default(now())

  @@index([messageId, editedAt])
}

// ── Nexus Calls (1:1 WebRTC ovoz/video) ──────────────────────────────────────
model NexusCall {
  id          String           @id @default(cuid())
  callerId    String                                    // UserProfile.id — chaqiruvchi
  calleeId    String                                    // UserProfile.id — qabul qiluvchi
  kind        NexusCallKind    @default(AUDIO)
  status      NexusCallStatus  @default(RINGING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  endedAt     DateTime?
  duration    Int              @default(0)             // sekundlarda (acceptedAt→endedAt)
  signals     NexusCallSignal[]
  recordings  NexusCallRecording[]
  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([calleeId, status])                          // incoming poller uchun
}

model NexusCallRecording {
  id          String    @id @default(cuid())
  callId      String
  call        NexusCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  startedById String                                   // UserProfile.id — yozuvni boshlagan
  audioUrl    String                                   // Vercel Blob URL
  durationSec Int                                       // sekundlar
  sizeKb      Int                                       // kilobayt
  createdAt   DateTime  @default(now())
  @@index([callId, createdAt])
  @@index([startedById, createdAt])
}

// ── Guruh chaqiruvi (LiveKit SFU) ────────────────────────────────────────────
model NexusGroupCall {
  id           String                       @id @default(cuid())
  roomName     String                       @unique  // LiveKit room name (chaqiruv id + prefix)
  title        String?                                // ixtiyoriy nom
  hostId       String                                 // UserProfile.id — yaratuvchi
  // Guruh voice chat (Telegram uslub) — bog'langan bo'lsa, guruhda banner ko'rinadi.
  // NULL = standalone chaqiruv (DM). Non-null = guruh voice chat.
  channelId    String?
  status       NexusGroupCallStatus         @default(ACTIVE)
  createdAt    DateTime                     @default(now())
  endedAt      DateTime?
  participants NexusGroupCallParticipant[]
  recordings   NexusGroupCallRecording[]
  @@index([hostId, createdAt])
  @@index([status, createdAt])
}

model NexusGroupCallRecording {
  id            String         @id @default(cuid())
  groupCallId   String
  groupCall     NexusGroupCall @relation(fields: [groupCallId], references: [id], onDelete: Cascade)
  startedById   String                                   // UserProfile.id
  audioUrl      String                                   // Vercel Blob
  durationSec   Int
  sizeKb        Int
  createdAt     DateTime       @default(now())
  @@index([groupCallId, createdAt])
  @@index([startedById, createdAt])
}

model NexusGroupCallParticipant {
  id          String         @id @default(cuid())
  groupCallId String
  groupCall   NexusGroupCall @relation(fields: [groupCallId], references: [id], onDelete: Cascade)
  profileId   String                                     // UserProfile.id
  role        NexusGroupCallRole @default(GUEST)
  joinedAt    DateTime       @default(now())
  leftAt      DateTime?
  @@unique([groupCallId, profileId])
  @@index([profileId, joinedAt])
