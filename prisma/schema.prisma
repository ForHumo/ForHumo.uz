enum NexusGroupCallStatus {
  ACTIVE
  ENDED
}

enum NexusGroupCallRole {
  HOST
  GUEST
}

model NexusCallSignal {
  id        String    @id @default(cuid())
  callId    String
  call      NexusCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  fromId    String                                     // UserProfile.id — yuboruvchi peer
  kind      String                                     // "offer" | "answer" | "ice"
  payload   String    @db.Text                         // JSON: SDP yoki ICE candidate
  createdAt DateTime  @default(now())
  @@index([callId, createdAt])
}

enum NexusCallKind {
  AUDIO
  VIDEO
}

enum NexusCallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

// ── Nexus Video — to'liq video (LONG) va Shorts (SHORT) ──────────────────────
model NexusVideo {
  id          String         @id @default(cuid())
  profileId   String                                // kanal / yuklovchi
  title       String
  description String?                               // cheksiz uzunlik
  videoUrl    String                                // Vercel Blob MP4 URL
  thumbUrl    String?                               // muqova (custom yoki client thumbnail)
  durationSec Int            @default(0)
  kind        NexusVideoKind @default(LONG)
  orientation NexusVideoOrientation @default(HORIZONTAL)  // G.Video (gorizontal) / V.Video (vertikal)
  width       Int?                                  // video o'lchami — orientation aniqlash
  height      Int?
  category    String?                               // kino / musiqa / gaming ...
  tags        String[]                              // foydalanuvchi #teglari (cheksiz)
  descImages  String[]                              // tavsifdagi dalil rasmlari
  isMature    Boolean        @default(false)        // 18+ — voyaga yetmaganlardan yashiriladi
  price       Int            @default(0) @map("priceZij")  // 0 = bepul, >0 = pullik (priceCurrency valyutasida)
  priceCurrency Currency     @default(UZS)
  prevVideoId String?                               // series — avvalgi qism (joylangan bo'lishi shart)
  prevVideo   NexusVideo?    @relation("VideoSeries", fields: [prevVideoId], references: [id], onDelete: SetNull)
  nextParts   NexusVideo[]   @relation("VideoSeries")
  views       Int            @default(0)
  hidden      Boolean        @default(false)         // moderatsiya
  createdAt   DateTime       @default(now())
  likes       NexusVideoLike[]
  comments    NexusVideoComment[]
  purchases   NexusVideoPurchase[]
  @@index([kind, createdAt])
  @@index([orientation, createdAt])
  @@index([profileId, createdAt])
}

enum NexusVideoKind {
  LONG
  SHORT
}

enum NexusVideoOrientation {
  HORIZONTAL    // G.Video
  VERTICAL      // V.Video (reels)
}

model NexusVideoView {
  id        String   @id @default(cuid())
  videoId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([videoId, profileId])
  @@index([videoId])
}

model NexusVideoLike {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime   @default(now())
  @@unique([videoId, profileId])
}

model NexusVideoComment {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  hidden    Boolean    @default(false)   // moderatsiya
  createdAt DateTime   @default(now())
  @@index([videoId, createdAt])
}

// ── Nexus Live — jonli efirlar ───────────────────────────────────────────────
// Faza 1: lifecycle + chat + ko'ruvchi heartbeat. Video transport keyingi faza.
model NexusLiveStream {
  id          String           @id @default(cuid())
  profileId   String                                  // streamer
  title       String
  description String?                                  // ixtiyoriy tavsif
  thumbUrl    String?                                  // custom kover (yoki tugagach avto-thumb)
  category    String?
  privacy     NexusLivePrivacy @default(PUBLIC)
  status      NexusLiveStatus  @default(LIVE)
  scheduledAt DateTime?                               // UPCOMING uchun
  startedAt   DateTime?
  endedAt     DateTime?
  peakViewers Int              @default(0)
  likes       Int              @default(0)
  hidden      Boolean          @default(false)      // moderatsiya — yashirilgan efir

  // Studio composition
  sceneLayout String?                                 // "solo"|"screen"|"pip"|"podcast"|"custom"
  sourceMic   Boolean          @default(true)         // mikrofon yoqilganmi
  sourceCam   Boolean          @default(true)         // kamera yoqilganmi
  sourceScreen Boolean         @default(false)        // ekran ko'rsatish yoqilganmi

  // Recording — tugagandan keyin qayta ko'rish uchun (VOD)
  recordingUrl String?                                // Vercel Blob VOD (webm/mp4)
  recordingDurationSec Int?                           // yozuv uzunligi

  // Batch M — Chat moderation (real)
  bannedUserIds  String[] @default([])                // bloklangan foydalanuvchi profileId'lari
  slowSeconds    Int      @default(0)                 // slow mode (0 = o'chiq)
  followersOnly  Boolean  @default(false)             // faqat kuzatuvchilar chat yozadi
  // Batch CD — Chat moderators (streamer tomonidan ruxsat)
  moderatorIds   String[] @default([])                // moderator profile IDs
  // Batch R — Ban words filter
  bannedWords    String[] @default([])                // taqiqlangan so'zlar (lowercased)
  // Batch T — Raid: efir tugagach viewerlarni yo'naltirish
  raidToUsername String?                              // /nexus/u/<username> ga raid
  // Batch W — Custom watermark (VOD canvas'da chizilaki)
  watermarkUrl   String?                              // logo URL (Vercel Blob)
  // Batch AA — Donation goal
  donationGoal      Int?                              // target summa (streamer valyutasida)
  donationGoalLabel String?                           // "Yangi mikrofon", "Studio jihoz" etc.
  // Batch AL — Custom sound alert (tip received)
  soundAlertUrl     String?                           // audio URL (Vercel Blob, mp3/wav)

  createdAt   DateTime         @default(now())
  messages    NexusLiveMessage[]
  reminders   NexusLiveReminder[]
  clips       NexusLiveClip[]
  guests      NexusLiveGuest[]
  @@index([status, createdAt])
  @@index([profileId, createdAt])
}

// Batch N — Rejalashtirilgan efir eslatmasi + push
model NexusLiveReminder {
  id         String   @id @default(cuid())
  streamId   String
  stream     NexusLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  profileId  String
  createdAt  DateTime @default(now())
  notified   Boolean  @default(false)                 // push yuborilganmi
  @@unique([streamId, profileId])
  @@index([profileId, createdAt])
}

// Batch I — VOD qirqim (highlight/clip) — timestamp-based (fayl emas, aqlli reference)
model NexusLiveClip {
  id         String   @id @default(cuid())
  streamId   String
  stream     NexusLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  profileId  String                                    // qirqim yaratuvchisi (streamer yoki viewer)
  title      String
  startSec   Int                                       // VOD ichidagi boshlanish (sec)
  endSec     Int                                       // tugash — max 60 sek
  plays      Int      @default(0)
  likes      Int      @default(0)
  hidden     Boolean  @default(false)                  // moderatsiya
  createdAt  DateTime @default(now())
  likesList  NexusLiveClipLike[]
  @@index([streamId, createdAt])
  @@index([profileId, createdAt])
}

// Batch AB — Clip likes (dublikatsiz)
model NexusLiveClipLike {
  id         String   @id @default(cuid())
  clipId     String
  clip       NexusLiveClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  profileId  String
  createdAt  DateTime @default(now())
  @@unique([clipId, profileId])
  @@index([profileId, createdAt])
}

// Batch H — Multi-guest co-host (2+ streamer)
model NexusLiveGuest {
  id             String   @id @default(cuid())
  streamId       String
  stream         NexusLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  guestProfileId String                                  // guest streamer profileId
  status         NexusLiveGuestStatus @default(APPROVED) // APPROVED = publish qila oladi
  invitedAt      DateTime @default(now())
  joinedAt       DateTime?                               // birinchi marta LiveKit'ga ulanganda
  leftAt         DateTime?                               // chiqib ketganda
  @@unique([streamId, guestProfileId])
  @@index([streamId, status])
}

enum NexusLiveGuestStatus {
  APPROVED
  LEFT
  KICKED
}

// Batch AM — Streamer paneli (bio/socials/sponsors/schedule/custom)
// Per-streamer (efirlar orasida qoladi)
model NexusLivePanel {
  id         String   @id @default(cuid())
  profileId  String                                    // egasi
  kind       String   @default("CUSTOM")               // BIO/SOCIALS/SCHEDULE/SPONSOR/CUSTOM
  title      String
  content    String   @db.Text                         // markdown (500 char)
  imageUrl   String?                                   // ixtiyoriy rasm
  linkUrl    String?                                   // ixtiyoriy link
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  @@index([profileId, order])
}

// Batch AF — Recurring stream schedule (streamer haftalik/one-time rejasi)
model NexusLiveSchedule {
  id         String   @id @default(cuid())
  profileId  String                                    // egasi
  kind       String   @default("RECURRING")            // RECURRING | ONETIME
  dayOfWeek  Int?                                      // 0-6 (yakshanba=0), faqat RECURRING uchun
  dateISO    String?                                   // "2026-08-30" ONETIME uchun
  hour       Int                                       // 0-23
  minute     Int                                       // 0-59
  title      String
  category   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@index([profileId, active])
}

// Batch AJ — Streamer subscription (viewer streamer'ga oylik obuna)
model NexusLiveSub {
  id            String   @id @default(cuid())
  subscriberId  String                                  // kim obuna
  streamerId    String                                  // kimga
  tier          String   @default("SUPPORTER")          // SUPPORTER / GOLD / PLATINUM
  monthlyPrice  Int                                     // valyutada (streamer valyutasi)
  currency      String   @default("UZS")                // UZS/USD
  startedAt     DateTime @default(now())
  expiresAt     DateTime                                // startedAt + 30 kun
  active        Boolean  @default(true)
  wasCancelled  Boolean  @default(false)
  @@unique([subscriberId, streamerId])
  @@index([streamerId, active, expiresAt])
  @@index([subscriberId, active])
}

// Batch CR — Custom chat commands (streamer !cmd → response)
model NexusLiveCommand {
  id         String   @id @default(cuid())
  profileId  String                                    // streamer
  name       String                                    // !discord, !music (lowercased, no !)
  response   String                                    // matn javob (300 char)
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())
  @@unique([profileId, name])
  @@index([profileId, createdAt])
}

// Batch AK — Poll templates (streamer qayta ishlatishi uchun)
model NexusLivePollTemplate {
  id            String   @id @default(cuid())
  profileId     String
  question      String
  options       String[]
  durationSec   Int      @default(60)
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())
  @@index([profileId, createdAt])
}

// Batch AI — Custom emotes (streamer o'z chat'i uchun rasm emotelar)
model NexusLiveEmote {
  id         String   @id @default(cuid())
  profileId  String                                    // egasi (streamer)
  name       String                                    // :haha:, :hitme: etc.
  imageUrl   String                                    // Vercel Blob (100x100 PNG)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  @@unique([profileId, name])
  @@index([profileId, order])
}

enum NexusLiveStatus {
  UPCOMING
  LIVE
  ENDED
}

enum NexusLivePrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}

model NexusLiveMessage {
  id        String          @id @default(cuid())
  streamId  String
  stream    NexusLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  profileId String
  text      String
  tipAmount Int             @default(0) @map("tipZij")  // > 0 bo'lsa — Super Chat (pulli, ajratilgan)
  hidden    Boolean         @default(false)        // moderatsiya
  createdAt DateTime        @default(now())
  @@index([streamId, createdAt])
}

// Tip / donat — ijodkorni qo'llab-quvvatlash. Zij donor→ijodkor o'tadi (komissiyasiz).
model NexusTip {
  id          String      @id @default(cuid())
  donorId     String                              // kim yubordi (UserProfile.id)
  recipientId String                              // ijodkor
  amount      Int            @map("amountZij")    // miqdor (currency valyutasida)
  currency    Currency       @default(UZS)
  targetType  NexusTipTarget @default(PROFILE)    // nimaga: profil/post/video/jonli
  targetId    String?                             // tegishli kontent id (PROFILE uchun null)
  message     String?                             // ixtiyoriy izoh (Super Chat matni)
  createdAt   DateTime    @default(now())
  @@index([recipientId, createdAt])
  @@index([donorId, createdAt])
}

enum NexusTipTarget {
  PROFILE
  POST
  VIDEO
  LIVE
}

// ── Kanallar va Guruhlar ─────────────────────────────────────────────────────
// CHANNEL — bir tomonlama e'lon (faqat admin yozadi, a'zolar o'qiydi).
// GROUP   — ko'p a'zoli suhbat (a'zolar yozadi).
model NexusChannel {
  id          String   @id @default(cuid())
  ownerId     String                              // yaratuvchi (UserProfile.id)
  type        NexusChannelType @default(CHANNEL)
  name        String
  handle      String?  @unique                    // @handle (ixtiyoriy, ommaviy uchun)
  description String?
  avatarUrl   String?
  isPrivate   Boolean  @default(false)            // private = faqat taklif/havola bilan
  memberCount Int      @default(1)
  hidden      Boolean  @default(false)            // moderatsiya
  // Guruh qoidalari (Markdown qo'llab-quvvatlaydi). Guruh haqida modal'da ko'rsatiladi.
  rules       String?  @db.Text
  // Cover rasm (guruh sahifasi ustki banner uchun) — ixtiyoriy.
  coverUrl    String?
  // Slow mode — xabar yuborish tezligini cheklash (guruh uchun anti-spam).
  // 0 = o'chirilgan. > 0 = har user shu sekunddan tez xabar yuborolmaydi.
  slowModeSeconds Int  @default(0)
  // Rasmiy For Humo tizim kanal/guruhi — har foydalanuvchida majburiy,
  // o'chirilmaydi, chiqib bo'lmaydi. Faqat mute qilinishi mumkin.
  isSystem    Boolean  @default(false)
  // Kanal komment (Telegram uslub) — CHANNEL tipida foydalanuvchilar
  // top-level xabar yozolmaydi, lekin izoh (replyToId) yozishi mumkin.
  // GROUP uchun ta'siri yo'q — u yerda hamma default yozadi.
  allowComments Boolean @default(false)
  // Guruh sozlamalari — kim nima qila oladi (default a'zolar uchun).
  // JSON: { sendMessages: true, sendMedia: true, sendLinks: true, embedLinks: true,
  //         addMembers: false, pinMessages: false, changeInfo: false }
  // NULL = default (hammasi ochiq). Owner/admin har doim to'liq huquqli.
  defaultPermissions Json?
  // Auto-delete: guruh xabarlari shu sekunddan keyin avtomatik o'chadi (kunlik cron).
  // 0 = o'chirilgan. Owner sozlaydi.
  autoDeleteAfterSeconds Int @default(0)
  // Restrict forwarding (Telegram uslubi) — TRUE bo'lsa xabarlarni boshqa suhbatga
  // forward qilib bo'lmaydi (anti-leak).
  restrictForwarding Boolean @default(false)
  // AI moderator — TRUE bo'lsa har yangi xabar Gemini bilan tekshiriladi.
  // Toksik/nafrat topilsa avto-yashiriladi va admin jurnaliga yoziladi.
  aiModerator Boolean @default(false)
  // Auto-translate — a'zoning tili guruhdan farq qilsa Gemini avto-tarjima qiladi.
  // Client tomon per-message "Tarjima" tugma bilan qo'lda ham ishlatiladi.
  autoTranslate Boolean @default(false)
  // Tashqi manba bog'lanishi — guruh avtomatik boshqa modulga sinxronlanadi.
  // esTeamId != null → EsTeam a'zolari bilan sinxron; systemOwned=true bo'lsa
  // owner yo'q, sozlamalar/a'zolar tashqi manba orqali boshqariladi.
  esTeamId    String?  @unique
  // Turnir chat (Humo eSport turnirlariga bog'langan) — avto post + a'zolar sync.
  esTournamentId String? @unique
  // Match chat (individual bracket o'yini) — 2 jamoa a'zolari + arxiv oxirida.
  esMatchId      String? @unique
  systemOwned Boolean @default(false)
  // Kanal post signature (Telegram Channel uslubi) — postlar ostida "by @admin" chiqarish.
  // TRUE = ko'rinadi, FALSE = anonim (owner/admin ismisiz, faqat kanal). GROUP'da ta'siri yo'q.
  signaturesEnabled Boolean @default(true)
  // Kanal ruxsat etilgan reaksiyalar to'plami (Telegram Channel uslubi).
  // Bo'sh = default 8 ta emoji. Faqat CHANNEL uchun mazmunli.
  allowedReactions String[] @default([])
  // Discussion linki (Telegram Channel Discussion Group uslubi).
  // Kanal xabarlariga izoh yozish uchun bog'langan guruh ID'si.
  // Kanal a'zolari "Muhokama" tugmasi orqali guruhga o'tishi mumkin.
  discussionGroupId String?
  // Sponsored slot (kelajak monetizatsiya) — TRUE bo'lsa kanal owner reklama qabul qiladi.
  // Sponsored postlar alohida `sponsored` flagi bilan yuboriladi.
  sponsoredEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  members     NexusChannelMember[]
  messages    NexusChannelMessage[]
  invites     NexusChannelInvite[]
  bans        NexusChannelBan[]
  joinRequests NexusChannelJoinRequest[]
  audits      NexusChannelAudit[]
  stories     NexusChannelStory[]
  topics      NexusChannelTopic[]
  bots        NexusChannelBot[]
  @@index([type, isPrivate, createdAt])
}

// Havola bilan qo'shilish (guruh/kanal)
model NexusChannelInvite {
  id         String       @id @default(cuid())
  channelId  String
  channel    NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  code       String       @unique      // qisqa, unik (base32 ~10 belgi)
  createdById String                    // yaratuvchi profileId
  expiresAt  DateTime?                  // NULL = doimiy
  maxUses    Int?                       // NULL = cheklovsiz
  usesCount  Int          @default(0)
  revokedAt  DateTime?                  // egasi bekor qilgan
  createdAt  DateTime     @default(now())
  @@index([channelId])
  @@index([code])
}

enum NexusChannelType {
  CHANNEL
  GROUP
}

model NexusChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  profileId String
  role      NexusChannelRole @default(MEMBER)
  lastReadAt DateTime?
  joinedAt  DateTime @default(now())
  // Per-member permission override (NULL = guruh default'iga tayanadi).
  // Muted/restricted user'lar uchun individual cheklov (Telegram uslub).
  permissions Json?
  // Slow mode kuzatuvi — oxirgi xabar vaqti (spam cheklovi uchun).
  lastMsgAt DateTime?
  // Anonim admin (Telegram uslub) — faqat OWNER/ADMIN uchun mazmunli.
  // TRUE bo'lsa: yozgan xabarlarda sender ismi o'rniga guruh nomi ko'rinadi,
  // avatar o'rniga guruh avatari. Real senderId serverda saqlanadi (moderatsiya uchun).
  isAnonymous Boolean @default(false)
  // Per-user mute (WhatsApp/Telegram uslub) — bu foydalanuvchi shu guruh/kanal uchun
  // push xabarnomani cho'zib qo'ygan vaqti. NULL = xabarnoma yoqilgan.
  mutedUntil DateTime?
  @@unique([channelId, profileId])
  @@index([profileId])
}

enum NexusChannelRole {
  OWNER
  ADMIN
  MEMBER
}

// Ban — guruh/kanaldan doimiy chetlashtirilgan profil.
// Kick faqat chiqaradi; Ban qayta kirishga to'sqinlik qiladi.
model NexusChannelBan {
  id         String       @id @default(cuid())
  channelId  String
  channel    NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  profileId  String                                 // ban qilingan foydalanuvchi
  bannedById String                                 // kim ban qilgan (owner/admin)
  reason     String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())
  @@unique([channelId, profileId])
  @@index([profileId])
}

// Kirish so'rovi — private guruhga qo'shilish uchun (Telegram uslub).
// Owner/admin approve → NexusChannelMember yaratiladi; reject → so'rov o'chiriladi.
model NexusChannelJoinRequest {
  id         String       @id @default(cuid())
  channelId  String
  channel    NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  profileId  String
  message    String?      @db.VarChar(300)          // ixtiyoriy izoh
  status     NexusJoinRequestStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  decidedAt  DateTime?
  decidedById String?
  @@unique([channelId, profileId])
  @@index([channelId, status])
}

enum NexusJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Guruh stories (Telegram 2024 uslub) — 24 soatlik jonli hikoya.
model NexusChannelStory {
  id         String       @id @default(cuid())
  channelId  String
  channel    NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId   String                                 // yaratuvchi (a'zo)
  mediaUrl   String                                 // rasm/video URL (Blob)
  mediaType  String                                 // "image" | "video"
  caption    String?      @db.VarChar(500)
  expiresAt  DateTime                               // yaratilgan + 24h
  createdAt  DateTime     @default(now())
  views      NexusChannelStoryView[]
  @@index([channelId, expiresAt])
}

model NexusChannelStoryView {
  id        String              @id @default(cuid())
  storyId   String
  story     NexusChannelStory   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  profileId String
  viewedAt  DateTime            @default(now())
  @@unique([storyId, profileId])
  @@index([storyId])
}

// Topics/Forums (Telegram uslub) — bitta guruh ichida bir necha mavzu.
// NexusChannelMessage.topicId (optional) — mavzuga tegishli xabarlar.
// NULL = umumiy chat (General).
model NexusChannelTopic {
  id          String       @id @default(cuid())
  channelId   String
  channel     NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(80)
  icon        String?                                // emoji yoki lucide nomi
  closed      Boolean      @default(false)           // faqat admin yozadi
  createdById String
  createdAt   DateTime     @default(now())
  @@index([channelId])
}

// Guruh boti (agents kengaytmasi) — bot guruhga a'zo qilinganda.
// Guruhda /slash buyruq bilan ishlaydi yoki har xabarda tinglaydi.
model NexusChannelBot {
  id         String       @id @default(cuid())
  channelId  String
  channel    NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agentId    String                                 // NexusAgent.id
  addedById  String                                 // qo'shgan foydalanuvchi
  // Auto-listen: TRUE bo'lsa bot HAR xabarni oladi (moderator uchun).
  // FALSE = faqat /command yoki @mention orqali chaqiriladi.
  autoListen Boolean      @default(false)
  createdAt  DateTime     @default(now())
  @@unique([channelId, agentId])
  @@index([channelId])
}

// Admin audit log — kim qachon nima qilgan (Telegram admin log naqshi).
model NexusChannelAudit {
  id         String       @id @default(cuid())
  channelId  String
  channel    NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  actorId    String                                 // amal qilgan admin/owner
  targetId   String?                                // ta'sirlangan profil (agar bor bo'lsa)
  action     String                                 // "kick"|"ban"|"unban"|"promote"|"demote"|"pin"|"unpin"|"delete-msg"|"change-info"|"approve-join"|"reject-join"|"slow-mode"|"auto-delete"|"restrict-fwd"
  detail     String?      @db.VarChar(500)          // qo'shimcha izoh (JSON yoki matn)
  createdAt  DateTime     @default(now())
  @@index([channelId, createdAt])
}

model NexusChannelMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   NexusChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  // Anonim rejimda yuborilganmi (snapshot — keyingi role o'zgarishlar bu xabarga ta'sir qilmasin)
  anonymous Boolean  @default(false)
  text      String?
  media     String[] @default([])
  hidden    Boolean  @default(false)
  // Xabarni pinga qo'yish (kanal/guruhda global — a'zolar ko'radi)
  pinnedAt  DateTime?
  // Tahrirlash vaqti (foydalanuvchi o'z xabarini tahrirlagan bo'lsa)
  editedAt  DateTime?
  // Reply — boshqa xabarga javob (shu kanalda)
  replyToId String?
  // So'rovnoma (Telegram uslubi) — foydalanuvchi so'rovi bo'yicha
  pollQuestion  String?
  pollOptions   String[]  @default([])
  pollExpiresAt DateTime?
  pollMulti     Boolean   @default(false)
  pollVotes     NexusChannelPollVote[]
  reactions     NexusChannelMessageReaction[]
  bookmarks     NexusChannelMessageBookmark[]
  edits         NexusChannelMessageEdit[]
  // Ko'rilgan (Telegram uslub) — noyob foydalanuvchilar soni. NexusChannelMessageView'dan
  // atomik yangilanadi (unique constraint bilan dedup).
  viewCount     Int      @default(0)
  views         NexusChannelMessageView[]
  // Jadvalga qo'yilgan xabar (Telegram uslub) — bu vaqtga qadar kanal xabarlarida
  // ko'rinmaydi (faqat yozuvchi ko'radi, draft-like). Kunlik cron faollashtiradi.
  scheduledFor  DateTime?
  // Rich media (voice/video-circle/location/contact) — DM bilan bir xil naqsh.
  // media[] massivi asosiy media, mediaType metadata.
  mediaType    String?                                    // "image" | "video" | "audio" | "file" | "video-circle" | "location" | "contact"
  mediaMime    String?
  mediaName    String?
  mediaSize    Int?
  durationMs   Int?                                       // audio/video davomiyligi
  // Location (mediaType="location")
  locLat       Float?
  locLng       Float?
  locUpdatedAt DateTime?
  locExpiresAt DateTime?                                  // NULL=static, else jonli
  // Contact card (mediaType="contact")
  contactName     String?
  contactPhone    String?
  contactUsername String?                                 // @username agar Humo foydalanuvchi
  // Delete for everyone (60 daq oynada) — hamma uchun o'chirilgan
  deletedForEveryoneAt DateTime?
  // Ijodkorning boshqa formatlariga havola (post/video/live/track) — cross-post
  // Rendering paytida play tugma + link avtomatik ko'rinadi.
  linkedType  String?   // "post" | "video" | "live" | "track"
  linkedId    String?
  linkedTitle String?
  linkedThumb String?
  // View once (WhatsApp uslubi) — 1 martalik
  viewOnce  Boolean  @default(false)
  // @mentions — profileId lari (push xabarnoma uchun)
  mentions  String[] @default([])
  // Topic (Telegram Forums) — NULL = umumiy chat, else topic ID.
  topicId   String?
  // Signature snapshot (kanal posti yuborilgan vaqtdagi signaturesEnabled qiymati).
  // TRUE = post ostida sender ismi ko'rinadi, FALSE = anonim ("by <kanal>").
  signaturePosted Boolean @default(true)
  // Sponsored post (kelajak monetizatsiya) — TRUE bo'lsa reklama badge chiqadi.
  // Faqat sponsoredEnabled=true kanallarda ruxsat.
  sponsored Boolean @default(false)
  // Reklama chegara (URL — yakuniy manzil, agar sponsored bo'lsa).
  sponsoredUrl String?
  createdAt DateTime @default(now())
  @@index([channelId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([scheduledFor])
  @@index([channelId, mediaType])
  @@index([channelId, topicId])
}

// View-once — bir xil profil bir xil xabarni faqat 1 marta ko'radi.
// Server GET javobida ochilgan a'zolarga media/text=null qaytariladi.
model NexusChannelMessageViewOnceOpen {
  id        String              @id @default(cuid())
  messageId String
  profileId String
  openedAt  DateTime            @default(now())
  @@unique([messageId, profileId])
  @@index([messageId])
}

// Ko'rish yozuvi — bir xil profil bir xil xabarga faqat 1 marta hisoblanadi (unique).
model NexusChannelMessageView {
  id        String              @id @default(cuid())
  messageId String
  message   NexusChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId String
  viewedAt  DateTime            @default(now())
  @@unique([messageId, profileId])
  @@index([messageId])
}

model NexusChannelMessageEdit {
  id           String              @id @default(cuid())
  messageId    String
  message      NexusChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  previousText String              @db.Text
  editedAt     DateTime            @default(now())

  @@index([messageId, editedAt])
}

model NexusChannelPollVote {
  id          String              @id @default(cuid())
  messageId   String
  message     NexusChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId   String
  optionIndex Int
  createdAt   DateTime            @default(now())
  @@unique([messageId, profileId, optionIndex])
  @@index([messageId])
}

// Kanal/guruh xabariga emoji reaksiya (per-user)
model NexusChannelMessageReaction {
  id         String              @id @default(cuid())
  messageId  String
  message    NexusChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId  String
  emoji      String
  createdAt  DateTime            @default(now())
  @@unique([messageId, profileId, emoji])
  @@index([messageId])
}

// Kanal xabari bookmark — per-user (shaxsiy saqlash)
model NexusChannelMessageBookmark {
  id         String              @id @default(cuid())
  messageId  String
  message    NexusChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId  String
  note       String?
  createdAt  DateTime            @default(now())
  @@unique([messageId, profileId])
  @@index([profileId, createdAt])
}

// Web Push obunasi — brauzer push bildirishnomalari uchun (VAPID).
model NexusPushSub {
  id        String   @id @default(cuid())
  profileId String                              // egasi (UserProfile.id)
  endpoint  String   @unique                    // push service endpoint
  p256dh    String                              // kalit
  auth      String                              // kalit
  createdAt DateTime @default(now())
  @@index([profileId])
}

// Humo ID SSO — "Humo ID bilan kirish". Foydalanuvchi rozilik bergach qisqa muddatli
// kod yaratiladi; hamkor uni server-aro (HMAC) profilga almashtiradi (OAuth code-flow uslubi).
model HumoSsoCode {
  id          String   @id @default(cuid())
  code        String   @unique               // tasodifiy kod (token exchange uchun)
  profileId   String                          // rozilik bergan foydalanuvchi (UserProfile.id)
  clientId    String                          // hamkor ilova id
  redirectUri String                          // tasdiqlangan redirect
  scope       String                          // bo'sh bilan ajratilgan: profile email nexus
  expiresAt   DateTime                        // 5 daqiqa
  usedAt      DateTime?                       // bir martalik
  createdAt   DateTime @default(now())
  @@index([profileId, createdAt])
}

// Verifikatsiya arizasi — ijodkor ko'k belgi so'raydi; founder ko'rib chiqadi.
model NexusVerifyRequest {
  id          String   @id @default(cuid())
  profileId   String   @unique                  // ariza beruvchi (UserProfile.id)
  fullName    String                             // haqiqiy ism
  category    String                             // kim: bloger/musiqachi/brend/jurnalist...
  reason      String                             // nega tasdiqlanishi kerak
  links       String[] @default([])              // ijtimoiy tarmoq/manba havolalari
  status      NexusVerifyStatus @default(PENDING)
  reviewedBy  String?                            // founder profileId
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([status, createdAt])
}

enum NexusVerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pullik obuna — obunachi ijodkorga oylik Zij to'laydi, expiresAt gacha SUBSCRIBERS kontent ochiq.
// Avto-uzaytirish yo'q (karta yo'q): obuna = 30 kunlik oldindan to'lov, qo'lda yangilanadi.
model NexusSubscription {
  id           String   @id @default(cuid())
  subscriberId String                              // obunachi (UserProfile.id)
  creatorId    String                              // ijodkor
  price        Int            @map("priceZij")    // to'langan oylik narx (obuna paytida qotiriladi)
  currency     Currency       @default(UZS)
  startedAt    DateTime @default(now())
  expiresAt    DateTime                            // shu vaqtgacha faol
  expiryNotifiedAt DateTime?                       // tugashga yaqin bildirishnoma yuborilgan vaqt
  createdAt    DateTime @default(now())
  @@unique([subscriberId, creatorId])
  @@index([expiresAt])
  @@index([subscriberId, expiresAt])
  @@index([creatorId, expiresAt])
}

// Jonli ko'ruvchi — heartbeat (lastSeenAt > now-30s = onlayn)
model NexusLiveViewer {
  id         String   @id @default(cuid())
  streamId   String
  profileId  String
  lastSeenAt DateTime @default(now())
  @@unique([streamId, profileId])
  @@index([streamId, lastSeenAt])
}

// Pullik video xaridi — Zij avtorning hamyoniga tushadi
model NexusVideoPurchase {
  id        String     @id @default(cuid())
  videoId   String
  video     NexusVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  buyerId   String                                  // UserProfile id
  price     Int            @map("priceZij")        // to'langan summa
  createdAt DateTime   @default(now())
  @@unique([videoId, buyerId])
  @@index([buyerId, createdAt])
}

// "Keyinroq ko'rish" ro'yxati
model NexusWatchLater {
  id        String   @id @default(cuid())
  profileId String
  videoId   String
  createdAt DateTime @default(now())
  @@unique([profileId, videoId])
  @@index([profileId, createdAt])
}

// ── Nexus Media — audio treklar (musiqa / podkast / audiokitob) ──────────────
model NexusTrack {
  id          String         @id @default(cuid())
  profileId   String                              // yuklovchi
  title       String
  artist      String?                             // ijrochi/muallif ko'rinadigan nomi
  audioUrl    String                              // Vercel Blob audio
  coverUrl    String?                             // muqova rasmi
  durationSec Int            @default(0)
  kind        NexusTrackKind @default(MUSIC)
  genre       String?
  plays       Int            @default(0)
  hidden      Boolean        @default(false)      // moderatsiya
  createdAt   DateTime       @default(now())

  // Musiqa klipi (optional) — musiqa audiosi bilan video versiya (spec: klip bilan musiqa)
  videoUrl        String?                         // Vercel Blob MP4
  videoOrientation NexusVideoOrientation?         // klip orientatsiyasi (agar bor bo'lsa)

  // Karaoke — timing bilan lyrics + instrumental (vokalsiz) audio
  hasKaraoke      Boolean  @default(false)        // lyricalar va/yoki instrumental bor
  instrumentalUrl String?                         // vokalsiz backing track (professional karaoke)
  lyricsSource    String?                         // xom LRC yoki plain matn (kelajakda tahrirlash uchun)

  likes        NexusTrackLike[]
  lyricsLines  NexusTrackLyricLine[]
  performances NexusKaraokePerformance[] @relation("KaraokeTrack")

  @@index([kind, createdAt])
  @@index([kind, plays])
  @@index([profileId, createdAt])
}

// LRC formatidan parse qilingan timing lyrics (line-by-line)
// Har qator: `timeMs` (boshlanish millisekundida) + `text` (qator matni)
model NexusTrackLyricLine {
  id       String   @id @default(cuid())
  trackId  String
  timeMs   Int                                     // boshlanish millisekundi (audio.currentTime * 1000)
  text     String                                  // qator matni (bo'sh matn = "pauza")
  order    Int                                     // 0-based qator tartibi
  track    NexusTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, order])
  @@index([trackId, timeMs])
}

// Karaoke performance — foydalanuvchi mikrofondan yozib olgan variant
// Trek instrumentali ustidan overlayda ijodchi kuylagan audio + ball
model NexusKaraokePerformance {
  id          String   @id @default(cuid())
  trackId     String                                       // qaysi trek uchun
  profileId   String                                       // ijrochi (yozib olgan)
  audioUrl    String                                       // Vercel Blob — vokal record (webm/mp3)
  durationSec Int      @default(0)
  score       Int      @default(0)                         // 0-100 (recording coverage + energy)
  caption     String?                                       // ixtiyoriy izoh
  duetOfId    String?                                       // agar duet — asosiy performance ID
  plays       Int      @default(0)                         // tinglash soni
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  track       NexusTrack @relation("KaraokeTrack", fields: [trackId], references: [id], onDelete: Cascade)
  duetOf      NexusKaraokePerformance?  @relation("KaraokeDuet", fields: [duetOfId], references: [id], onDelete: SetNull)
  duets       NexusKaraokePerformance[] @relation("KaraokeDuet")
  likes       NexusKaraokePerformanceLike[]

  @@index([trackId, score])
  @@index([profileId, createdAt])
  @@index([createdAt])
}

model NexusKaraokePerformanceLike {
  id             String   @id @default(cuid())
  performanceId  String
  profileId      String
  createdAt      DateTime @default(now())
  performance    NexusKaraokePerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)

  @@unique([performanceId, profileId])
  @@index([profileId])
}

enum NexusTrackKind {
  MUSIC
  PODCAST
  AUDIOBOOK
}

// Tinglash — foydalanuvchi bo'yicha bir marta hisoblanadi
model NexusTrackPlay {
  id        String   @id @default(cuid())
  trackId   String
  profileId String
  createdAt DateTime @default(now())
  @@unique([trackId, profileId])
  @@index([trackId])
}

model NexusTrackLike {
  id        String     @id @default(cuid())
  trackId   String
  track     NexusTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime   @default(now())
  @@unique([trackId, profileId])
  @@index([profileId, createdAt])
}

// ── ALKH Pay — real pul hamyoni (UZS / USD) ──────────────────────────────────
//
// Endi real valyuta: O'zbekiston foydalanuvchilari so'm (UZS), xorijliklar dollar (USD).
// ("Zij" tushunchasi olib tashlandi — model nomlari ichki, foydalanuvchiga ko'rinmaydi.)
// Hozir TEST rejimda: deposit darhol tushadi, withdraw payout-so'rov yaratadi.
// MChJ + to'lov shlyuzi (Click/Payme/karta) kalitlari kelganda real ishlaydi (lib/payments).

model Wallet {
  id          String   @id @default(cuid())
  profileId   String   @unique
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hamyon valyutasidagi miqdor
  currency    String   @default("UZS")                 // UZS yoki USD (foydalanuvchi davlatidan)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]
  safes        WalletSafe[]
  payouts      PayoutRequest[]

  @@map("ZijWallet")
}

model WalletTransaction {
  id          String             @id @default(cuid())
  walletId    String
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type        TransactionType
  amount      Decimal            @db.Decimal(18, 2)   // musbat son (shu tranzaksiya valyutasida)
  currency    String             @default("UZS")      // tranzaksiya valyutasi
  balanceAfter Decimal           @db.Decimal(18, 2)   // tranzaksiyadan keyin balans

  description String?
  ref         String?            // tashqi ref (order ID, payout ID, provider txn)

  createdAt   DateTime @default(now())

  // Idempotentlik: bir hamyonda bir ref bo'yicha ikkinchi marta yozib bo'lmaydi.
  // NULL ref'lar cheklovga tushmaydi (Postgres NULL != NULL).
  @@unique([walletId, ref])
  @@map("ZijTransaction")
}

enum TransactionType {
  DEPOSIT    // pul kirish (to'lov shlyuzi orqali)
  WITHDRAW   // pul chiqish (payout)
  PURCHASE   // xarid
  REFUND     // qaytarish
  SALE       // sotuvchi daromadi (komissiya ayirilgan)
  REWARD     // mukofot / cashback
  TRANSFER_OUT  // yuborish (tip/obuna/do'stga)
  TRANSFER_IN   // qabul qilish
  SAFE_IN       // seyfga o'tkazish
  SAFE_OUT      // seyfdan chiqarish

  @@map("ZijTransactionType")
}

// Pul yechish so'rovi (payout). Test rejimda darhol "tugatilgan"; real rejimda
// to'lov shlyuzi orqali kartaga/hisobga o'tkaziladi.
model PayoutRequest {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(18, 2)
  currency    String
  method      String                              // "card" | "bank" | ...
  destination String                              // karta raqami (maskalangan) / hisob
  status      PayoutStatus @default(PENDING)
  providerRef String?                             // shlyuz tranzaksiya id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([walletId, createdAt])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Virtual seyf — maqsadli jamg'arma
model WalletSafe {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  name        String              // "Parij sayohati", "Yangi telefon" va h.k.
  emoji       String   @default("🏦")
  targetAmount Decimal @db.Decimal(18, 2)   // maqsad summa
  balance     Decimal  @default(0) @db.Decimal(18, 2)  // hozirgi balans
  isCompleted Boolean  @default(false)      // to'lgan yoki yo'q

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ZijSafe")
}

// ─────────────────────────────────────────────────────────────
// Yutuqlar (Achievement) — cross-modul (eSport + Nexus + Market + Pay)
// UserProfile.id + code bo'yicha unique — bir yutuq bir marta beriladi.
// ─────────────────────────────────────────────────────────────
model UserAchievement {
  id         String   @id @default(cuid())
  profileId  String
  code       String            // "esport.first_win", "nexus.100_followers", "market.first_sale" ...
  title      String            // ko'rsatiladigan sarlavha (til foydalanuvchi tilida bo'lishi mumkin)
  icon       String   @default("Trophy")  // Lucide icon nomi (masalan "Trophy", "Star")
  category   String            // "esport" | "nexus" | "market" | "pay" | "id"
  tier       String   @default("bronze")  // "bronze" | "silver" | "gold" | "platinum"
  meta       Json?             // qo'shimcha ma'lumot (masalan: { count: 100, tournamentId: "..." })
  earnedAt   DateTime @default(now())

  @@unique([profileId, code])
  @@index([profileId, category])
  @@index([category, earnedAt])
}

// ─────────────────────────────────────────────────────────────
// KYC (Know Your Customer) — Level 2
// Katta summalar (>10M UZS / >1000 USD) chiqarish uchun majburiy.
// Hozircha qo'lda tekshiruv (passport rasm); kelajakda avto-face API.
// ─────────────────────────────────────────────────────────────
enum KycStatus {
  PENDING     // yuborilgan, admin tekshirmoqda
  APPROVED    // tasdiqlangan → UserProfile.level = 2
  REJECTED    // rad etilgan (sabab bilan)
}

// UserBan — AI moderation tomonidan berilgan vaqtincha yoki abadiy bloklash.
// Progressiv jazo: har yangi bloklash oldingisidan uzunroq (1h → 3h → ... → forever).
// Foydalanuvchi ariza berishi mumkin (appealText); founder ko'rib chiqadi.
model UserBan {
  id           String       @id @default(cuid())
  profileId    String
  profile      UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  level        Int                                  // 0..13 (BAN_LADDER indeksi); 13 = forever
  reason       String                               // "hate_speech", "threat", "csam", "spam", "explicit", "other"
  category     String       @default("soft")        // "hard" = darhol forever (CSAM/terrorizm), "soft" = ladder bo'yicha
  contextSnippet String?                            // qisqa parcha (moderator ko'rishi uchun; ariza bo'lganda)
  aiVerdict    String?                              // "BLOCK" | "REVIEW"
  aiSeverity   Float?                               // 0-1
  aiRelationScore Int?                              // 0-100 (yaqin do'st balli)
  issuedAt     DateTime     @default(now())
  expiresAt    DateTime?                            // NULL = abadiy
  appealAt     DateTime?
  appealText   String?                              // foydalanuvchi ariza matni
  reviewedById String?                              // founder ko'rgan bo'lsa
  reviewedAt   DateTime?
  lifted       Boolean      @default(false)         // ariza tasdiqlangan bo'lsa qaytariladi
  liftReason   String?

  @@index([profileId, expiresAt])
  @@index([expiresAt])
  @@index([appealAt, reviewedAt])
}

model UserKyc {
  id           String    @id @default(cuid())
  profileId    String    @unique   // bitta foydalanuvchida bitta faol ariza
  passportUrl  String              // Vercel Blob URL — passport 1-bet skan
  selfieUrl    String?             // ixtiyoriy — passport bilan selfi (autentiklik)
  status       KycStatus @default(PENDING)
  rejectReason String?             // REJECTED bo'lsa sabab
  reviewedById String?             // admin UserProfile.id (kim ko'rdi)
  reviewedAt   DateTime?
  submittedAt  DateTime  @default(now())

  @@index([status, submittedAt])
}
// ─────────────────────────────────────────────────────────────────────────────
// BOZOR NARXIDA (BN) — For Humo loyihalaridan biri. bozornarxida.uz
// Reja: docs/BN-PLAN.md (yagona manba — o'zgarish avval o'sha faylda)
//
// ASOSIY G'OYA: Bozor = JOY, Do'kon = BIZNES.
//   BnMarket (bozor)  — jismoniy bozor (Sergeli avto, Chorsu, Malika...)
//     └── BnShop      — sotuvchining do'koni (marketId null = alohida/onlayn)
//           └── BnProduct
// Bozor hech narsa sotmaydi — u konteyner. 1 profil = 1 do'kon.
//
// UNIVERSAL KATEGORIYA: BnCategory.attributeSchema (JSON) har toifa qanday
// maydonlar kerakligini aytadi; BnProduct.attributes qiymatlarni saqlaydi.
// Shu tufayli avto/telefon/kiyim bir xil kod bilan ishlaydi.
//
// Boshqaruv: Jalol = BnAdmin OWNER (BN ichida hamma narsa).
//            Founder (Abduvoris) = tizim/kod/integratsiya.
// Komissiya: 5% (BN_COMMISSION env), naqddan olinmaydi.
// ─────────────────────────────────────────────────────────────────────────────

// ── Bozor (JOY) ──────────────────────────────────────────────────────────────
model BnMarket {
  id          String   @id @default(cuid())
  slug        String   @unique                    // "sergeli-avto-bozor"
  name        String                              // "Sergeli avtomobil bozori"
  nameRu      String?
  description String?
  city        String   @default("Toshkent")
  district    String?                             // "Sergeli tumani"
  address     String?
  lat         Float?                              // xarita
  lng         Float?
  coverUrl    String?
  logoUrl     String?
  workHours   String?                             // "Dush-Yak 08:00-18:00"
  phone       String?
  sections    String[] @default([])               // ["12-qator", "Elektronika rastasi"]
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  shopCount   Int      @default(0)                // kesh
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shops       BnShop[]

  @@index([city, isActive, order])
}

// ── Do'kon (BIZNES) ──────────────────────────────────────────────────────────
model BnShop {
  id            String         @id @default(cuid())
  profileId     String                             // UserProfile.id — bir odam ko'p do'kon ochishi mumkin (turli bozorlarda + ko'chada filiallar)
  slug          String         @unique
  // Filial uchun ota-do'kon (STANDALONE): ko'cha do'konlari bir nechta filial ochishi mumkin
  parentShopId  String?
  parent        BnShop?        @relation("ShopBranches", fields: [parentShopId], references: [id], onDelete: SetNull)
  branches      BnShop[]       @relation("ShopBranches")
  name          String
  description   String?
  logoUrl       String?
  coverUrl      String?

  // Yuridik ma'lumot (MAJBURIY — YaTT yoki MChJ)
  legalType     BnLegalType
  innNumber     String         @unique             // STIR/INN
  legalName     String                             // F.I.SH yoki MChJ to'liq nomi
  phone         String
  phoneVerified Boolean        @default(false)

  // Joylashuv
  locationType  BnLocationType
  marketId      String?
  market        BnMarket?      @relation(fields: [marketId], references: [id], onDelete: SetNull)
  marketSection String?                            // "12-qator"
  marketShopNo  String?                            // "45"
  address       String?                            // STANDALONE uchun
  city          String         @default("Toshkent")
  lat           Float?
  lng           Float?

  // Bank (payout)
  bankName      String?
  bankAccount   String?
  bankMfo       String?

  // Holat va reyting
  status        BnShopStatus   @default(PENDING)
  tier          BnShopTier     @default(NEW)
  rating        Float          @default(0)
  ratingCount   Int            @default(0)
  orderCount    Int            @default(0)
  productCount  Int            @default(0)

  // Tasdiqlanganlik (galochka) — kunlik cron hisoblaydi.
  // NONE = yo'q; RETAIL = chakana sotuvchi galochkasi; WHOLESALE = ulgurji galochka.
  // Kriteriyalar: 50/100 muvaffaqiyatli buyurtma, reyting 4.7/4.8+, rad etilgan 3/2%dan kam,
  // 90/180 kun faol, ogohlantirish/ban yo'q. Sotib olib bo'lmaydi.
  verifiedTier    BnVerifiedTier  @default(NONE)
  verifiedAt      DateTime?
  verifiedProgress Json           @default("{}")   // motivatsiya paneli uchun kesh

  // Premium tier obuna — pullik yuqori tier (Bronze/Silver/Gold/Platinum).
  // BnPremiumSubscription orqali oyiga to'lanadi. `premiumUntil > now()` = aktiv.
  premiumTier   BnPremiumTier?                     // NULL = obunasiz (default)
  premiumUntil  DateTime?

  approvedAt    DateTime?
  approvedById  String?
  rejectReason  String?
  suspendedAt   DateTime?
  suspendReason String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  products      BnProduct[]
  orders        BnOrder[]
  reviews       BnShopReview[]

  @@index([status, createdAt])
  @@index([marketId, status])
  @@index([city, status])
  @@index([profileId])
  @@index([parentShopId])
  // Bir profil bitta bozorda bitta do'kon ocha oladi (marketId null bo'lsa — ko'chada — ko'p filial ruxsat, Postgres NULLni unique dan istisno qiladi)
  @@unique([profileId, marketId])
}

enum BnLegalType {
  YATT
  MCHJ
}
enum BnLocationType {
  IN_MARKET
  STANDALONE
  ONLINE
}
enum BnShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED         // Vaqtincha muzlatilgan (ban vaqtida)
  TERMINATED        // Chiqarib yuborilgan — qayta ochib bo'lmaydi
}

// ── Ban tizim ───────────────────────────────────────────────────────────────
// Ban = profil (yoki uning do'koni) muzlatiladi. Elonlar ko'rinmaydi, foydalanuvchi
// balansidan pul yechishi mumkin. Vaqtincha (expiresAt) yoki abadiy bo'ladi.
// AI, OWNER yoki MODERATOR ban bera oladi. Faqat OWNER/MODERATOR ban olib tashlay oladi.
model BnBan {
  id           String        @id @default(cuid())
  profileId    String                                     // Kim banlangan
  shopId       String?                                    // Aynan do'kon banlansa
  scope        BnBanScope    @default(SHOP)               // PROFILE (butun BN'dan) yoki SHOP (bir do'kon)
  type         BnBanType                                  // TEMP vaqtincha, PERM abadiy
  reason       String                                     // Ichki sabab (foydalanuvchiga ko'rinmaydi to'liq)
  publicReason String?                                    // Foydalanuvchiga qisqa xabar (ixtiyoriy)
  expiresAt    DateTime?                                  // TEMP uchun
  decidedBy    BnBanDecidedBy                             // AI | OWNER | MODERATOR
  decidedById  String?                                    // OWNER/MODERATOR bo'lsa profil id
  status       BnBanStatus   @default(ACTIVE)
  liftedAt     DateTime?
  liftedById   String?
  liftReason   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([profileId, status])
  @@index([shopId, status])
  @@index([status, expiresAt])
}

enum BnBanScope {
  PROFILE
  SHOP
}
enum BnBanType {
  TEMP
  PERM
}
enum BnBanStatus {
  ACTIVE
  LIFTED
  EXPIRED
}
enum BnBanDecidedBy {
  AI
  OWNER
  MODERATOR
}

// ── Chiqarib yuborish so'rovi ────────────────────────────────────────────────
// MODERATOR yuboradi, OWNER tasdiqlaydi (yoki rad etadi). AI/OWNER to'g'ridan-to'g'ri terminate qila oladi (so'rovsiz).
model BnTerminationRequest {
  id            String                       @id @default(cuid())
  profileId     String                                                        // Kim chiqariladi (BnShop.profileId)
  shopId        String                                                        // Aynan qaysi do'kon
  reason        String                                                        // Nima uchun (batafsil)
  requestedById String                                                        // Kim yubordi (MODERATOR profil id)
  status        BnTerminationRequestStatus   @default(PENDING)
  decidedById   String?                                                       // OWNER profil id
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime                     @default(now())

  @@index([status, createdAt])
  @@index([shopId])
}

enum BnTerminationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Rekomendatsiya tizim ─────────────────────────────────────────────────────
// Foydalanuvchi hodisalari — mahsulot bilan har o'zaro ta'sir. Kunlik cron
// bularni yig'ib qiziqish vektoriga aylantiradi (BnInterest).

model BnUserEvent {
  id         String          @id @default(cuid())
  profileId  String
  productId  String
  type       BnEventType
  weight     Float           @default(1)   // signal darajasi (VIEW=1, CART=3, FAV=4, PURCHASE=10)
  createdAt  DateTime        @default(now())

  @@index([profileId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
}

enum BnEventType {
  VIEW
  CART
  FAV
  PURCHASE
}

// Foydalanuvchining qiziqish vektori — kunlik cron hisoblab yozadi.
// Cold start yoki hech qanday event yo'q bo'lsa null bo'ladi.
model BnInterest {
  id              String   @id @default(cuid())
  profileId       String   @unique
  // JSON: { "elektronika": 8.5, "kiyim": 3.2, ... } — kategoriya slug → score
  categoryScores  Json     @default("{}")
  // JSON: { "shopId1": 5.5, "shopId2": 2.1, ... }
  shopScores      Json     @default("{}")
  // JSON: { "marketId1": 4.0, ... }
  marketScores    Json     @default("{}")
  // Foydalanuvchi o'rtacha narx tanlovi
  avgPrice        Int?
  minPrice        Int?
  maxPrice        Int?
  // Foydalanuvchi ko'p ishlatgan atributlar (masalan: brand=Samsung)
  attrScores      Json     @default("{}")
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}
enum BnShopTier {
  NEW
  TRUSTED
  VERIFIED
  PREMIUM
}

enum BnVerifiedTier {
  NONE
  RETAIL      // Chakana sotuvchi galochkasi
  WHOLESALE   // Ulgurji galochkasi (retail'dan qiyinroq)
}

// ── Kategoriya (atribut sxemasi bilan — universal) ───────────────────────────
model BnCategory {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  nameRu          String?
  parentId        String?
  parent          BnCategory?  @relation("BnCatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        BnCategory[] @relation("BnCatTree")
  icon            String?                          // Lucide ikon nomi (emoji EMAS)
  attributeSchema Json         @default("[]")      // [{key,label,type,options,required,filterable}]
  order           Int          @default(0)
  isActive        Boolean      @default(true)
  productCount    Int          @default(0)         // kesh
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products        BnProduct[]

  @@index([parentId, order])
  @@index([isActive, order])
}

// ── Mahsulot ─────────────────────────────────────────────────────────────────
model BnProduct {
  id             String            @id @default(cuid())
  shopId         String
  shop           BnShop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       BnCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title          String
  slug           String            @unique
  description    String?
  images         String[]          @default([])    // maks 10
  videos         String[]          @default([])    // maks 2

  price          Int                               // so'm (butun)
  oldPrice       Int?
  isNegotiable   Boolean           @default(false) // "Kelishilgan narxda"

  attributes     Json              @default("{}")  // kategoriya sxemasiga mos qiymatlar

  stock          Int               @default(1)
  sold           Int               @default(0)

  // Olish usullari
  allowPickup    Boolean           @default(true)
  allowDelivery  Boolean           @default(false)
  allowInspect   Boolean           @default(true)  // "ko'rib sotib olish"

  // 18+ tovar (masalan ichki kiyim, kondom, sog'liq buyumlari). Xiralashtirib
  // ko'rsatiladi, foydalanuvchi tasdig'i bilan ochiladi. Diniga ZID mahsulot
  // umuman taqiqlanadi (bu flag emas — BLOCK bo'ladi).
  isMature       Boolean           @default(false)

  // Ulgurji (B2B) — faqat BN do'kon egalari ko'radi va sotib oladi.
  // wholesaleTiers = [{minQty:20,price:8000},{minQty:50,price:7500},{minQty:100,price:7000}]
  isWholesale    Boolean           @default(false)
  minWholesaleQty Int?                              // minimal buyurtma (masalan 20)
  wholesaleTiers Json              @default("[]")   // narx pog'onalari

  // Bozor narxi — BN ning asosiy va'dasi
  marketAvgPrice Int?                              // o'xshash mahsulotlar o'rtachasi
  priceRank      String?                           // "cheap" | "fair" | "expensive"
  priceCalcAt    DateTime?

  isActive       Boolean           @default(true)
  hidden         Boolean           @default(false) // moderatsiya
  views          Int               @default(0)
  rating         Float             @default(0)
  ratingCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  orderItems     BnOrderItem[]
  reviews        BnProductReview[]
  variants       BnProductVariant[]

  @@index([shopId, createdAt])
  @@index([categoryId, isActive, hidden])
  @@index([isActive, hidden, createdAt])
  @@index([price])
}

// ── Savat va sevimlilar ──────────────────────────────────────────────────────
model BnCartItem {
  id        String   @id @default(cuid())
  profileId String
  productId String
  variantId String?                                          // agar variant tanlangan bo'lsa
  variant   BnProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([profileId, productId, variantId])
  @@index([profileId])
}

model BnFavorite {
  id        String   @id @default(cuid())
  profileId String
  productId String
  privacy   BnFavPrivacy @default(PRIVATE)   // Do'stlar wishlist funksiyasi
  createdAt DateTime @default(now())

  @@unique([profileId, productId])
  @@index([profileId, createdAt])
  @@index([profileId, privacy])
}

enum BnFavPrivacy {
  PRIVATE     // faqat men (default)
  FOLLOWERS   // Nexus obunachilarim ko'radi
  PUBLIC      // hammaga ochiq
}

// Xaridor manzillar kitobchasi — uy, ish, va h.k. Checkout'da tanlash uchun.
model BnAddress {
  id         String   @id @default(cuid())
  profileId  String
  label      String   @default("Manzil")    // "Uy", "Ish", ...
  address    String                          // ochiq matn
  phone      String
  city       String   @default("Toshkent")
  district   String?                         // tuman
  landmark   String?                         // "Muzey oldi"
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId, isDefault])
}

// Narx tushdi kuzatish — foydalanuvchi mahsulotni "kuzatishga" qo'yadi.
// Kunlik cron narx N% pastga tushsa Nexus notification yuboradi.
model BnPriceWatch {
  id           String   @id @default(cuid())
  profileId    String
  productId    String
  targetPct    Int      @default(10)         // masalan: 10% (narx 10% tushsa xabar)
  basePrice    Int                           // qo'shilgan paytdagi narx (foiz shu bilan taqqoslanadi)
  lastNotified DateTime?
  createdAt    DateTime @default(now())

  @@unique([profileId, productId])
  @@index([productId])
}

// ── Buyurtma ─────────────────────────────────────────────────────────────────
model BnOrder {
  id            String        @id @default(cuid())
  code          String        @unique              // "BN-2026-000123"
  buyerId       String
  shopId        String
  shop          BnShop        @relation(fields: [shopId], references: [id])
  items         BnOrderItem[]
  messages      BnOrderMessage[]

  subtotal      Int
  deliveryFee   Int           @default(0)
  commission    Int           @default(0)          // For Humo ulushi (5%)
  total         Int

  fulfillType   BnFulfillType
  address       String?
  phone         String
  note          String?

  paymentMethod BnPayMethod   @default(WALLET)
  paymentStatus BnPayStatus   @default(PENDING)
  escrowHeld    Boolean       @default(false)      // pul ushlanganmi
  settledAt     DateTime?                          // sotuvchiga to'langan

  status        BnOrderStatus @default(PLACED)
  cancelReason  String?

  placedAt      DateTime      @default(now())
  confirmedAt   DateTime?
  readyAt       DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  @@index([shopId, placedAt])
  @@index([buyerId, placedAt])
  @@index([status, placedAt])
}

// Xaridor↔sotuvchi buyurtma ichida yozishuv (K2).
// Bir buyurtma bo'yicha ikki tomon xabar almashadi. Push notification ham yuboriladi.
// Faqat buyer va shop.profileId (ega) ko'ra oladi/yoza oladi.
model BnOrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     BnOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String                                     // UserProfile.id — buyer YOKI shop egasi
  text      String                                     // max 2000 belgi
  imageUrl  String?                                    // ixtiyoriy rasm
  readAt    DateTime?                                  // qarshi tomon o'qigan vaqt
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([senderId, createdAt])
}

model BnOrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       BnOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     BnProduct @relation(fields: [productId], references: [id])
  variantId   String?                                 // tanlangan variant (agar bor bo'lsa)
  variantName String?                                 // denorm — variant o'chsa ham tarix
  title       String                                  // snapshot
  price       Int                                     // snapshot (variant narxi bo'lsa)
  qty         Int       @default(1)
  imageUrl    String?

  @@index([orderId])
}

enum BnFulfillType {
  PICKUP
  DELIVERY
  INSPECT
}
enum BnPayMethod {
  WALLET
  CASH
}
enum BnPayStatus {
  PENDING
  HELD
  PAID
  REFUNDED
}
enum BnOrderStatus {
  PLACED
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  DISPUTED
}

// ── "Ko'rib sotib olish" bandi (24 soat) ─────────────────────────────────────
// Xaridor bozorga borib ko'radi, yoqsa kodni aytadi. BN ning asosiy farqi.
model BnInspectHold {
  id          String    @id @default(cuid())
  code        String    @unique                    // "BN-4821"
  productId   String
  profileId   String                               // xaridor
  qty         Int       @default(1)
  expiresAt   DateTime                             // +24 soat
  usedAt      DateTime?                            // sotuvchi tasdiqladi
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([productId, expiresAt])
  @@index([profileId, createdAt])
}

// ── Sharhlar ─────────────────────────────────────────────────────────────────
model BnProductReview {
  id        String    @id @default(cuid())
  productId String
  product   BnProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId String
  orderId   String?                                // xarid tasdig'i
  rating    Int                                    // 1-5
  text      String?
  images    String[]  @default([])
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([productId, profileId])
  @@index([productId, hidden])
}

model BnShopReview {
  id        String   @id @default(cuid())
  shopId    String
  shop      BnShop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  profileId String
  orderId   String?
  rating    Int
  text      String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([shopId, profileId])
  @@index([shopId, hidden])
}

// ── Boshqaruv rollari ────────────────────────────────────────────────────────
// Jalol = OWNER (BN ichida hamma narsa). Founder doim o'tadi (yozuv shart emas).
model BnAdmin {
  id        String      @id @default(cuid())
  profileId String      @unique
  role      BnAdminRole
  addedById String?
  note      String?                                // "BN loyiha rahbari"
  createdAt DateTime    @default(now())
}

enum BnAdminRole {
  OWNER
  MODERATOR
}

// ── Mahsulot variantlari (rang/o'lcham/xotira) ───────────────────────────────
// Kiyim/poyabzal/telefon uchun majburiy — har variantda alohida narx va stok.
// Mahsulotda variant bo'lsa: `BnProduct.price`=eng arzoni, `stock`=yig'indi.
model BnProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   BnProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String                                        // "Qora / XL", "256 GB / Kumush"
  price     Int                                            // so'm (butun)
  oldPrice  Int?
  stock     Int      @default(0)
  image     String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  cartItems BnCartItem[]

  @@index([productId, sort])
}

// ── BN bildirishnomalar ──────────────────────────────────────────────────────
// Order status o'zgargani, sharh, boyot, narx tushdi... — xaridor/sotuvchiga.
model BnNotification {
  id        String        @id @default(cuid())
  profileId String                                         // qabul qiluvchi UserProfile.id
  type      BnNotifType
  title     String
  body      String?
  link      String?                                        // bosilganda o'tadigan manzil (masalan /buyurtmalarim/xxx)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([profileId, read])
  @@index([profileId, createdAt])
}

enum BnNotifType {
  ORDER_PLACED         // Sotuvchiga: yangi buyurtma keldi
  ORDER_CONFIRMED      // Xaridorga: sotuvchi tasdiqladi
  ORDER_READY          // Xaridorga: mahsulot tayyor
  ORDER_COMPLETED      // Xaridorga: buyurtma yakunlandi
  ORDER_CANCELLED      // Xaridorga: sotuvchi bekor qildi (yoki aksincha)
  ORDER_MESSAGE        // Xaridor/sotuvchi buyurtma ichida xabar yubordi
  REVIEW_RECEIVED      // Sotuvchiga: yangi sharh
  PRICE_DROP           // Xaridorga: kuzatilgan mahsulot narxi tushdi
  BAN_APPLIED          // Sotuvchiga: sizga ban qo'yildi
  BAN_LIFTED           // Sotuvchiga: ban olib tashlandi
  RETURN_REQUESTED     // Sotuvchiga: qaytarish so'ralgan
  RETURN_DECIDED       // Xaridorga: qaytarish qabul/rad
  SHOP_APPROVED        // Sotuvchiga: do'kon tasdiqlandi
  SHOP_REJECTED        // Sotuvchiga: do'kon rad etildi
}

// ── Qaytarish (return) tizimi ────────────────────────────────────────────────
// Xaridor mahsulotni qaytarishi mumkin — sabab bilan.
// Sotuvchi qabul qilsa: stok tiklanadi, xaridor puli qaytariladi (WALLET).
model BnReturn {
  id           String            @id @default(cuid())
  orderId      String                                       // BnOrder.id
  buyerId      String                                       // xaridor
  reason       String                                       // qisqa sabab
  detail       String?                                      // batafsil (ixtiyoriy)
  images       String[]          @default([])               // dalil rasm URL'lari (maks 5)
  status       BnReturnStatus    @default(REQUESTED)
  decidedById  String?                                      // sotuvchi profileId
  decidedAt    DateTime?
  decisionNote String?                                      // sotuvchi izohi
  refunded     Boolean           @default(false)            // hamyonga qaytarilganmi
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orderId])
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

enum BnReturnStatus {
  REQUESTED     // Xaridor so'radi
  APPROVED      // Sotuvchi qabul qildi (mahsulot qaytariladi, pul tiklanadi)
  REJECTED      // Sotuvchi rad etdi (sabab bilan)
  CANCELLED     // Xaridor o'zi bekor qildi
}

// ── Boykot brendlar ──────────────────────────────────────────────────────────
// OWNER (@abduvoris/@x) yozadi. Bu brendlar mahsuloti BN'da sotilmaydi.
// Sabab: har xil (siyosiy, axloqiy, sifat, boykot chaqiruvi).
// Mahsulot yaratilayotganda title/description tekshiriladi, mos kelsa BLOCK.
// Foydalanuvchi /bn/boykot sahifada ro'yxatni + sabablarini ko'radi.
model BnBoycottBrand {
  id         String   @id @default(cuid())
  name       String   @unique                       // Asosiy nom (masalan "Coca-Cola")
  aliases    String[] @default([])                  // Boshqa nomlar/sinonimlar ("coke", "coca cola")
  reason     String                                 // Nima uchun (foydalanuvchiga ko'rinadigan)
  detail     String?                                // Batafsil (ixtiyoriy)
  categories String[] @default([])                  // Yo'nalish teglari ("ichimlik", "siyosiy")
  addedById  String                                 // OWNER profileId
  addedAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([addedAt])
}

// ── Referral (marketing viralligi) ───────────────────────────────────────────
// Foydalanuvchi o'z linkini ulashadi (bozornarxida.uz/r/<code>) — code = username
// yoki humoId. Yangi tashrifchi shu linkdan kirsa attribution capture'da ?ref=code
// saqlanadi. Signup paytida BnReferral yaratiladi (PENDING). Chaqirilgan
// foydalanuvchi birinchi COMPLETED buyurtma qilsa — REWARDED bo'ladi va ikkisiga
// ham For Pay hamyoniga bonus tushadi (yuboruvchiga ko'proq).
model BnReferral {
  id             String              @id @default(cuid())
  inviterId      String                                          // Chaqiruvchi UserProfile.id
  inviteeId      String              @unique                     // Chaqirilgan UserProfile.id (bir odam bir marta)
  code           String                                          // Ishlatilgan code (audit uchun)
  status         BnReferralStatus    @default(PENDING)
  rewardOrderId  String?                                         // Qaysi buyurtma tetikladi
  inviterReward  Int                 @default(0)                 // Chaqiruvchi olgan bonus (so'm)
  inviteeReward  Int                 @default(0)                 // Chaqirilgan olgan bonus (so'm)
  rewardedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([inviterId, status])
  @@index([status, createdAt])
}

enum BnReferralStatus {
  PENDING     // Chaqirilgan hisob ochildi, lekin buyurtma yo'q
  REWARDED    // Chaqirilgan birinchi COMPLETED buyurtmani berdi — bonus to'landi
  CANCELLED   // Bekor (admin qo'lda yoki fraud)
}

// ── Sotuvchi WAITLIST (MChJ'siz oldindan yozdirish) ─────────────────────────
// MChJ ochilmasdan sotuvchilarni oldindan yig'ish uchun ochiq forma (login shart emas).
// Jalol (BN OWNER) shu ro'yxatni qo'ng'iroq qilib bozorlardan sotuvchi jamlaydi.
// Rasmiy /sotuvchi flow (ariza + INN) MChJ ochilishidan keyin faollashadi.
model BnSellerWaitlist {
  id            String                   @id @default(cuid())
  name          String                                                            // F.I.SH. yoki do'kon nomi
  phone         String                                                            // +998 formatida
  city          String                   @default("Toshkent")
  marketSlug    String?                                                           // Aynan qaysi bozor
  category      String?                                                           // Sotmoqchi bo'lgan kategoriya
  note          String?                                                           // Qo'shimcha (tavsif, savol)
  source        String?                                                           // Qayerdan (utm_source yoki referrer)
  ref           String?                                                           // Referral kodi (agar bor bo'lsa)
  status        BnSellerWaitlistStatus   @default(PENDING)
  contactedById String?                                                           // Kim aloqaga chiqdi
  contactedAt   DateTime?
  contactNote   String?                                                           // Suhbat izohi
  convertedShopId String?                                                         // Agar do'kon ochilsa
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

enum BnSellerWaitlistStatus {
  PENDING       // Yangi ariza
  CONTACTED     // Jalol qo'ng'iroq qildi
  CONVERTED     // Do'kon ochildi (MChJ tayyor + arizani berdi)
  REJECTED      // Rad (spam, ovoz yoq, boshqa sabab)
}

// ── BN admin Web Push broadcast audit ───────────────────────────────────────
// Har OWNER yuborgan mass push xabari yozib qo'yiladi — kim, qachon, qanchaga,
// nima matn bilan. Rate limit ham shu jadval count'idan hisoblanadi
// (module-scope memory'ga bog'liq emas — serverless cold start bardosh).
model BnBroadcast {
  id         String   @id @default(cuid())
  ownerId    String                              // UserProfile.id — kim yubordi
  title      String
  body       String
  url        String?
  tag        String?
  segment    String                              // "all" | "sellers" | "buyers"
  recipients Int      @default(0)                // qancha profil'ga yuborildi
  clickCount Int      @default(0)                // notification click sanog'i (CTR uchun)
  tookMs     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([ownerId, createdAt])
}

// ── Nexus Pleylist (foydalanuvchi tomonidan tuzilgan trek to'plami) ────────
model NexusPlaylist {
  id          String                @id @default(cuid())
  ownerId     String                                              // UserProfile.id
  name        String                                              // max 100
  description String?                                             // max 500
  coverUrl    String?                                             // ixtiyoriy (aks holda birinchi trek cover'i)
  isPublic    Boolean               @default(true)
  playsCount  Int                   @default(0)                   // butun pleylist ijro etilgan soni
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tracks      NexusPlaylistTrack[]

  @@index([ownerId, updatedAt])
  @@index([isPublic, updatedAt])
}

model NexusPlaylistTrack {
  id          String   @id @default(cuid())
  playlistId  String
  trackId     String
  position    Int                                                 // 0-based tartib
  addedAt     DateTime @default(now())

  playlist    NexusPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

// ── Nexus Referral (foydalanuvchi taklif qilish bonusi) ────────────────────
// Kod = username yoki humoId. Chaqirilgan foydalanuvchi Nexus'da birinchi
// aktiv harakat qilsa (post/comment/like/DM), inviter va invitee'ga bonus
// Wallet'ga o'tkaziladi: inviter 10 000 so'm, invitee 5 000 so'm.
model NexusReferral {
  id          String              @id @default(cuid())
  inviterId   String                                                // UserProfile.id
  inviteeId   String              @unique                          // bir foydalanuvchi bir marta chaqiriladi
  status      NexusReferralStatus @default(PENDING)
  rewardedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([inviterId, status])
  @@index([status, createdAt])
}

enum NexusReferralStatus {
  PENDING
  REWARDED
  CANCELLED
}

// ── Nexus Reklama slot (feed native reklama — 3 slot) ──────────────────────
// Nexus feed'ga har 15 postdan keyin native reklama ("Homiyning posti")
// aylanma tarzda tushadi. Foydalanuvchi Nexus feed'da avtomatik ko'radi.
// Narx BN AD bilan bir xil model (10$ sof foyda/kun, CBU kursi + soliq).
model NexusAdSlot {
  id                String    @id @default(cuid())
  slot              Int                                   // 1-3
  imageUrl          String
  title             String                                // max 100 belgi
  body              String?                               // ixtiyoriy tavsif (280 belgi)
  ctaUrl            String
  ctaText           String    @default("Batafsil")

  ownerId           String                                // UserProfile.id — kim to'ladi
  ownerUsername     String?                               // avatar/nom uchun snapshot
  ownerAvatar       String?

  startsAt          DateTime  @default(now())
  expiresAt         DateTime
  active            Boolean   @default(true)

  // Moliyaviy snapshot
  daysCount         Int
  netUsdPerDay      Int       @default(10)
  usdUzsRateSnap    Int
  itParkAtPurchase  Boolean
  paidAmountUzs     Int

  // Statistika
  impressions       Int       @default(0)
  clicks            Int       @default(0)

  // Moderatsiya
  hidden            Boolean   @default(false)
  moderationNote    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([slot, active, expiresAt])
  @@index([ownerId, createdAt])
  @@index([active, expiresAt])
}

// ── BN Reklama banner (bosh sahifa slider — 5 slot) ─────────────────────────
// Sotuvchi (yoki har qanday foydalanuvchi) 1-5 slot'ga 1-30 kunga reklama
// qo'yish uchun to'laydi. Narx: sof foyda 10$ / kun. Real UZS/USD kurs
// (CBU API) va soliq stavkasi (IT Park bor/yo'q) asosida hisoblanadi.
// Har banner AI moderation'dan o'tadi (kontent siyosat).
//
// Slot mantiq: 1-5. Bir slot uchun bir vaqtda faqat bitta faol banner.
// Yangi sotib olishda bo'sh slot avto-tanlanadi. Barcha slot band bo'lsa 409.
model BnAdBanner {
  id                String    @id @default(cuid())
  slot              Int                                   // 1-5
  imageUrl          String
  title             String                                // max 80 belgi
  ctaUrl            String                                // "Batafsil" havolasi
  ownerId           String                                // UserProfile.id — kim to'ladi
  shopSlug          String?                               // agar sotuvchi bo'lsa

  startsAt          DateTime  @default(now())
  expiresAt         DateTime
  active            Boolean   @default(true)

  // Moliyaviy snapshot (sotib olish paytida yozib olinadi — keyingi kurs o'zgarishi ta'sir qilmaydi)
  daysCount         Int                                   // 1-30
  netUsdPerDay      Int       @default(10)                // qo'lga tushadigan $/kun
  usdUzsRateSnap    Int                                   // masalan 11830 (butun so'm)
  itParkAtPurchase  Boolean                               // sotib olish paytidagi rejim
  paidAmountUzs     Int                                   // fakt to'langan so'm

  // Statistika
  impressions       Int       @default(0)                 // ko'rilgan
  clicks            Int       @default(0)                 // "Batafsil" bosilgan

  // Moderatsiya
  hidden            Boolean   @default(false)             // moderator yashirgan
  moderationNote    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([slot, active, expiresAt])
  @@index([ownerId, createdAt])
  @@index([active, expiresAt])
}

// ── BN Featured mahsulot (boost) ────────────────────────────────────────────
// Sotuvchi mahsulotini 24 soatga top-search'da yuqoriga chiqarish uchun pul
// to'laydi (Wallet'dan). BnFeaturedListing aktiv bo'lsa qidiruvda birinchi
// bosqichda ko'rinadi. Bir vaqtda bir mahsulot uchun bitta faol boost.
//
// Narxlar: 24 soat = 20 000 so'm, 3 kun = 50 000, 7 kun = 100 000.
model BnFeaturedListing {
  id          String   @id @default(cuid())
  productId   String   @unique                     // mahsulot bir vaqtda faqat bitta faol boost
  shopId      String                                // qaysi do'kon to'ladi (audit)
  paidAmount  Int                                   // so'm
  startsAt    DateTime @default(now())
  expiresAt   DateTime                              // shu vaqtgacha aktiv
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active, expiresAt])
  @@index([shopId])
}

// ── BN Premium obuna (Bronze/Silver/Gold/Platinum) ──────────────────────────
// Do'kon egasi oyiga to'laydi — badge, xususiyatlar, oxirgi tier'lar ko'proq boost imkoniyati.
// Narxlar: Bronze 50K, Silver 150K, Gold 400K, Platinum 1M so'm/oy.
// `BnShop.premiumUntil > now` bo'lsa do'kon "premium" holatida.
model BnPremiumSubscription {
  id          String        @id @default(cuid())
  shopId      String
  tier        BnPremiumTier
  amount      Int                                    // so'mda to'langan
  startsAt    DateTime      @default(now())
  endsAt      DateTime                               // odatda +30 kun
  autoRenew   Boolean       @default(false)          // kelajakda Payme auto-renewal
  createdAt   DateTime      @default(now())

  @@index([shopId, endsAt])
  @@index([endsAt])
}

enum BnPremiumTier {
  BRONZE      // 50 000 so'm/oy
  SILVER      // 150 000 so'm/oy
  GOLD        // 400 000 so'm/oy
  PLATINUM    // 1 000 000 so'm/oy
}

// ── BN Narx tarixi ───────────────────────────────────────────────────────────
// Har kuni cron mahsulot narxlarini snapshot qiladi. Mahsulot detali sahifada
// 30/90/365 kunlik grafik ko'rsatiladi. `marketAvgPrice` bilan solishtirish
// uchun ham bu tarix ishlatiladi (foydalanuvchi trendni ko'radi).
//
// Cron: `/api/cron/bn-price-snapshot` (kunlik). Faqat aktiv mahsulotlar.
model BnPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  price       Int                                 // so'm (butun)
  marketAvg   Int?                                // shu kungi marketAvgPrice snapshot
  capturedAt  DateTime @default(now())

  @@index([productId, capturedAt])
  @@index([capturedAt])
}

// ── Zaxira usernamelar ───────────────────────────────────────────────────────
// Foydalanuvchi olmaydigan @nomlar (tizim, brend, mashhur odam, davlat,
// PERSONAL — yaqin odamlarga ajratilgan). VIP toifa keyin 10K+ faol
// foydalanuvchi bo'lganda sotiladi (hozircha bepul band ko'rsatiladi).
// ── Humo Media Packs (GIF & Sticker) ────────────────────────────────────────
// Telegram uslubidagi foydalanuvchi tomonidan yaratiladigan GIF va Sticker
// to'plamlar. Har foydalanuvchi o'z pack'ini yaratadi, boshqalar "qo'shadi"
// va istalgan chat'da (hozircha Nexus DM) ishlatadi.
//
// Video → MP4 sifatida saqlanadi (real GIF konvertatsiya emas — MP4 loop
// aynan GIF ko'rinishi, 100x kichik + sifat yaxshi. Telegram/Twitter uslubi).
// Sticker → PNG/WebP transparent 512x512.
//
// AI moderatsiya har item upload'da (mavjud moderateContent) — 18+ bloklanadi.

model HumoMediaPack {
  id           String          @id @default(cuid())
  ownerId      String                                    // yaratuvchi UserProfile.id
  kind         HumoMediaKind
  name         String                                    // "Mushuklar", "Reactions"
  slug         String          @unique                   // "mushuklar-abc123"
  coverUrl     String?                                   // birinchi item avto-cover
  isPublic     Boolean         @default(true)            // qidiruv/subscription uchun ochiqmi
  addedCount   Int             @default(0)               // qancha kishi subscribe qilgan
  usesCount    Int             @default(0)               // qancha marta yuborilgan
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items         HumoMediaItem[]
  subscriptions HumoMediaSubscription[]

  @@index([ownerId, kind])
  @@index([kind, addedCount])
  @@index([kind, createdAt])
}

model HumoMediaItem {
  id         String        @id @default(cuid())
  packId     String
  pack       HumoMediaPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  mediaUrl   String                                       // Vercel Blob URL (.mp4 for GIF, .png for Sticker)
  thumbUrl   String?                                      // GIF static frame (birinchi kadr)
  width      Int
  height     Int
  bytes      Int
  keywords   String[]      @default([])                   // qidiruv — GIF free-text, Sticker emojis
  hidden     Boolean       @default(false)                // AI moderatsiya BLOCK bo'lsa
  order      Int           @default(0)                    // qo'lda tartib
  createdAt  DateTime      @default(now())

  @@index([packId, order])
  @@index([packId, hidden])
}

// Foydalanuvchi qaysi pack'larni "o'z kutubxonasiga" qo'shgan (Telegram-uslub)
model HumoMediaSubscription {
  id         String        @id @default(cuid())
  profileId  String
  packId     String
  pack       HumoMediaPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  addedAt    DateTime      @default(now())
  order      Int           @default(0)                    // qo'lda tartib

  @@unique([profileId, packId])
  @@index([profileId, order])
}

enum HumoMediaKind {
  GIF
  STICKER
}

model ReservedUsername {
  id           String   @id @default(cuid())
  username     String   @unique                       // lowercase canonical
  category     ReservedCategory
  priceUzs     Int?                                    // VIP: kelajakda sotiladigan narx
  note         String?                                 // "Onamga", "Cristiano Ronaldo", "Apple Inc."
  assignedToId String?                                 // PERSONAL: aynan qaysi profil ololadi
  reservedById String?                                 // Qo'shgan founder (audit)
  createdAt    DateTime @default(now())
  claimedAt    DateTime?                               // Kimgadir topshirilganda (arxiv)
  @@index([category])
}

enum ReservedCategory {
  SYSTEM      // admin, api, humo — hech kimga
  VIP         // 777, ali, vip — kelajakda pullik
  CELEBRITY   // cristiano, ronaldo — mashhur odam kelsa beriladi
  BRAND       // apple, samsung — rasmiy vakilga beriladi
  COUNTRY     // uzbekistan, russia — davlat rasmiy vakili
  GOVERNMENT  // president, mvd — davlat organi
  PERSONAL    // do'st/qarindosh — assignedToId bo'yicha
}

// ═══════════════════════════════════════════════════════════════════════════
// BELIS — For Humo tarkibidagi sarpo qutilari IJARA loyihasi.
// Loyiha rahbari @sevinch. Single-vendor (Belis o'zi ijaraga beradi).
// Marshrut: /{locale}/belis/*. Telegram: @Belis_Sarpo, Instagram: @belis.sarpo
// Manzil: Toshkent (41.196833, 69.155139). Yetkazish: mijoz o'zi olib ketadi yoki Yandex chaqiradi (mijoz to'laydi).
// Eski SOTUV modeli (BelisProduct/BelisOrder/BelisCategory/BelisCollection/BelisCartItem/BelisFavorite/BelisReview + enumlar) 2026-09-03 da o'chirildi (DB 0 row, ijara modeliga o'tildi).
// ═══════════════════════════════════════════════════════════════════════════

// Belis buyurtma ichida yozishuv (mijoz ↔ @sevinch).
// BN OrderMessage pattern — polling asosida (5s), push notification qo'shimcha.
model BelisBookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   BelisRentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String                                     // UserProfile.id (mijoz yoki admin)
  text      String                                     // max 2000
  imageUrl  String?                                    // Vercel Blob
  readAt    DateTime?                                  // qarshi tomon o'qigan
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([senderId, createdAt])
}

model BelisTelegramUser {
  tgId         String   @id
  chatId       String
  firstName    String?
  lastName     String?
  username     String?
  phone        String?
  languageCode String?  @default("uz")
  profileId    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  @@index([profileId])
}


// ═══════════════════════════════════════════════════════════════════════════
// BELIS v2 — IJARA MODELI (sarpo qutilari Fotiha/Beshik to'y uchun)
//
// Real biznes: qutilar SOTILMAYDI, ijaraga beriladi. Mijoz pasport nusxa
// qoldiradi + zaklat + ijara puli. Marosim kunidan 1 kun oldin oladi, 3 kun
// ichida qaytaradi. Buzilsa/kam qaytsa shtraf.
//
// Yuqoridagi eski BelisProduct/BelisOrder etc — SOTUV modeli, launch'gacha
// keyingi sessiyada o'chiriladi (DB toza, real ma'lumot yo'q).
// ═══════════════════════════════════════════════════════════════════════════

// To'plam (Fotiha 14 quti / Beshik To'y 10 quti / kelajakda boshqalar).
// `copyCount` — do'konda nechta nusxa borligi (masalan 3 ta Fotiha komplekt).
// Availability calendar shu maydondan foydalanadi.
model BelisKomplekt {
  id            String   @id @default(cuid())
  slug          String   @unique
  kind          BelisKomplektKind
  nameUz        String
  nameRu        String?
  nameEn        String?
  descriptionUz String?  @db.Text
  descriptionRu String?  @db.Text
  descriptionEn String?  @db.Text
  images        String[] @default([])
  dailyRentUzs  Int                              // 1 kunlik ijara narxi (butun komplekt)
  deposit       Int                              // zaklat summasi (butun mahsulot narxi)
  itemsCount    Int                              // 14 / 10 (tarkibidagi qutilar soni)
  copyCount     Int      @default(1)             // do'kondagi nusxa (bir vaqtda ijaraga berila oladigan)
  isActive      Boolean  @default(true)
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         BelisItem[]
  bookings      BelisRentalBooking[]

  @@index([kind, isActive])
}

enum BelisKomplektKind {
  FOTIHA
  BESHIK_TOY
  CUSTOM
}

// Alohida quti (komplekt ichidagi bo'lak, ham alohida ijaraga berila oladi).
// Bir quti bir necha komplektga tegishli bo'lishi mumkin emas (1:N).
model BelisItem {
  id            String   @id @default(cuid())
  slug          String   @unique
  komplektId    String?
  komplekt      BelisKomplekt?  @relation(fields: [komplektId], references: [id], onDelete: SetNull)
  kind          BelisItemKind
  nameUz        String
  nameRu        String?
  nameEn        String?
  images        String[]                @default([])
  dailyRentUzs  Int                              // alohida ijara narxi (kunlik)
  deposit       Int                              // shu qutining zaklati
  copyCount     Int      @default(1)             // do'kondagi nusxa (alohida sotib olingan qo'shimchalar)
  isActive      Boolean  @default(true)
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      BelisItemBooking[]

  @@index([komplektId, isActive])
}

enum BelisItemKind {
  PATIR_KATTA
  PATIR_KICHIK
  TOGORA
  QURUQ_MEVA
  HOL_MEVA
  HOLVA
  TORT
  MANIKEN
  PARFYUM
  KATTA_IDISH
  SANDIQ
  SOCHQI
  DOMIK
  BOSHQA
}

// Ijara buyurtmasi (booking). Mijoz to'liq komplekt YOKI alohida qutilar
// oladi. Sanalar: marosim kuni + pickup (marosim - 1) + qaytish (marosim + 3).
model BelisRentalBooking {
  id                String   @id @default(cuid())
  code              String   @unique                     // "BEL-2026-00001"

  // Xaridor
  buyerId           String                               // UserProfile.id
  buyerName         String                               // snapshot (o'zgarishsa saqlanadi)
  buyerPhone        String
  passportUrl       String?                              // Vercel Blob rasm URL
  passportSeries    String?                              // "AB1234567"
  contractUrl       String?                              // imzolangan PDF (kelajakda)

  // Sana rejasi
  eventDate         DateTime                             // marosim kuni (mijoz tanlaydi)
  pickupDate        DateTime                             // odatda eventDate - 1
  returnDate        DateTime                             // odatda eventDate + 3 (max)
  actualReturnedAt  DateTime?                            // qaytgan real vaqt

  // Tarkib — komplekt YOKI alohida qutilar (biri majburiy)
  komplektId        String?
  komplekt          BelisKomplekt?  @relation(fields: [komplektId], references: [id], onDelete: SetNull)
  itemBookings      BelisItemBooking[]
  messages          BelisBookingMessage[]

  // Moliya (butun so'mda, UZS)
  rentDailyUzs      Int                                  // kelishilgan kunlik ijara
  daysCount         Int                                  // taxminan 4-5
  rentTotalUzs      Int                                  // rentDaily * daysCount
  depositUzs        Int                                  // zaklat summasi
  paidRent          Int      @default(0)                 // to'langan ijara
  paidDeposit       Int      @default(0)                 // to'langan zaklat

  // Holat
  status            BelisBookingStatus @default(REQUESTED)
  fulfillType       BelisRentalFulfill @default(PICKUP)
  address           String?                              // agar YANDEX_CUSTOMER
  note              String?  @db.Text

  // Qaytish holati
  damageReport      String?  @db.Text                    // qaytishida holat (rasm/matn)
  damageImages      String[] @default([])
  fineUzs           Int      @default(0)                 // shtraf (kechikish + zarar)
  refundedUzs       Int      @default(0)                 // zaklatdan qaytarilgan

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  confirmedById     String?                              // admin (@sevinch)
  returnedById      String?                              // qaytishni belgilagan admin

  // ── For Pay integratsiyasi ────────────────────────────────────────────
  // Ariza yaratganda mijoz to'lov usulini tanlaydi.
  //   CASH — do'konda naqd (default, backward compat)
  //   WALLET — For Pay hamyondan (ijara + zaklat bloklanadi eskro)
  paymentMethod     String   @default("CASH")            // "CASH" | "WALLET"
  walletCurrency    String?                              // hamyon valyutasi (UZS/USD)
  holdTxRef         String?  @unique                     // WalletTransaction ref: "belis:hold:<code>"
  settleTxRef       String?  @unique                     // "belis:settle:<code>" — ijara @sevinch ga
  refundTxRef       String?  @unique                     // "belis:refund:<code>" — zaklat mijozga
  fineTxRef         String?  @unique                     // "belis:fine:<code>" — jarima @sevinch ga

  @@index([buyerId, createdAt])
  @@index([eventDate])
  @@index([status, createdAt])
  @@index([pickupDate])
  @@index([returnDate])
}

enum BelisBookingStatus {
  REQUESTED       // Mijoz ariza berdi (admin qo'lda tekshiradi)
  CONFIRMED       // Admin tasdiqladi (pickup kutilyapti)
  PICKED_UP       // Mijoz olib ketdi
  RETURNED_OK     // Butun qaytardi, zaklat qaytariladi
  RETURNED_DAMAGE // Buzilgan/kam — shtraf qo'llaniladi
  LATE            // Qaytish sanasi o'tgan (avto belgilanadi cron/live check)
  CANCELLED       // Bekor qilindi
}

enum BelisRentalFulfill {
  PICKUP              // Mijoz do'konga o'zi keladi
  YANDEX_CUSTOMER     // Mijoz Yandex chaqiradi, kuryerga o'zi to'laydi
  YANDEX_BELIS        // Belis Yandex chaqiradi (kuryer to'lovi buyurtma summasiga qo'shiladi)
}

// Alohida quti booking bandi (agar mijoz komplekt olmagan bo'lsa yoki
// komplektdan tashqari qo'shimcha quti kerak bo'lsa).
model BelisItemBooking {
  id         String  @id @default(cuid())
  bookingId  String
  booking    BelisRentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId     String
  item       BelisItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  qty        Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([itemId, bookingId])
  @@index([bookingId])
}

